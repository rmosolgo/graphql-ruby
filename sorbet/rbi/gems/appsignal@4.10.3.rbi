#
# pkg:gem/appsignal#lib/appsignal/garbage_collection.rb:5
module Appsignal::GarbageCollection
  class << self
    # Unset the currently cached profilers.
    #
    # @return [void]
    #
    # pkg:gem/appsignal#lib/appsignal/garbage_collection.rb:33
