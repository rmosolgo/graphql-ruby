# Base instrumentation middleware.
#
# Do not use this middleware directly. Instead use
# {InstrumentationMiddleware}.
#
# @abstract
# @api private
#
# pkg:gem/appsignal#lib/appsignal/rack/abstract_middleware.rb:14
class Appsignal::Rack::AbstractMiddleware
  # pkg:gem/appsignal#lib/appsignal/rack/abstract_middleware.rb:17
  def initialize(app, options = T.unsafe(nil)); end

  # pkg:gem/appsignal#lib/appsignal/rack/abstract_middleware.rb:26
  def call(env); end

  private

  # Add metadata to the transaction based on the request environment.
  # Override this method to set metadata after the app is called.
  # Call `super` to also include the default set metadata.
  #
  # pkg:gem/appsignal#lib/appsignal/rack/abstract_middleware.rb:137
  def add_transaction_metadata_after(transaction, request); end

  # Add metadata to the transaction based on the request environment.
  # Override this method to set metadata before the app is called.
  # Call `super` to also include the default set metadata.
  #
  # pkg:gem/appsignal#lib/appsignal/rack/abstract_middleware.rb:131
  def add_transaction_metadata_before(transaction, request); end

  # pkg:gem/appsignal#lib/appsignal/rack/abstract_middleware.rb:90
  def call_app(env, transaction); end

  # Another instrumentation middleware is active earlier in the stack, so
  # don't report any exceptions here, the top instrumentation middleware
  # will be the one reporting the exception.
  #
  # Either another {AbstractMiddleware} or {EventHandler} is higher in the
  # stack and will report the exception and complete the transaction.
  #
  # @see #instrument_app_call_with_exception_handling
  #
  # pkg:gem/appsignal#lib/appsignal/rack/abstract_middleware.rb:80
  def instrument_app_call(env, transaction); end

  # Instrument the request fully. This is used by the top instrumentation
  # middleware in the middleware stack. Unlike
  # {#instrument_app_call} this will report any exceptions being
  # raised.
  #
  # @see #instrument_app_call
  #
  # pkg:gem/appsignal#lib/appsignal/rack/abstract_middleware.rb:109
  def instrument_app_call_with_exception_handling(env, transaction, wrapped_instrumentation); end

  # pkg:gem/appsignal#lib/appsignal/rack/abstract_middleware.rb:143
  def request_for(env); end
end

