# pkg:gem/appsignal#lib/appsignal/logger.rb:56
Appsignal::Logger::AUTODETECT = T.let(T.unsafe(nil), Integer)

# A wrapper for a block that ensures it is only called once.
# If called again, it will return the result of the first call.
# This is useful for ensuring that a block is not executed multiple
# times when it is broadcasted to multiple loggers.
#
# @!visibility private
#
# pkg:gem/appsignal#lib/appsignal/logger.rb:18
class Appsignal::Logger::BlockOnce
  # pkg:gem/appsignal#lib/appsignal/logger.rb:19
  def initialize(&block); end

  # pkg:gem/appsignal#lib/appsignal/logger.rb:27
  def call(*args, **kwargs); end

  # pkg:gem/appsignal#lib/appsignal/logger.rb:44
  def to_proc; end
end

