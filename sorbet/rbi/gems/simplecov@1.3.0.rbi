  # pkg:gem/simplecov#lib/simplecov/result/filter_config.rb:10
  def cover_filters; end

  # pkg:gem/simplecov#lib/simplecov/result/filter_config.rb:10
  def filters; end

  # pkg:gem/simplecov#lib/simplecov/result/filter_config.rb:10
  def groups; end
end

# When a resultset references source files that don't exist on the local
# filesystem they're silently dropped, which produces an empty
# `0 / 0 (100.00%)` report that looks like success but isn't. This emits a
# single warning summarizing the drop and, when every entry was lost, points
# at the typical cause: `SimpleCov.collate` invoked from a machine or path
# different from where the resultsets were generated (#980).
#
# pkg:gem/simplecov#lib/simplecov/result/missing_source_files_reporter.rb:11
class SimpleCov::Result::MissingSourceFilesReporter
  # pkg:gem/simplecov#lib/simplecov/result/missing_source_files_reporter.rb:12
  def initialize(missing_paths, every_entry_dropped:); end

  # pkg:gem/simplecov#lib/simplecov/result/missing_source_files_reporter.rb:21
  def message; end

  # pkg:gem/simplecov#lib/simplecov/result/missing_source_files_reporter.rb:17
  def warn!; end

  private

  # pkg:gem/simplecov#lib/simplecov/result/missing_source_files_reporter.rb:27
  def all_missing_warning; end

  # pkg:gem/simplecov#lib/simplecov/result/missing_source_files_reporter.rb:35
  def partial_missing_warning; end

  # pkg:gem/simplecov#lib/simplecov/result/missing_source_files_reporter.rb:41
  def summary; end
end

# pkg:gem/simplecov#lib/simplecov/result/serialization.rb:5
module SimpleCov::Result::Serialization
  # pkg:gem/simplecov#lib/simplecov/result/serialization.rb:6
  def to_hash; end

  private

  # Serialized whenever a map was recorded, even an empty one: for the merge,
  # the key's presence is the signal that this result tracked tests, which is
  # what lets it tell "tracked and covered nothing" from "never tracked". The
  # map's files are restricted to this result's post-filter universe.
  #
  # pkg:gem/simplecov#lib/simplecov/result/serialization.rb:21
  def append_contexts(data); end

  # pkg:gem/simplecov#lib/simplecov/result/serialization.rb:28
  def context_filenames; end

  # A live result's criterion keys are Symbols while entries parsed back from
  # `.resultset.json` carry Strings, and the combiners read only String keys.
  # Serializing with String keys is what lets a live result merged against a
  # stored entry contribute its counts instead of being dropped.
  #
  # pkg:gem/simplecov#lib/simplecov/result/serialization.rb:36
  def coverage; end
end

# pkg:gem/simplecov#lib/simplecov/result/source_file_builder.rb:5
class SimpleCov::Result::SourceFileBuilder
  # pkg:gem/simplecov#lib/simplecov/result/source_file_builder.rb:8
  def initialize(original_result, not_loaded_files:); end

  # pkg:gem/simplecov#lib/simplecov/result/source_file_builder.rb:14
