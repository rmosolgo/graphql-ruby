# pkg:gem/simplecov#lib/simplecov/lines_classifier.rb:12
SimpleCov::LinesClassifier::WHITESPACE_LINE = T.let(T.unsafe(nil), Regexp)

# pkg:gem/simplecov#lib/simplecov/lines_classifier.rb:14
SimpleCov::LinesClassifier::WHITESPACE_OR_COMMENT_LINE = T.let(T.unsafe(nil), Regexp)

# Registry and selection for parallel-test-runner adapters. An adapter
# answers a small fixed set of questions on SimpleCov's behalf: `active?`,
# `first_worker?`, `wait_for_siblings`, and `expected_worker_count`.
#
# `Base` provides safe no-op defaults. `ParallelTestsAdapter` wraps the
# grosser/parallel_tests gem; `GenericAdapter` is env-var-only detection for
# runners that follow the `TEST_ENV_NUMBER` convention without shipping a
# Ruby API (#1065, #1156).
#
# Users register their own with `ParallelAdapters.register MyAdapter`.
# Subclass `Base` to inherit the no-op defaults: the contract methods are
# class methods, so plain inheritance is what carries them through and
# `extend Base` won't pick them up.
#
# pkg:gem/simplecov#lib/simplecov/parallel_adapters/base.rb:4
module SimpleCov::ParallelAdapters
  extend ::SimpleCov::ParallelAdapters

  # ParallelTestsAdapter first (most specific: it uses the gem's own API when
  # the gem is loaded), then GenericAdapter as the env-var fallback.
  # User-registered adapters are prepended.
  #
  # pkg:gem/simplecov#lib/simplecov/parallel_adapters.rb:27
  def adapters; end

  # The first registered adapter whose `active?` answers true, or nil when
  # none is, in which case the caller treats the process as single-worker.
  #
  # pkg:gem/simplecov#lib/simplecov/parallel_adapters.rb:42
  def current; end

  # Newly registered adapters are inserted at the front of the selection
  # list, so a custom adapter for a specific runner takes precedence over the
  # built-ins.
  #
  # pkg:gem/simplecov#lib/simplecov/parallel_adapters.rb:34
  def register(adapter); end

  # Primarily for tests that mutate env vars between examples; production
  # runs are single-shot.
  #
  # pkg:gem/simplecov#lib/simplecov/parallel_adapters.rb:50
  def reset_current!; end
end

# Default no-op implementations for a parallel-test-runner adapter.
# Everything not overridden falls back to behaving like a single-process
# run. Adapters are classes, used as singletons and never instantiated.
#
# pkg:gem/simplecov#lib/simplecov/parallel_adapters/base.rb:8
class SimpleCov::ParallelAdapters::Base
  class << self
    # pkg:gem/simplecov#lib/simplecov/parallel_adapters/base.rb:10
    def active?; end

    # pkg:gem/simplecov#lib/simplecov/parallel_adapters/base.rb:29
    def expected_worker_count; end

    # pkg:gem/simplecov#lib/simplecov/parallel_adapters/base.rb:14
    def first_worker?; end

    # mutant:disable — `false` is a singleton, so comparing against
    # it answers the same through ==, eql? and equal?, and no
    # example can tell the three apart.
    #
    # pkg:gem/simplecov#lib/simplecov/parallel_adapters/base.rb:36
    def forced_off?; end

    # Whether `wait_for_siblings` blocks until every sibling process has exited,
    # so no further resultset can appear. When true, the reporting worker can
    # accept a settled resultset count below `expected_worker_count` as final
    # instead of waiting out the whole `parallel_wait_timeout`.
    #
    # pkg:gem/simplecov#lib/simplecov/parallel_adapters/base.rb:25
    def native_wait?; end

    # Unset, empty, non-numeric, and non-positive values all mean 1: an
    # unparseable value must not yield 0 workers, which would end the sibling
    # wait before it started.
    #
    # pkg:gem/simplecov#lib/simplecov/parallel_adapters/base.rb:43
    def parallel_test_groups_count; end

    # pkg:gem/simplecov#lib/simplecov/parallel_adapters/base.rb:18
    def wait_for_siblings; end
  end
end

# Catch-all adapter for parallel test runners that follow the
# `TEST_ENV_NUMBER` / `PARALLEL_TEST_GROUPS` env-var convention but ship no
# Ruby API for SimpleCov to hook. `wait_for_siblings` is inherited from Base
# as a no-op: without a runner-provided API the only synchronization
# available is polling the resultset cache.
#
# pkg:gem/simplecov#lib/simplecov/parallel_adapters/generic.rb:12
class SimpleCov::ParallelAdapters::GenericAdapter < ::SimpleCov::ParallelAdapters::Base
  class << self
    # pkg:gem/simplecov#lib/simplecov/parallel_adapters/generic.rb:14
    def active?; end

    # pkg:gem/simplecov#lib/simplecov/parallel_adapters/generic.rb:27
    def expected_worker_count; end

    # parallel_tests sets the first worker's TEST_ENV_NUMBER to "", and runners
    # that number from 1 use "1". Both shapes match; any other value is a
    # non-first worker.
    #
    # pkg:gem/simplecov#lib/simplecov/parallel_adapters/generic.rb:23
    def first_worker?; end
  end
end

# Adapter for grosser/parallel_tests, the historical default and still the
# most precise option for projects on it. Detection requires the full native
# coordination contract: the `ParallelTests` constant loaded,
# `TEST_ENV_NUMBER` set, and `PARALLEL_PID_FILE` set, because the native
# wait API reads the pid-file path with `ENV.fetch`. A runner that only
# provides the env-var convention belongs to GenericAdapter.
#
# pkg:gem/simplecov#lib/simplecov/parallel_adapters/parallel_tests.rb:13
class SimpleCov::ParallelAdapters::ParallelTestsAdapter < ::SimpleCov::ParallelAdapters::Base
  class << self
    # pkg:gem/simplecov#lib/simplecov/parallel_adapters/parallel_tests.rb:15
    def active?; end

    # parallel_tests is an optional dependency, and `TEST_ENV_NUMBER` /
    # `PARALLEL_TEST_GROUPS` are commonly set for other reasons, so a missing
    # gem is treated as "user isn't using parallel_tests": stay quiet and let
    # GenericAdapter handle it. Warning here regressed users who use those env
    # vars for their own subprocess coordination (#1018).
    #
    # pkg:gem/simplecov#lib/simplecov/parallel_adapters/parallel_tests.rb:51
    def ensure_loaded; end

    # pkg:gem/simplecov#lib/simplecov/parallel_adapters/parallel_tests.rb:62
    def env_suggests_parallel_tests?; end

    # pkg:gem/simplecov#lib/simplecov/parallel_adapters/parallel_tests.rb:42
    def expected_worker_count; end

    # The first started process, not the last. The parallel_tests README
    # recommends `first_process?` for "do something once after every worker
    # finishes" hooks, so user code with its own
    # `wait_for_other_processes_to_finish` overwhelmingly waits in the first
    # process, and picking the same side avoids the cross-process deadlock #922
    # reported.
    #
    # pkg:gem/simplecov#lib/simplecov/parallel_adapters/parallel_tests.rb:28
    def first_worker?; end

    # pkg:gem/simplecov#lib/simplecov/parallel_adapters/parallel_tests.rb:66
    def native_parallel_tests_environment?; end

    # pkg:gem/simplecov#lib/simplecov/parallel_adapters/parallel_tests.rb:38
    def native_wait?; end

    # pkg:gem/simplecov#lib/simplecov/parallel_adapters/parallel_tests.rb:32
    def wait_for_siblings; end
  end
end

# `ResultMerger.absorb_results` fanned out across forked workers, driving
# `SimpleCov.collate(..., processes: N)`. Each worker folds a contiguous
# slice of the file list and ships the pair back over a pipe.
#
# The slices are contiguous and merged back in order, so the fold visits the
# resultsets in the order the serial fold visits them and the merged result
# is identical to `SimpleCov.collate`'s, not merely equivalent.
#
# pkg:gem/simplecov#lib/simplecov/parallel_result_merger/worker_payload.rb:4
module SimpleCov::ParallelResultMerger
  extend ::SimpleCov::ParallelResultMerger

  # pkg:gem/simplecov#lib/simplecov/parallel_result_merger.rb:86
  def abandon(workers); end

  # Answers nil when the work could not be fanned out and the caller should
  # merge in this process instead. The tracked paths and context-map union a
  # worker's slice carried come back with its payload rather than through a
  # collector block, since that block would be mutating state in the wrong
  # process.
  #
  # pkg:gem/simplecov#lib/simplecov/parallel_result_merger.rb:42
  def absorb_results(file_paths, processes:, ignore_timeout: T.unsafe(nil), tracked_files: T.unsafe(nil), context_maps: T.unsafe(nil)); end

  # pkg:gem/simplecov#lib/simplecov/parallel_result_merger.rb:54
  def chunk(file_paths, processes); end

  # Answers nil if any worker failed, so the caller redoes the fold serially
  # rather than report a subset of the resultsets as the whole.
  #
  # pkg:gem/simplecov#lib/simplecov/parallel_result_merger.rb:128
  def collect_payloads(workers); end

  # A thread per worker, so every pipe is drained while the workers are still
  # writing. A payload larger than the pipe buffer would otherwise block its
  # worker mid-write, and the parent would block reaping a worker that can
  # never finish.
  #
  # pkg:gem/simplecov#lib/simplecov/parallel_result_merger.rb:142
  def drain(workers); end

  # A `fork` that fails here raises, and is left to: the runtimes that never
  # fork are already excluded, so what remains is the OS refusing a process
  # we expected to get, which says something is wrong with the machine rather
  # than with the merge.
  #
  # pkg:gem/simplecov#lib/simplecov/parallel_result_merger.rb:66
  def fan_out(chunks, ignore_timeout:, tracked_files:, context_maps:); end

  # pkg:gem/simplecov#lib/simplecov/parallel_result_merger.rb:18
  def merge_and_store(*file_paths, processes:, ignore_timeout: T.unsafe(nil)); end

  # pkg:gem/simplecov#lib/simplecov/parallel_result_merger.rb:26
  def merge_results(*file_paths, processes:, ignore_timeout: T.unsafe(nil)); end

  # pkg:gem/simplecov#lib/simplecov/parallel_result_merger.rb:146
  def read_payload(reader); end

  # `exit!` rather than `exit` because the child must never fall through to
  # the collating process's inherited `at_exit` handlers, SimpleCov's own
  # report generation included.
  #
  # pkg:gem/simplecov#lib/simplecov/parallel_result_merger.rb:111
  def run_in_child(reader, writer, chunk, ignore_timeout); end

  # Kept free of the exit itself so it can be exercised in-process.
  #
  # pkg:gem/simplecov#lib/simplecov/parallel_result_merger.rb:117
  def run_worker(chunk, writer, ignore_timeout:); end

  # The caller cleans up the workers it knows about, but this pipe is ours.
  # The safe navigation keeps the cleanup well-defined when `IO.pipe` itself
  # raised, and Steep cannot type body locals inside an ensure.
  #
  # pkg:gem/simplecov#lib/simplecov/parallel_result_merger.rb:96
  def spawn_worker(chunk, ignore_timeout:); end

  # pkg:gem/simplecov#lib/simplecov/parallel_result_merger.rb:75
  def spawn_workers(chunks, ignore_timeout:); end

  # pkg:gem/simplecov#lib/simplecov/parallel_result_merger.rb:155
  def succeeded?(pid); end

  # pkg:gem/simplecov#lib/simplecov/parallel_result_merger.rb:164
  def warn_about_failed_workers(failed, total); end
end

# What a worker ships back over its pipe: the `[command_names, coverage]` pair
# its slice folded to, the tracked paths the slice carried, and the slice's
# context-map union. Building and folding live together so the pipe format
# has one owner. The parent needs the union across every worker of the
# tracked paths, to know what nothing loaded, and of the maps, to judge the
# all-or-nothing rule over the whole run rather than per slice.
#
# pkg:gem/simplecov#lib/simplecov/parallel_result_merger/worker_payload.rb:11
module SimpleCov::ParallelResultMerger::WorkerPayload
  extend ::SimpleCov::ParallelResultMerger::WorkerPayload

  # pkg:gem/simplecov#lib/simplecov/parallel_result_merger/worker_payload.rb:22
  def absorb(payload, tracked_files, context_maps); end

  # pkg:gem/simplecov#lib/simplecov/parallel_result_merger/worker_payload.rb:14
  def build(chunk, ignore_timeout:); end

  # pkg:gem/simplecov#lib/simplecov/parallel_result_merger/worker_payload.rb:28
  def pair(payload); end
end

# pkg:gem/simplecov#lib/simplecov/production/error.rb:4
module SimpleCov::Production; end

# Configuration and store-format failures. Sink errors raised from `store` are
# not wrapped in this: the runtime rescues them, warns, and retries on the
# next interval.
#
# pkg:gem/simplecov#lib/simplecov/production/error.rb:8
class SimpleCov::Production::Error < ::StandardError; end

# The bundled sink: a single JSON file, union-merged under an exclusive
# lock so any number of processes on the same host can share it. This is
# the reference for the sink contract:
#
#   store(coverage)  # {"lib/foo.rb" => [1, 3, 12], ...} of
#                    # root-relative paths to sorted line numbers
#
# A sink must merge (never replace: many processes each hold only a
# slice), must be idempotent (the same lines may arrive twice), and
# signals failure by raising, which makes the runtime keep the delta and
# retry next interval.
#
# `last_seen` stamps each file with the last store that carried it.
# Oneshot clears on drain, so still-running code re-reports every interval
# and the stamp tracks real recency, not first sighting. The field is
# optional on read: a v1 store written before it existed simply has no
# recency evidence to offer.
#
# pkg:gem/simplecov#lib/simplecov/production/file_sink.rb:27
class SimpleCov::Production::FileSink
  # pkg:gem/simplecov#lib/simplecov/production/file_sink.rb:35
  def initialize(path:); end

  # pkg:gem/simplecov#lib/simplecov/production/file_sink.rb:33
  def path; end

  # Truncates any leftover tail from a previously larger document.
  #
  # pkg:gem/simplecov#lib/simplecov/production/file_sink.rb:49
  def rewrite(file, payload); end

  # pkg:gem/simplecov#lib/simplecov/production/file_sink.rb:39
  def store(coverage); end

  private

  # pkg:gem/simplecov#lib/simplecov/production/file_sink.rb:116
  def envelope(existing, incoming); end

  # pkg:gem/simplecov#lib/simplecov/production/file_sink.rb:110
  def merge(existing, incoming); end

  # mutant:disable — Ruby 4.0 removed Kernel#open's leading-pipe
  # command mode, so no test can tell `File.open` from `open` here
  # any more. The explicit receiver is kept: on older rubies it is
  # what refuses to run a store path as a command.
  #
  # pkg:gem/simplecov#lib/simplecov/production/file_sink.rb:106
  def open_file(name, mode, perm, &); end

  # Both halves of the read-modify-write happen through the one handle, so
  # processes sharing the file take turns rather than overwriting each
  # other. The open flags are summed, which for disjoint bits is the same
  # number OR would build and leaves no spelling of the combination
  # without a witness.
  #
  # pkg:gem/simplecov#lib/simplecov/production/file_sink.rb:95
  def with_exclusive_lock; end

  class << self
    # The refusal is what keeps an arbitrary JSON file from being misread as
    # empty coverage.
    #
    # pkg:gem/simplecov#lib/simplecov/production/file_sink.rb:81
    def envelope_of(document, path); end

    # @api private -- shared by `read` and `store`'s read-modify-write. An
    # empty or missing file is a fresh store. JSON answers plain hashes,
    # arrays, and scalars, never a subclass of one, so the shape checks ask
    # about the class itself.
    #
    # pkg:gem/simplecov#lib/simplecov/production/file_sink.rb:66
    def parse(content, path); end

    # Raises `Error` for anything that is not a production coverage file,
    # naming the path: misreading an arbitrary JSON file as empty coverage
    # would quietly report every line dead.
    #
    # pkg:gem/simplecov#lib/simplecov/production/file_sink.rb:58
    def read(path); end
  end
end

# The envelope key, which is also how `read` tells a production coverage
# file from an arbitrary JSON document it must not clobber or misread.
#
# pkg:gem/simplecov#lib/simplecov/production/file_sink.rb:30
SimpleCov::Production::FileSink::ENVELOPE = T.let(T.unsafe(nil), String)

# pkg:gem/simplecov#lib/simplecov/production/file_sink.rb:31
SimpleCov::Production::FileSink::FORMAT_VERSION = T.let(T.unsafe(nil), Integer)

# Configuration procs loaded with `SimpleCov.start :rails` and defined with
# `SimpleCov.profiles.define`.
#
# pkg:gem/simplecov#lib/simplecov/profiles.rb:6
class SimpleCov::Profiles < ::Hash
  # pkg:gem/simplecov#lib/simplecov/profiles.rb:7
  def define(name, &blk); end

  # Lookup order: already registered via #define, then
  # `require "simplecov/profiles/<name>"` for the bundled profiles, then
  # `require "simplecov-profile-<name>"` for third-party plugin gems.
  #
  # pkg:gem/simplecov#lib/simplecov/profiles.rb:21
  def fetch_proc(name); end

  # pkg:gem/simplecov#lib/simplecov/profiles.rb:14
  def load(name); end

  private

  # pkg:gem/simplecov#lib/simplecov/profiles.rb:31
  def autoload_profile(name); end
end

# pkg:gem/simplecov#lib/simplecov/filter.rb:99
class SimpleCov::RegexFilter < ::SimpleCov::Filter
  # `Regexp#match?` rather than `=~` so the predicate returns a real boolean:
  # `=~` would return the match position, which trips rspec-mocks 4's
  # stricter predicate-matcher type check.
  #
  # pkg:gem/simplecov#lib/simplecov/filter.rb:103
  def matches?(source_file); end

  # pkg:gem/simplecov#lib/simplecov/filter.rb:107
  def path_only?; end
end

# Touches coverage/.report_stamp whenever a report is formatted, no matter how
# the run ends. The clobber-prevention backstop needs an on-disk signal that a
# fresher report exists, and `.last_run.json` can't be it alone: that file is
# only written after fully successful runs.
#
# pkg:gem/simplecov#lib/simplecov/report_stamp.rb:10
module SimpleCov::ReportStamp
  class << self
    # pkg:gem/simplecov#lib/simplecov/report_stamp.rb:12
    def path; end

    # A read-only or vanished coverage dir must not crash reporting; the stamp
    # only powers the deferral heuristic.
    #
    # pkg:gem/simplecov#lib/simplecov/report_stamp.rb:18
    def touch; end
  end
end

# A code coverage result, initialized from the Hash Ruby's built-in coverage
# library generates.
#
# pkg:gem/simplecov#lib/simplecov/result/filter_config.rb:4
class SimpleCov::Result
  include ::SimpleCov::Result::Serialization
  extend ::Forwardable

  # `filter_config` defaults to the SimpleCov singleton's filter / group
  # configuration. Pass a custom FilterConfig to opt out, which is useful for
  # tests that build synthetic Results.
  #
  # `tracked_files` accepts any collection that answers `to_a` (the merge
  # passes a Set), and nil for a run that tracked nothing.
