  # pkg:gem/simplecov#lib/simplecov/combine/methods_combiner.rb:34
  def materialize(target); end

  # pkg:gem/simplecov#lib/simplecov/combine/methods_combiner.rb:42
  def source_identity(key); end
end

# pkg:gem/simplecov#lib/simplecov/combine/results_combiner.rb:7
module SimpleCov::Combine::ResultsCombiner
  extend ::SimpleCov::Combine::ResultsCombiner

