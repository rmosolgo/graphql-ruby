    # pkg:gem/simplecov#lib/simplecov/history.rb:102
    def invalid_history; end

    # pkg:gem/simplecov#lib/simplecov/history.rb:80
    def measured_percents(stats_source); end

    # pkg:gem/simplecov#lib/simplecov/history.rb:97
    def write(entries); end
  end
end

