    private

    # pkg:gem/simplecov#lib/simplecov/history.rb:66
    def entry_for(result); end

    # pkg:gem/simplecov#lib/simplecov/history.rb:86
    def files_percents(result); end

    # pkg:gem/simplecov#lib/simplecov/history.rb:107
