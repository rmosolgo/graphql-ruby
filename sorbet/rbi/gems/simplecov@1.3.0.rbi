# pkg:gem/simplecov#lib/simplecov/test_tracker/framework_hooks.rb:124
module SimpleCov::TestTracker::MinitestRun
  # pkg:gem/simplecov#lib/simplecov/test_tracker/framework_hooks.rb:125
  def run; end
end

# The context id everything since the last boundary belongs to, and the
