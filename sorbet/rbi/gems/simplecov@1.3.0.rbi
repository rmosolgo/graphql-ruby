  # pkg:gem/simplecov#lib/simplecov/file_list.rb:31
  def missed_lines; end

  # pkg:gem/simplecov#lib/simplecov/file_list.rb:93
  def missed_methods; end

  # pkg:gem/simplecov#lib/simplecov/file_list.rb:35
  def never_lines; end

  # pkg:gem/simplecov#lib/simplecov/file_list.rb:10
  def size(*, **, &); end

  # pkg:gem/simplecov#lib/simplecov/file_list.rb:39
  def skipped_lines; end

  # pkg:gem/simplecov#lib/simplecov/file_list.rb:10
  def to_a(*, **, &); end

  # pkg:gem/simplecov#lib/simplecov/file_list.rb:10
  def to_ary(*, **, &); end

  # pkg:gem/simplecov#lib/simplecov/file_list.rb:69
  def total_branches; end

  # pkg:gem/simplecov#lib/simplecov/file_list.rb:85
  def total_methods; end

  private

  # pkg:gem/simplecov#lib/simplecov/file_list.rb:120
  def compute_coverage_statistics; end

  # Seeded with one entry per criterion the user enabled, so an empty FileList
  # still yields the right shape. `SourceFile#coverage_statistics` always
  # reports all three criteria; FileList is the layer that filters to the
  # enabled set so disabled criteria don't surface in totals, JSON, or the
  # HTML report.
  #
  # pkg:gem/simplecov#lib/simplecov/file_list.rb:108
  def compute_coverage_statistics_by_file; end

  # `:line` (or its `:oneshot_line` synonym) is reported when either criterion
  # is enabled; the JRuby-gated branch/method criteria are reported when they
  # pass their own engine-support check.
  #
  # pkg:gem/simplecov#lib/simplecov/file_list.rb:127
  def enabled_criteria_for_reporting; end
end

# Base filter class. Inherit from this to create custom filters, and
# override `matches?(source_file)`.
#
# pkg:gem/simplecov#lib/simplecov/filter.rb:8
class SimpleCov::Filter
  # pkg:gem/simplecov#lib/simplecov/filter.rb:11
  def initialize(filter_argument); end

  # pkg:gem/simplecov#lib/simplecov/filter.rb:9
  def filter_argument; end

  # pkg:gem/simplecov#lib/simplecov/filter.rb:15
  def matches?(_source_file); end

  # Whether this filter's verdict depends only on the file's path, so it can
  # be decided before that file has any coverage. Used when recording which
  # tracked files a process did not load. Defaults to false so a custom
  # filter is never guessed at (#1250).
  #
  # pkg:gem/simplecov#lib/simplecov/filter.rb:23
  def path_only?; end

  class << self
    # `string_filter` selects the semantics of bare String arguments:
    # StringFilter's segment-substring match for `skip`, GlobFilter for
    # `cover`. It threads through Array elements so a list gets the same
    # treatment as its members.
    #
    # pkg:gem/simplecov#lib/simplecov/filter.rb:31
    def build_filter(filter_argument, string_filter: T.unsafe(nil)); end

    # pkg:gem/simplecov#lib/simplecov/filter.rb:41
    def class_for_argument(filter_argument); end

    private

    # pkg:gem/simplecov#lib/simplecov/filter.rb:46
    def filter_classes_by_argument_type; end
  end
end

# pkg:gem/simplecov#lib/simplecov/formatter/multi_formatter.rb:4
module SimpleCov::Formatter
  class << self
    # pkg:gem/simplecov#lib/simplecov/formatter.rb:21
    def format(formatter, result); end

    # Formatters are configured either as classes, instantiated fresh for every
    # report, or as ready-built instances, the only way to reach constructor
    # options like `HTMLFormatter.new(silent: true)` (#1240).
    #
    # pkg:gem/simplecov#lib/simplecov/formatter.rb:8
    def instance_for(formatter); end

    private

    # mutant:disable
    # `Class` cannot itself be subclassed, so `instance_of?(Class)` answers for
    # every object exactly as `is_a?(Class)` does: a difference no example can
    # show, which is why it is disabled here rather than pinned by a test.
    #
    # pkg:gem/simplecov#lib/simplecov/formatter.rb:16
    def instantiable?(formatter); end
  end
end

# @api private
#
# Shared scaffolding for formatters that write a coverage report to an
# output directory and emit a "Coverage report generated for X to Y"
# summary on stderr. Subclasses override `format`, and may override
# `message_prefix`.
#
# pkg:gem/simplecov#lib/simplecov/formatter/base.rb:13
class SimpleCov::Formatter::Base
  # `output_dir` defaults to `SimpleCov.coverage_path`. Pass it explicitly
  # to write somewhere else.
  #
  # pkg:gem/simplecov#lib/simplecov/formatter/base.rb:16
  def initialize(silent: T.unsafe(nil), output_dir: T.unsafe(nil)); end

  private

  # The path shown in the "Coverage report generated for X to Y" status line.
  # Rendered relative to cwd when `output_path` lives inside cwd, with the
  # formatter's `entry_point_filename` appended so the line points at a
  # concrete file a terminal can hyperlink. Paths outside cwd stay
  # absolute; a `../../../tmp/cov` display would be more confusing (#197).
  #
  # pkg:gem/simplecov#lib/simplecov/formatter/base.rb:51
  def displayable_output_path; end

  # The one home of the "status lines go to stderr, not through warn"
  # decision (#1225). stderr rather than stdout because this is a status
  # message, not the program's output, so it stays out of pipelines like
  # `rspec -f json`. And `$stderr.puts` rather than `warn` so the line
  # neither reaches `Warning.warn` hooks nor vanishes under `-W0`.
  #
  # pkg:gem/simplecov#lib/simplecov/formatter/base.rb:28
  def emit_status(result); end

  # Subclasses override to name the report's entry-point file, which gets
  # appended to the directory in the status line. The empty body answers
  # nil, which leaves the bare directory in place for any third-party
  # formatter that has no single canonical entry point.
  #
  # pkg:gem/simplecov#lib/simplecov/formatter/base.rb:71
  def entry_point_filename; end

  # Subclasses override to prepend a marker (e.g. "JSON ") to the summary
  # line. Empty for the HTML formatter, historically the unmarked default.
  #
  # pkg:gem/simplecov#lib/simplecov/formatter/base.rb:38
  def message_prefix; end

  # One summary line per criterion the run actually measured, in the order
  # of `result.coverage_statistics`, which reflects what the user enabled.
  #
  # pkg:gem/simplecov#lib/simplecov/formatter/base.rb:76
  def output_message(result); end

  # pkg:gem/simplecov#lib/simplecov/formatter/base.rb:42
  def output_path; end

  # pkg:gem/simplecov#lib/simplecov/formatter/base.rb:57
  def relative_or_absolute_output_path; end

  # Returns nil for branch/method criteria that have nothing to measure.
  # Showing "Branch coverage: 0 / 0 (100.00%)" is noise.
  #
  # pkg:gem/simplecov#lib/simplecov/formatter/base.rb:84
  def stats_line(criterion, stat); end
end

# Auto-ratchets the per-file coverage baseline as a formatter, for teams
# that want floors to tighten on every run instead of by deliberate
# `simplecov ratchet` invocations. The semantics are exactly the CLI's, and
# the file is rewritten only when a floor actually moved.
#
# The exit checks still judge the run against the floors as they were when
# it started (the baseline is read once per path), and ratcheting never
# loosens a floor, so tightening before the checks cannot flip a failing
# file to passing.
#
# pkg:gem/simplecov#lib/simplecov/formatter/baseline_formatter.rb:17
class SimpleCov::Formatter::BaselineFormatter < ::SimpleCov::Formatter::Base
  # pkg:gem/simplecov#lib/simplecov/formatter/baseline_formatter.rb:18
  def format(result); end

  private

  # pkg:gem/simplecov#lib/simplecov/formatter/baseline_formatter.rb:51
  def below_floors(regressed); end

  # `SourceFile#coverage_statistics` answers for disabled criteria too, as
  # empty statistics, so the criteria are gated on the configuration rather
  # than on the stats' presence.
  #
  # pkg:gem/simplecov#lib/simplecov/formatter/baseline_formatter.rb:59
  def current_floors(result); end

  # pkg:gem/simplecov#lib/simplecov/formatter/baseline_formatter.rb:76
  def floor_of(file, criterion); end

  # pkg:gem/simplecov#lib/simplecov/formatter/baseline_formatter.rb:37
  def generate(current); end

  # pkg:gem/simplecov#lib/simplecov/formatter/baseline_formatter.rb:68
  def measured_criteria; end

  # `format` hands the ratchet's summary to `emit_status`, which passes it
  # through to here in the result's place.
  #
  # pkg:gem/simplecov#lib/simplecov/formatter/baseline_formatter.rb:93
  def output_message(message); end

  # The baseline lives where the exit check reads it, not under the coverage
  # directory: it is checked-in policy, not a report artifact.
  #
  # pkg:gem/simplecov#lib/simplecov/formatter/baseline_formatter.rb:87
  def output_path; end

  # pkg:gem/simplecov#lib/simplecov/formatter/baseline_formatter.rb:24
  def ratchet(result); end

  # pkg:gem/simplecov#lib/simplecov/formatter/baseline_formatter.rb:44
  def summary(outcome, changed); end

  # pkg:gem/simplecov#lib/simplecov/formatter/baseline_formatter.rb:81
  def write(baseline); end
end

# Shared writer for the coverage.json artifact, used by JSONFormatter as its
# report and by HTMLFormatter as the side file feeding `simplecov serve` and
# external tools. Centralizing the write keeps the two copies byte-identical
# and gives both formatters the concurrent-overwrite warning of #1171.
#
# pkg:gem/simplecov#lib/simplecov/formatter/coverage_json_writer.rb:13
module SimpleCov::Formatter::CoverageJSONWriter
  extend ::SimpleCov::Formatter::CoverageJSONWriter

  # pkg:gem/simplecov#lib/simplecov/formatter/coverage_json_writer.rb:47
  def existing_meta(path); end

  # pkg:gem/simplecov#lib/simplecov/formatter/coverage_json_writer.rb:70
  def parse_meta(path); end

  # pkg:gem/simplecov#lib/simplecov/formatter/coverage_json_writer.rb:87
  def parse_meta_full(path); end

  # The meta object is flat and sits at the head of every file this module
  # writes, so the common case parses just that slice instead of a
  # multi-megabyte report. A miss falls back to the full parse.
  #
  # pkg:gem/simplecov#lib/simplecov/formatter/coverage_json_writer.rb:77
  def parse_meta_head(path); end

  # Our own writer emits an ISO 8601 string, but coverage.json is whatever
  # wrote it last: third-party formatters rewrite it in their own shape with
  # an epoch integer, and `Time.iso8601` raised TypeError on that, taking the
  # whole report down on the next run. Anything but the two spellings disables
  # the concurrency check for this file instead of failing the write (#1285).
  #
  # pkg:gem/simplecov#lib/simplecov/formatter/coverage_json_writer.rb:61
  def parse_time(value); end

  # Warns when the existing coverage.json has a timestamp newer than this
  # process's start time, a strong signal that a sibling test process wrote it
  # while we were running. A matching command_name means the same merged
  # result, which is what both formatters configured together produce, so
  # there is nothing to lose by overwriting (#1171).
  #
  # pkg:gem/simplecov#lib/simplecov/formatter/coverage_json_writer.rb:33
  def warn_if_concurrent_overwrite(path, result); end

  # pkg:gem/simplecov#lib/simplecov/formatter/coverage_json_writer.rb:21
  def write(output_path, hash, result); end
end

