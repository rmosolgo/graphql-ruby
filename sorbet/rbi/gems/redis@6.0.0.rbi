  # @return [String] the field name
  # @return [String] the order keyword, always "DESC"
  #
  # pkg:gem/redis#lib/redis/commands/modules/search/aggregation.rb:177
  def order; end
end

# A single document returned by FT.SEARCH.
#
# Behaves like a read-only hash over the document's returned fields, while also
# exposing the document +id+ and, when requested, its +score+ and +payload+.
#
# pkg:gem/redis#lib/redis/commands/modules/search/result.rb:12
class Redis::Commands::Search::Document
  # @param id [String] the document key/id
  # @param attributes [Hash{String => Object}] the returned fields keyed by field name
  # @param score [Float, Array, nil] the relevance score (Float; +[Float, explanation]+ with EXPLAINSCORE)
  # @param payload [String, nil] the document payload
  #
  # pkg:gem/redis#lib/redis/commands/modules/search/result.rb:24
  def initialize(id, attributes: T.unsafe(nil), score: T.unsafe(nil), payload: T.unsafe(nil)); end

  # @param other [Object] the object to compare against
  # @return [Boolean] whether +other+ is a Document with equal id, attributes, score and payload
  #
  # pkg:gem/redis#lib/redis/commands/modules/search/result.rb:54
  def ==(other); end

  # Look up a returned field by name.
  #
  # @param key [String, Symbol] the field name
  # @return [Object, nil] the field value, or nil when the field is absent
  #
  # pkg:gem/redis#lib/redis/commands/modules/search/result.rb:35
  def [](key); end

  # @return [String] the document key/id
  # @return [Float, Array, nil] the relevance score (present when WITHSCORES was set),
  #   normalized to a Float across RESP2/RESP3; with EXPLAINSCORE it is +[Float, explanation]+
  # @return [String, nil] the document payload (present when WITHPAYLOADS was set)
  # @return [Hash{String => Object}] the returned fields keyed by field name
  #
  # pkg:gem/redis#lib/redis/commands/modules/search/result.rb:18
  def attributes; end

  # pkg:gem/redis#lib/redis/commands/modules/search/result.rb:61
  def eql?(other); end

  # @return [Integer] a hash derived from id, attributes, score and payload
  #
  # pkg:gem/redis#lib/redis/commands/modules/search/result.rb:64
  def hash; end

  # @return [String] the document key/id
  # @return [Float, Array, nil] the relevance score (present when WITHSCORES was set),
  #   normalized to a Float across RESP2/RESP3; with EXPLAINSCORE it is +[Float, explanation]+
  # @return [String, nil] the document payload (present when WITHPAYLOADS was set)
  # @return [Hash{String => Object}] the returned fields keyed by field name
  #
  # pkg:gem/redis#lib/redis/commands/modules/search/result.rb:18
  def id; end

  # @param key [String, Symbol] the field name
  # @return [Boolean] whether the document has the given field
  #
  # pkg:gem/redis#lib/redis/commands/modules/search/result.rb:41
  def key?(key); end

  # @return [String] the document key/id
  # @return [Float, Array, nil] the relevance score (present when WITHSCORES was set),
  #   normalized to a Float across RESP2/RESP3; with EXPLAINSCORE it is +[Float, explanation]+
  # @return [String, nil] the document payload (present when WITHPAYLOADS was set)
  # @return [Hash{String => Object}] the returned fields keyed by field name
  #
  # pkg:gem/redis#lib/redis/commands/modules/search/result.rb:18
  def payload; end

  # @return [String] the document key/id
  # @return [Float, Array, nil] the relevance score (present when WITHSCORES was set),
  #   normalized to a Float across RESP2/RESP3; with EXPLAINSCORE it is +[Float, explanation]+
  # @return [String, nil] the document payload (present when WITHPAYLOADS was set)
  # @return [Hash{String => Object}] the returned fields keyed by field name
  #
  # pkg:gem/redis#lib/redis/commands/modules/search/result.rb:18
  def score; end

  # The document id plus its returned fields, as a flat hash.
  #
  # @return [Hash{String => Object}] the attributes merged with +"id"+
  #
  # pkg:gem/redis#lib/redis/commands/modules/search/result.rb:48
  def to_h; end
end

# Base class for a single field in a Redis Query Engine +SCHEMA+ (the
# field list passed to +FT.CREATE+). Subclasses describe the field type
# (+TEXT+, +TAG+, +NUMERIC+, +GEO+, +GEOSHAPE+, +VECTOR+).
#
# pkg:gem/redis#lib/redis/commands/modules/search/field.rb:9
class Redis::Commands::Search::Field
  # Build a field definition.
  #
  # @example
  #   Redis::Commands::Search::Field.new("title", :text, weight: 5.0, sortable: true)
  #
  # @param [String, Symbol] name the document attribute the field indexes
  # @param [Symbol] type the field type, e.g. +:text+, +:tag+, +:numeric+
  # @param [Query, nil] query a query the field is bound to, enabling predicate helpers
  # @option options [String] :as an alias for the field, rendered as +AS <alias>+
  # @option options [Boolean] :no_index do not index the field (+NOINDEX+)
  # @option options [Boolean] :index_missing index documents missing the field (+INDEXMISSING+)
  # @option options [Boolean] :index_empty index empty values (+INDEXEMPTY+)
  # @option options [Boolean] :sortable allow sorting by the field (+SORTABLE+)
  # @option options [Boolean] :withsuffixtrie build a suffix trie (+WITHSUFFIXTRIE+)
  #
  # pkg:gem/redis#lib/redis/commands/modules/search/field.rb:27
  def initialize(name, type, query = T.unsafe(nil), **options); end

  # pkg:gem/redis#lib/redis/commands/modules/search/field.rb:10
  def alias_name; end

  # pkg:gem/redis#lib/redis/commands/modules/search/field.rb:10
  def name; end

  # pkg:gem/redis#lib/redis/commands/modules/search/field.rb:10
  def options; end

  # pkg:gem/redis#lib/redis/commands/modules/search/field.rb:11
  def query; end

  # pkg:gem/redis#lib/redis/commands/modules/search/field.rb:11
  def query=(_arg0); end

  # Render this field as the array of +FT.CREATE+ +SCHEMA+ tokens.
  #
  # @example
  #   Redis::Commands::Search::Field.new("title", :text, weight: 5.0, sortable: true).to_args
  #     # => ["title", "TEXT", "WEIGHT", "5.0", "SORTABLE"]
  #
  # @return [Array] the schema tokens for this field
  #
  # pkg:gem/redis#lib/redis/commands/modules/search/field.rb:42
  def to_args; end

  # pkg:gem/redis#lib/redis/commands/modules/search/field.rb:10
  def type; end
end

