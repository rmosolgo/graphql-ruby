  # pkg:gem/redis#lib/redis/commands/sets.rb:181
  def sunion(*keys); end

  # Get the number of distinct members in the union of multiple sets.
  #
  # @example
  #   redis.sadd("foo", ["s1", "s2", "s3"])
  #   redis.sadd("bar", ["s3", "s4"])
  #   redis.sunioncard("foo", "bar")
