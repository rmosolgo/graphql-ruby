# pkg:gem/redis#lib/redis/commands/modules/search/hybrid.rb:10
class Redis::Commands::Search::HybridSearchQuery
  # @param query_string [String] the search query string
  # @param scorer [String, nil] the scoring function
  # @param yield_score_as [String, nil] the alias to expose the search score under
  #
  # pkg:gem/redis#lib/redis/commands/modules/search/hybrid.rb:17
  def initialize(query_string, scorer: T.unsafe(nil), yield_score_as: T.unsafe(nil)); end

  # @return [Array] the +SEARCH+ leg argument tokens, beginning with "SEARCH"
  #
  # pkg:gem/redis#lib/redis/commands/modules/search/hybrid.rb:42
  def args; end

  # @return [String] the search query string
  #
  # pkg:gem/redis#lib/redis/commands/modules/search/hybrid.rb:12
  def query_string; end

  # Set the scoring function (+SCORER+).
  #
  # @param scorer [String] the scorer name
  # @return [self]
  #
  # pkg:gem/redis#lib/redis/commands/modules/search/hybrid.rb:27
  def scorer(scorer); end

  # Expose the search score under an alias (+YIELD_SCORE_AS+).
  #
  # @param alias_name [String] the alias for the score
  # @return [self]
  #
  # pkg:gem/redis#lib/redis/commands/modules/search/hybrid.rb:36
  def yield_score_as(alias_name); end
end

# The vector-similarity +VSIM+ leg of an FT.HYBRID query.
#
# Chainable setters (+vsim_method_params+, +filter+, +yield_score_as+) return +self+;
# {#args} renders the leg into its argument tokens, beginning with "VSIM".
#
# pkg:gem/redis#lib/redis/commands/modules/search/hybrid.rb:54
class Redis::Commands::Search::HybridVsimQuery
  # @param vector_field_name [String] the vector field to search
  # @param vector_data [String] the query vector blob
  # @param vsim_search_method [Symbol, String, nil] the search method, e.g. +:knn+ or +:range+
  # @param vsim_search_method_params [Hash, nil] the search-method parameters
  # @param filter [HybridFilter, nil] an optional filter applied to the vector leg
  # @param yield_score_as [String, nil] the alias to expose the vector score under
  #
  # pkg:gem/redis#lib/redis/commands/modules/search/hybrid.rb:65
  def initialize(vector_field_name:, vector_data:, vsim_search_method: T.unsafe(nil), vsim_search_method_params: T.unsafe(nil), filter: T.unsafe(nil), yield_score_as: T.unsafe(nil)); end

  # @return [Array] the +VSIM+ leg argument tokens, beginning with "VSIM"
  #
  # pkg:gem/redis#lib/redis/commands/modules/search/hybrid.rb:116
  def args; end

  # Set a filter applied to the vector leg (+FILTER+).
  #
  # @param flt [HybridFilter] the filter to apply
  # @return [self]
  #
  # pkg:gem/redis#lib/redis/commands/modules/search/hybrid.rb:101
  def filter(flt); end

  # @return [String] the vector field name
  # @return [String] the query vector data (blob)
  #
  # pkg:gem/redis#lib/redis/commands/modules/search/hybrid.rb:57
  def vector_data; end

  # @return [String] the vector field name
  # @return [String] the query vector data (blob)
  #
  # pkg:gem/redis#lib/redis/commands/modules/search/hybrid.rb:57
  def vector_field; end

  # Set the vector search method and its parameters (e.g. +KNN+ / +RANGE+).
  #
  # @param method [Symbol, String] the search method (upcased into a token)
  # @param kwargs [Hash] the method parameters, emitted as upcased key/value pairs
  # @return [self]
  #
  # pkg:gem/redis#lib/redis/commands/modules/search/hybrid.rb:86
  def vsim_method_params(method, **kwargs); end

  # Expose the vector score under an alias (+YIELD_SCORE_AS+).
  #
  # @param alias_name [String] the alias for the score
  # @return [self]
  #
  # pkg:gem/redis#lib/redis/commands/modules/search/hybrid.rb:110
  def yield_score_as(alias_name); end
end

# High-level handle to a search index: a {Schema}, an optional key prefix and a +Redis+
# connection bundled together. It is the most ergonomic entry point for HASH/JSON document
# workflows — it remembers the prefix (so document ids round-trip to the logical id passed to
# {#add}), validates field values against the schema, and accepts a {Query}, a query string,
# or a block in {#search}. Obtain one via +Redis#create_index+ or {Index.create}.
#
# pkg:gem/redis#lib/redis/commands/modules/search/index.rb:11
class Redis::Commands::Search::Index
  # @param redis [Redis] the client used for all index operations
  # @param name [String] the index name
  # @param schema [Schema] the field schema
  # @param storage_type [String] the indexed data type (+"hash"+ or +"json"+)
  # @param prefix [String, nil] key prefix for documents
  # @param stopwords [Array<String>, nil] custom stopword list
  #
  # pkg:gem/redis#lib/redis/commands/modules/search/index.rb:23
  def initialize(redis, name, schema, storage_type, prefix: T.unsafe(nil), stopwords: T.unsafe(nil)); end

  # Add (or replace) a document under the key +"<prefix><doc_id>"+ (or +doc_id+ when no
  # prefix is set). The document is written to match the index's storage type: a HASH
  # (+HSET+) for a HASH index, or a JSON document at the root path (+JSON.SET+) for a JSON
  # index — so the index actually picks it up either way.
  #
  # For a JSON index the given +fields+ are written verbatim as the JSON document at the
  # root path (+$+), so each key lands at a top-level attribute. This works when the schema
  # indexes root-level JSONPaths (+$.brand AS brand+, so +add("1", brand: "x")+ stores
  # +{"brand":"x"}+ which +$.brand+ matches). It does *not* build nested structure: a field
  # over a nested path (+$.user.name AS name+) is not satisfied by a flat +name: "..."+
  # write — pass the full document shape instead (+add("1", user: { name: "Ann" })+).
  #
  # @example
  #   index.add("1", title: "hello", price: 10)
  #
  # @param doc_id [String] the logical document id
  # @param fields [Hash{Symbol,String => Object}] the field/value pairs to store
  # @return [Integer, String] the +HSET+ reply (HASH index) or the +JSON.SET+ reply (JSON index)
  # @raise [Redis::CommandError] if a value for a {NumericField} is not Numeric, or the write fails
  #
  # pkg:gem/redis#lib/redis/commands/modules/search/index.rb:105
  def add(doc_id, **fields); end

  # Run an aggregation pipeline against the index (delegates to +FT.AGGREGATE+).
  #
  # @param query [AggregateRequest, Cursor, String] the aggregate request, a cursor, or a raw
  #   query string followed by raw pipeline +args+
  # @param args [Array] raw pipeline tokens when +query+ is a String
  # @return [AggregateResult] the result rows and cursor
  #
  # pkg:gem/redis#lib/redis/commands/modules/search/index.rb:259
  def aggregate(query, *args); end

  # Add a field to the index schema (delegates to +FT.ALTER+).
  #
  # @param field_or_args [Search::Field, Array] a {Search::Field} (rendered via +#to_args+)
  #   or a raw token array describing the field to add
  # @return [String] +"OK"+
  #
  # pkg:gem/redis#lib/redis/commands/modules/search/index.rb:294
  def alter(field_or_args); end

  # Drop the index (delegates to +FT.DROPINDEX+).
  #
  # @param delete_documents [Boolean] also delete the indexed documents (+DD+)
  # @return [String] +"OK"+
  #
  # pkg:gem/redis#lib/redis/commands/modules/search/index.rb:249
  def drop(delete_documents: T.unsafe(nil)); end

  # Return the execution plan for a query without running it (delegates to +FT.EXPLAIN+).
  #
  # @param query [String] the query string
  # @return [String] the query plan
  #
  # pkg:gem/redis#lib/redis/commands/modules/search/index.rb:285
  def explain(query); end

  # Run a hybrid (lexical + vector) search against this index (delegates to +FT.HYBRID+).
  #
  # @param query [Search::HybridQuery] the combined SEARCH + VSIM query
  # @param combine_method [Search::CombineResultsMethod, nil] the fusion strategy (RRF/LINEAR)
  # @param post_processing [Search::HybridPostProcessingConfig, nil] a post-fusion pipeline
  # @param params_substitution [Hash, nil] query parameter substitutions (+PARAMS+)
  # @param timeout [Integer, nil] query timeout in milliseconds (+TIMEOUT+)
  # @param cursor [Search::HybridCursorQuery, nil] cursor/pagination config (+WITHCURSOR+)
  # @return [Search::HybridResult] the fused results (or per-leg cursor ids for WITHCURSOR)
  #
  # pkg:gem/redis#lib/redis/commands/modules/search/index.rb:272
  def hybrid_search(query:, combine_method: T.unsafe(nil), post_processing: T.unsafe(nil), params_substitution: T.unsafe(nil), timeout: T.unsafe(nil), cursor: T.unsafe(nil)); end

  # Return information and statistics about the index (delegates to +FT.INFO+).
  #
  # @return [Hash] index metadata
  #
  # pkg:gem/redis#lib/redis/commands/modules/search/index.rb:241
  def info; end

  # @return [String] the index name
  # @return [String, nil] the literal key prefix prepended to (and stripped from) document
  #   ids, e.g. "doc:"; nil when the index manages no single prefix
  #
  # pkg:gem/redis#lib/redis/commands/modules/search/index.rb:15
  def name; end

  # @return [String] the index name
  # @return [String, nil] the literal key prefix prepended to (and stripped from) document
  #   ids, e.g. "doc:"; nil when the index manages no single prefix
  #
  # pkg:gem/redis#lib/redis/commands/modules/search/index.rb:15
  def prefix; end

  # Profile the execution of a query (delegates to +FT.PROFILE+).
  #
  # @param args [Array] the profile arguments
  # @return [Array] the raw profile reply
  #
  # pkg:gem/redis#lib/redis/commands/modules/search/index.rb:338
  def profile(*args); end

  # Search the index.
  #
  # Accepts a {Query} object, a raw query string, or a block evaluated as a {Query}. Keyword
  # arguments are applied on top of the query before it is sent. Document ids in the result
  # have the index prefix stripped, so they match the ids passed to {#add}.
  #
  # @example with a Query object
  #   index.search(Redis::Commands::Search::Query.new("@title:hello").paging(0, 10))
  #
  # @example with a block
  #   index.search { text(:title).match("hello*") }
  #
  # @param query [Query, String, nil] the query (a {Query}, a query string, or nil when a
  #   block is given)
  # @param query_params [Hash, Array, nil] query parameter substitutions (overrides +params+)
  # @param params [Hash, Array, nil] query parameter substitutions (+PARAMS+)
  # @param dialect [Integer, nil] query dialect version (+DIALECT+)
  # @param nocontent [Boolean, nil] return ids only (+NOCONTENT+)
  # @param verbatim [Boolean, nil] disable stemming (+VERBATIM+)
  # @param no_stopwords [Boolean, nil] do not remove stopwords (+NOSTOPWORDS+)
  # @param with_scores [Boolean, nil] include relevance scores (+WITHSCORES+)
  # @param with_payloads [Boolean, nil] include payloads (+WITHPAYLOADS+)
  # @param slop [Integer, nil] allowed term reordering distance (+SLOP+)
  # @param in_order [Boolean, nil] require terms in query order (+INORDER+)
  # @param language [String, nil] stemming language (+LANGUAGE+)
  # @param return_fields [Array<String>, nil] only return these fields (+RETURN+)
  # @param summarize [Hash, nil] +SUMMARIZE+ options
  # @param highlight [Hash, nil] +HIGHLIGHT+ options
  # @param sort_by [String, nil] sort field (+SORTBY+)
  # @param asc [Boolean, nil] sort ascending (default) when +sort_by+ is given; +false+ for descending
  # @param scorer [String, nil] scoring function name (+SCORER+)
  # @param explain_score [Boolean, nil] include a score explanation (+EXPLAINSCORE+)
  # @return [SearchResult] the total count and matching {Document}s (prefix stripped from ids)
  # @raise [ArgumentError] if no usable query is provided
  #
  # pkg:gem/redis#lib/redis/commands/modules/search/index.rb:157
  def search(query = T.unsafe(nil), query_params: T.unsafe(nil), params: T.unsafe(nil), dialect: T.unsafe(nil), nocontent: T.unsafe(nil), verbatim: T.unsafe(nil), no_stopwords: T.unsafe(nil), with_scores: T.unsafe(nil), with_payloads: T.unsafe(nil), slop: T.unsafe(nil), in_order: T.unsafe(nil), language: T.unsafe(nil), return_fields: T.unsafe(nil), summarize: T.unsafe(nil), highlight: T.unsafe(nil), sort_by: T.unsafe(nil), asc: T.unsafe(nil), scorer: T.unsafe(nil), explain_score: T.unsafe(nil), &block); end

  # Perform spelling correction over a query against the index (delegates to +FT.SPELLCHECK+).
  #
  # @param query [String] the query whose terms are checked
  # @param distance [Integer, nil] maximum Levenshtein distance for suggestions (+DISTANCE+)
  # @param include [String, nil] a custom dictionary to include terms from (+TERMS INCLUDE+)
  # @param exclude [String, nil] a custom dictionary to exclude terms from (+TERMS EXCLUDE+)
  # @return [Hash{String=>Array<Hash>}] misspelled terms mapped to suggestions
  #
  # pkg:gem/redis#lib/redis/commands/modules/search/index.rb:305
  def spellcheck(query, distance: T.unsafe(nil), include: T.unsafe(nil), exclude: T.unsafe(nil)); end

  # Dump the synonym groups of the index (delegates to +FT.SYNDUMP+).
  #
  # @return [Hash{String=>Array<String>}] each term mapped to its synonym group ids
  #
  # pkg:gem/redis#lib/redis/commands/modules/search/index.rb:322
  def syndump; end

  # Add or update a synonym group on the index (delegates to +FT.SYNUPDATE+).
  #
  # @param group_id [String] the synonym group id
  # @param terms [Array<String>] the terms to add to the group
  # @param skip_initial_scan [Boolean] do not re-scan existing documents (+SKIPINITIALSCAN+)
  # @return [String] +"OK"+
  #
  # pkg:gem/redis#lib/redis/commands/modules/search/index.rb:315
  def synupdate(group_id, *terms, skip_initial_scan: T.unsafe(nil)); end

  # List the distinct values of a TAG field (delegates to +FT.TAGVALS+).
  #
  # @param field_name [String] the TAG field name
  # @return [Array<String>] the distinct tag values
  #
  # pkg:gem/redis#lib/redis/commands/modules/search/index.rb:330
  def tagvals(field_name); end

  private

  # Whether this index is built over JSON documents (vs. HASH keys).
  #
  # pkg:gem/redis#lib/redis/commands/modules/search/index.rb:345
  def json?; end

  class << self
    # Create the index on the server (runs +FT.CREATE+) and return a handle to it.
    #
    # @example
    #   Redis::Commands::Search::Index.create(redis, "idx", schema, "hash", prefix: "doc")
    #
    # @param redis [Redis] the client to use
    # @param name [String] the index name
    # @param schema [Schema] the field schema
    # @param storage_type [String] the indexed data type (+"hash"+ or +"json"+)
    # @param prefix [String, nil] key prefix for documents
    # @param stopwords [Array<String>, nil] custom stopword list
    # @param skip_initial_scan [Boolean] do not backfill existing keys (+SKIPINITIALSCAN+)
    # @return [Index] the created index
    # @raise [ArgumentError] if +schema+ is not a {Schema}
    #
    # pkg:gem/redis#lib/redis/commands/modules/search/index.rb:46
    def create(redis, name, schema, storage_type, prefix: T.unsafe(nil), stopwords: T.unsafe(nil), skip_initial_scan: T.unsafe(nil), **options); end

    # The single literal key prefix the Index should manage, or nil when it can't be
    # determined unambiguously (no prefix, or a definition with several prefixes).
    #
    # pkg:gem/redis#lib/redis/commands/modules/search/index.rb:69
    def key_prefix(prefix, definition); end

    # The effective storage type, mirroring FT.CREATE: a definition's own +index_type+ wins
    # when set, otherwise fall back to the +storage_type+ keyword. This keeps #add's write
    # path (hset vs json_set) consistent with the ON clause, so a definition without a type
    # plus +storage_type: :json+ still indexes as JSON.
    #
    # pkg:gem/redis#lib/redis/commands/modules/search/index.rb:81
    def resolve_storage_type(storage_type, definition); end
  end
end

# The definition portion of an +FT.CREATE+ call: which keyspace the index
# is built over and how documents are scored and filtered. Renders into a
# token array exposed via {#args}.
#
# pkg:gem/redis#lib/redis/commands/modules/search/index_definition.rb:15
class Redis::Commands::Search::IndexDefinition
  # Build an index definition and pre-render its +FT.CREATE+ tokens.
  #
  # @example
  #   Redis::Commands::Search::IndexDefinition.new(prefix: ["doc:"], index_type: IndexType::JSON).args
  #     # => ["ON", "JSON", "PREFIX", 1, "doc:", "SCORE", 1.0]
  #
  # @param [Array<String>, String, nil] prefix key prefix(es) the index applies to (+PREFIX+);
  #   a single String is wrapped into a one-element list and nil means "no prefix"
  # @param [String, nil] filter a filter expression (+FILTER+)
  # @param [String, nil] language_field the field holding each document's language (+LANGUAGE_FIELD+)
  # @param [String, nil] language the default document language (+LANGUAGE+)
  # @param [String, nil] score_field the field holding each document's score (+SCORE_FIELD+)
  # @param [Numeric] score the default document score (+SCORE+)
  # @param [String, nil] payload_field the field holding each document's payload (+PAYLOAD_FIELD+)
  # @param [String, nil] index_type the indexed data structure, {IndexType::HASH} or {IndexType::JSON} (+ON+)
  # @raise [ArgumentError] if +index_type+ is given but is not {IndexType::HASH} or {IndexType::JSON}
  #
  # pkg:gem/redis#lib/redis/commands/modules/search/index_definition.rb:37
  def initialize(prefix: T.unsafe(nil), filter: T.unsafe(nil), language_field: T.unsafe(nil), language: T.unsafe(nil), score_field: T.unsafe(nil), score: T.unsafe(nil), payload_field: T.unsafe(nil), index_type: T.unsafe(nil)); end

  # @return [Array] the rendered +FT.CREATE+ definition tokens
  # @return [Array<String>] the literal key prefixes the index applies to
  # @return [String, nil] the indexed data structure ({IndexType::HASH}/{IndexType::JSON}), or nil
  #
  # pkg:gem/redis#lib/redis/commands/modules/search/index_definition.rb:19
  def args; end

  # @return [Array] the rendered +FT.CREATE+ definition tokens
  # @return [Array<String>] the literal key prefixes the index applies to
  # @return [String, nil] the indexed data structure ({IndexType::HASH}/{IndexType::JSON}), or nil
  #
  # pkg:gem/redis#lib/redis/commands/modules/search/index_definition.rb:19
  def index_type; end

  # @return [Array] the rendered +FT.CREATE+ definition tokens
  # @return [Array<String>] the literal key prefixes the index applies to
  # @return [String, nil] the indexed data structure ({IndexType::HASH}/{IndexType::JSON}), or nil
  #
  # pkg:gem/redis#lib/redis/commands/modules/search/index_definition.rb:19
  def prefixes; end

  private

  # pkg:gem/redis#lib/redis/commands/modules/search/index_definition.rb:76
  def append_filter(filter); end

  # pkg:gem/redis#lib/redis/commands/modules/search/index_definition.rb:58
  def append_index_type(index_type); end

  # pkg:gem/redis#lib/redis/commands/modules/search/index_definition.rb:83
  def append_language(language_field, language); end

  # pkg:gem/redis#lib/redis/commands/modules/search/index_definition.rb:105
  def append_payload(payload_field); end

  # pkg:gem/redis#lib/redis/commands/modules/search/index_definition.rb:68
  def append_prefix(prefix); end

  # pkg:gem/redis#lib/redis/commands/modules/search/index_definition.rb:94
  def append_score(score_field, score); end
end

# The data structure an index is built over, passed as IndexDefinition(index_type:).
#
# pkg:gem/redis#lib/redis/commands/modules/search/index_definition.rb:7
module Redis::Commands::Search::IndexType; end

# pkg:gem/redis#lib/redis/commands/modules/search/index_definition.rb:8
Redis::Commands::Search::IndexType::HASH = T.let(T.unsafe(nil), String)

# pkg:gem/redis#lib/redis/commands/modules/search/index_definition.rb:9
Redis::Commands::Search::IndexType::JSON = T.let(T.unsafe(nil), String)

# A +NUMERIC+ field, indexing numeric values for range queries.
#
# pkg:gem/redis#lib/redis/commands/modules/search/field.rb:139
class Redis::Commands::Search::NumericField < ::Redis::Commands::Search::Field
  # Build a +NUMERIC+ field.
  #
  # @param [String, Symbol] name the document attribute the field indexes
  # @param [Query, nil] query a query the field is bound to, enabling {#gt}, {#lt}, {#between}
  #
  # pkg:gem/redis#lib/redis/commands/modules/search/field.rb:144
  def initialize(name, query = T.unsafe(nil), **options); end

  # Add an inclusive range predicate to the bound query.
  #
  # @param [Numeric] min the inclusive lower bound
  # @param [Numeric] max the inclusive upper bound
  # @return [Query] the bound query with the predicate added
  # @raise [ArgumentError] if +min+ or +max+ is not numeric
  #
  # pkg:gem/redis#lib/redis/commands/modules/search/field.rb:172
  def between(min, max); end

  # Add a greater-than range predicate to the bound query.
  #
  # @param [Numeric] value the exclusive lower bound
  # @return [Query] the bound query with the predicate added
  # @raise [ArgumentError] if +value+ is not numeric
  #
  # pkg:gem/redis#lib/redis/commands/modules/search/field.rb:153
  def gt(value); end

  # Add a less-than range predicate to the bound query.
  #
  # @param [Numeric] value the exclusive upper bound
  # @return [Query] the bound query with the predicate added
  # @raise [ArgumentError] if +value+ is not numeric
  #
  # pkg:gem/redis#lib/redis/commands/modules/search/field.rb:162
  def lt(value); end
end

# Abstract base for a single query-string predicate. Subclasses render themselves into a
# query-string fragment via +#to_s+.
#
# pkg:gem/redis#lib/redis/commands/modules/search/query.rb:613
class Redis::Commands::Search::Predicate
  # @param field [String] the field name
  #
  # pkg:gem/redis#lib/redis/commands/modules/search/query.rb:630
  def initialize(field); end

  # @return [String] the field the predicate applies to
  #
  # pkg:gem/redis#lib/redis/commands/modules/search/query.rb:615
  def field; end

  # @raise [NotImplementedError] always; subclasses must override
  # @return [String] the query-string fragment
  #
  # pkg:gem/redis#lib/redis/commands/modules/search/query.rb:636
  def to_s; end

  private

  # Escape query metacharacters in a literal tag value, including whitespace.
  #
  # pkg:gem/redis#lib/redis/commands/modules/search/query.rb:648
  def escape_tag(value); end

  # Escape query metacharacters in a literal text value, keeping spaces as term separators.
  #
  # pkg:gem/redis#lib/redis/commands/modules/search/query.rb:643
  def escape_text(value); end
end

# pkg:gem/redis#lib/redis/commands/modules/search/query.rb:627
Redis::Commands::Search::Predicate::TAG_ESCAPE_PATTERN = T.let(T.unsafe(nil), Regexp)

# TAG values are single literal tokens, so whitespace is significant and must be escaped
# too. TEXT queries keep spaces, which separate terms (a multi-word match is an AND).
#
# pkg:gem/redis#lib/redis/commands/modules/search/query.rb:625
Redis::Commands::Search::Predicate::TAG_SPECIAL_CHARACTERS = T.let(T.unsafe(nil), Array)

# pkg:gem/redis#lib/redis/commands/modules/search/query.rb:626
Redis::Commands::Search::Predicate::TEXT_ESCAPE_PATTERN = T.let(T.unsafe(nil), Regexp)

# RediSearch query operators/metacharacters. Escaped with a backslash so an interpolated
# value is matched literally instead of altering (or breaking) the query.
#
# pkg:gem/redis#lib/redis/commands/modules/search/query.rb:619
Redis::Commands::Search::Predicate::TEXT_SPECIAL_CHARACTERS = T.let(T.unsafe(nil), Array)

# An ordered collection of predicates joined with AND (a space) or OR (+ | +).
#
# pkg:gem/redis#lib/redis/commands/modules/search/query.rb:711
class Redis::Commands::Search::PredicateCollection
  # @param type [Symbol] +:and+ to join with a space, +:or+ to join with +|+
  #
  # pkg:gem/redis#lib/redis/commands/modules/search/query.rb:717
  def initialize(type); end

  # Add a predicate (or nested collection) to this collection.
  #
  # @param predicate [Predicate, PredicateCollection] the predicate to add
  # @return [Array] the updated list of predicates
  #
  # pkg:gem/redis#lib/redis/commands/modules/search/query.rb:726
  def add(predicate); end

  # @return [Symbol] +:and+ or +:or+
  # @return [Array<Predicate, PredicateCollection>] the contained predicates
  #
  # pkg:gem/redis#lib/redis/commands/modules/search/query.rb:714
  def predicates; end

  # @return [String] the parenthesised, joined query-string fragment
  #
  # pkg:gem/redis#lib/redis/commands/modules/search/query.rb:731
  def to_s; end

  # @return [Symbol] +:and+ or +:or+
  # @return [Array<Predicate, PredicateCollection>] the contained predicates
  #
  # pkg:gem/redis#lib/redis/commands/modules/search/query.rb:714
  def type; end
end

# A fluent builder for FT.SEARCH query strings and their options.
#
# Chainable setter methods (+filter+, +paging+, +sort_by+, ...) return +self+ so calls can
# be strung together, and a predicate DSL (+tag+/+text+/+numeric+ combined with +and_+/+or_+)
# builds the query string itself. {#to_redis_args} renders the whole thing into the argument
# array passed to +FT.SEARCH+.
#
# @example
#   query = Redis::Commands::Search::Query.new("hello")
#     .paging(0, 10)
#     .sort_by("price", asc: false)
#   query.to_redis_args # => ["hello", "SORTBY", "price", "DESC", "LIMIT", 0, 10, "DIALECT", 2]
#
# pkg:gem/redis#lib/redis/commands/modules/search/query.rb:18
class Redis::Commands::Search::Query
  # @param base [String, nil] an optional base query string used when no predicates are added
  #
  # pkg:gem/redis#lib/redis/commands/modules/search/query.rb:30
  def initialize(base = T.unsafe(nil)); end

  # Add a built predicate to the current collection.
  #
  # @param predicate [Predicate] the predicate to add
  # @return [self]
  #
  # pkg:gem/redis#lib/redis/commands/modules/search/query.rb:398
  def add_predicate(predicate); end

  # Open an AND group: predicates added inside +block+ are joined with a space.
  #
  # @yield builds predicates that are combined with AND
  # @return [self]
  #
  # pkg:gem/redis#lib/redis/commands/modules/search/query.rb:390
  def and_(&block); end

  # Set the query +DIALECT+ version.
  #
  # @param dialect_version [Integer] the dialect version (defaults to 2)
  # @return [self]
  #
  # pkg:gem/redis#lib/redis/commands/modules/search/query.rb:304
  def dialect(dialect_version); end

  # Evaluate +block+ against this query (used to populate it via the DSL).
  #
  # @yield evaluated via +instance_eval+ against this query
  # @return [Object, nil] the block's return value, or nil when no block is given
  #
  # pkg:gem/redis#lib/redis/commands/modules/search/query.rb:473
  def evaluate(&block); end

  # Set the query +EXPANDER+ (custom query expander).
  #
  # @param expander_name [String] the expander name
  # @return [self]
  #
  # pkg:gem/redis#lib/redis/commands/modules/search/query.rb:189
  def expander(expander_name); end

  # pkg:gem/redis#lib/redis/commands/modules/search/query.rb:370
  def expander_value; end

  # Return an explanation of the score of each document (+EXPLAINSCORE+).
  #
  # @return [self]
  #
  # pkg:gem/redis#lib/redis/commands/modules/search/query.rb:312
  def explain_score; end

  # Add a numeric +FILTER+ clause.
  #
  # Bounds are validated so a malformed or untrusted value can't inject query syntax, the
  # same guarantee the numeric-predicate DSL gives. Beyond plain numbers, the RediSearch
  # bound forms +inf+/+-inf+ and the exclusive +(+ prefix (e.g. +"(10"+) are accepted.
  #
  # @param field [String] the numeric field name
  # @param min [Numeric, String] the lower bound (also used as upper bound when +max+ is nil)
  # @param max [Numeric, String, nil] the upper bound
  # @return [self]
  # @raise [ArgumentError] if a bound is neither numeric nor a valid RediSearch bound token
  #
  # pkg:gem/redis#lib/redis/commands/modules/search/query.rb:73
  def filter(field, min, max = T.unsafe(nil)); end

  # @return [Hash] the accumulated query options (dialect, limit, sortby, scorer, ...)
  # @return [Hash] map of return-field name => whether its value should be JSON-decoded
  # @return [Array<Array>] the +FILTER+ clauses as +[field, min, max]+ triples
  # @return [Array<Array>, nil] the +GEOFILTER+ clauses as +[field, lon, lat, radius, unit]+ tuples
  #
  # pkg:gem/redis#lib/redis/commands/modules/search/query.rb:23
  def filters; end

  # Add a +GEOFILTER+ clause restricting results to a radius around a point.
  #
  # @param field [String] the geo field name
  # @param lon [Numeric] the longitude of the center
  # @param lat [Numeric] the latitude of the center
  # @param radius [Numeric] the radius
  # @param unit [String] the radius unit ("m", "km", "mi", "ft")
  # @return [self]
  #
  # pkg:gem/redis#lib/redis/commands/modules/search/query.rb:87
  def geo_filter(field, lon, lat, radius, unit = T.unsafe(nil)); end

  # @return [Hash] the accumulated query options (dialect, limit, sortby, scorer, ...)
  # @return [Hash] map of return-field name => whether its value should be JSON-decoded
  # @return [Array<Array>] the +FILTER+ clauses as +[field, min, max]+ triples
  # @return [Array<Array>, nil] the +GEOFILTER+ clauses as +[field, lon, lat, radius, unit]+ tuples
  #
  # pkg:gem/redis#lib/redis/commands/modules/search/query.rb:23
  def geo_filters; end

  # Configure result +HIGHLIGHT+ing.
  #
  # @param fields [String, Array<String>, nil] the fields to highlight (all when nil)
  # @param tags [Array<String>] the opening and closing tags wrapped around matches
  # @return [self]
  #
  # pkg:gem/redis#lib/redis/commands/modules/search/query.rb:275
  def highlight(fields: T.unsafe(nil), tags: T.unsafe(nil)); end

  # @return [Array] the fields to RETURN
  # @return [Hash, nil] the HIGHLIGHT options
  # @return [Hash, nil] the SUMMARIZE options
  #
  # pkg:gem/redis#lib/redis/commands/modules/search/query.rb:27
  def highlight_options; end

  # @return [Array] the fields to RETURN
  # @return [Hash, nil] the HIGHLIGHT options
  # @return [Hash, nil] the SUMMARIZE options
  #
  # pkg:gem/redis#lib/redis/commands/modules/search/query.rb:27
  def highlight_options=(_arg0); end

  # Require query terms to appear in the same order as in the query (+INORDER+).
  #
  # @return [self]
  #
  # pkg:gem/redis#lib/redis/commands/modules/search/query.rb:239
  def in_order; end

  # pkg:gem/redis#lib/redis/commands/modules/search/query.rb:355
  def in_order_value; end

  # Set the query +LANGUAGE+ used for stemming.
  #
  # @param lang [String] the language name, e.g. "english"
  # @return [self]
  #
  # pkg:gem/redis#lib/redis/commands/modules/search/query.rb:172
  def language(lang); end

  # pkg:gem/redis#lib/redis/commands/modules/search/query.rb:325
  def language_value; end

  # Restrict the search to the given fields (+INFIELDS+).
  #
  # @param fields [Array<String>] the field names to search within
  # @return [self]
  #
  # pkg:gem/redis#lib/redis/commands/modules/search/query.rb:265
  def limit_fields(*fields); end

  # pkg:gem/redis#lib/redis/commands/modules/search/query.rb:365
  def limit_fields_value; end

  # Restrict the search to the given document ids (+INKEYS+).
  #
  # @param ids [Array<String>] the document ids to limit to
  # @return [self]
  #
  # pkg:gem/redis#lib/redis/commands/modules/search/query.rb:97
  def limit_ids(*ids); end

  # Internal getters used by Index#search to read accumulated state - unlike the
  # chainable setters above, these return the stored value rather than +self+.
  #
  # pkg:gem/redis#lib/redis/commands/modules/search/query.rb:320
  def limit_ids_value; end

  # Push a new predicate collection of +type+, evaluate the block against it, then fold it
  # back into the parent collection.
  #
  # @param type [Symbol] +:and+ or +:or+
  # @yield builds predicates inside the new collection
  # @return [self]
  #
  # pkg:gem/redis#lib/redis/commands/modules/search/query.rb:409
  def new_collection(type); end

  # Return only document ids, without their contents (+NOCONTENT+).
  #
  # @return [self]
  #
  # pkg:gem/redis#lib/redis/commands/modules/search/query.rb:256
  def no_content; end

  # pkg:gem/redis#lib/redis/commands/modules/search/query.rb:340
  def no_content_value; end

  # Do not filter out stopwords (+NOSTOPWORDS+).
  #
  # @return [self]
  #
  # pkg:gem/redis#lib/redis/commands/modules/search/query.rb:197
  def no_stopwords; end

  # pkg:gem/redis#lib/redis/commands/modules/search/query.rb:335
  def no_stopwords_value; end

  # Begin a numeric-field predicate bound to this query (call +.gt+/+.lt+/+.between+ on it).
  #
  # @param field [String] the numeric field name
  # @return [NumericField] a field bound to this query
  #
  # pkg:gem/redis#lib/redis/commands/modules/search/query.rb:438
  def numeric(field); end

  # @return [Hash] the accumulated query options (dialect, limit, sortby, scorer, ...)
  # @return [Hash] map of return-field name => whether its value should be JSON-decoded
  # @return [Array<Array>] the +FILTER+ clauses as +[field, min, max]+ triples
  # @return [Array<Array>, nil] the +GEOFILTER+ clauses as +[field, lon, lat, radius, unit]+ tuples
  #
  # pkg:gem/redis#lib/redis/commands/modules/search/query.rb:23
  def options; end

  # Open an OR group: predicates added inside +block+ are joined with +|+.
  #
  # @yield builds predicates that are combined with OR
  # @return [self]
  #
  # pkg:gem/redis#lib/redis/commands/modules/search/query.rb:382
  def or_(&block); end

  # Set the +LIMIT+ (paging) for the result set.
  #
  # @param offset [Integer] the index of the first result to return
  # @param limit [Integer] the maximum number of results to return
  # @return [self]
  #
  # pkg:gem/redis#lib/redis/commands/modules/search/query.rb:107
  def paging(offset, limit); end

  # Set the fields to +RETURN+, replacing any previously configured ones.
  #
  # @param fields [Array<String>] the field names to return
  # @return [self]
  #
  # pkg:gem/redis#lib/redis/commands/modules/search/query.rb:138
  def return(*fields); end

  # Append a single field to +RETURN+, optionally aliased and/or JSON-decoded.
  #
  # @param field [String] the field name to return
  # @param as_field [String, nil] an alias to expose the field under (+AS+)
  # @param decode_field [Boolean] whether the returned value should be JSON-decoded in results
  # @return [self]
  #
  # pkg:gem/redis#lib/redis/commands/modules/search/query.rb:152
  def return_field(field, as_field: T.unsafe(nil), decode_field: T.unsafe(nil)); end

  # @return [Array] the fields to RETURN
  # @return [Hash, nil] the HIGHLIGHT options
  # @return [Hash, nil] the SUMMARIZE options
  #
  # pkg:gem/redis#lib/redis/commands/modules/search/query.rb:27
  def return_fields; end

  # @return [Array] the fields to RETURN
  # @return [Hash, nil] the HIGHLIGHT options
  # @return [Hash, nil] the SUMMARIZE options
  #
  # pkg:gem/redis#lib/redis/commands/modules/search/query.rb:27
  def return_fields=(_arg0); end

  # @return [Hash] the accumulated query options (dialect, limit, sortby, scorer, ...)
  # @return [Hash] map of return-field name => whether its value should be JSON-decoded
  # @return [Array<Array>] the +FILTER+ clauses as +[field, min, max]+ triples
  # @return [Array<Array>, nil] the +GEOFILTER+ clauses as +[field, lon, lat, radius, unit]+ tuples
  #
  # pkg:gem/redis#lib/redis/commands/modules/search/query.rb:23
  def return_fields_decode; end

  # Set the scoring function (+SCORER+).
  #
  # @param scorer_name [String] the scorer name, e.g. "BM25"
  # @return [self]
  #
  # pkg:gem/redis#lib/redis/commands/modules/search/query.rb:214
  def scorer(scorer_name); end

  # Set the allowed +SLOP+ (number of intervening terms) for phrase matching.
  #
  # @param value [Integer] the slop value
  # @return [self]
  #
  # pkg:gem/redis#lib/redis/commands/modules/search/query.rb:231
  def slop(value); end

  # pkg:gem/redis#lib/redis/commands/modules/search/query.rb:350
  def slop_value; end

  # Set the +SORTBY+ field and direction.
  #
  # Supports both styles: a positional +order+ ("ASC"/"DESC" symbol or string) and the
  # +asc:+ keyword. When +order+ is given it takes precedence over +asc:+.
  #
  # @param field [String] the field to sort by
  # @param order [Symbol, String, nil] explicit order, e.g. +:asc+ or "DESC"
  # @param asc [Boolean] sort ascending when true, descending otherwise (used when +order+ is nil)
  # @return [self]
  #
  # pkg:gem/redis#lib/redis/commands/modules/search/query.rb:121
  def sort_by(field, order = T.unsafe(nil), asc: T.unsafe(nil)); end

  # Configure result +SUMMARIZE+ation (fragment extraction around matches).
  #
  # @param fields [String, Array<String>, nil] the fields to summarize (all when nil)
  # @param separator [String] the string placed between fragments
  # @param len [Integer] the number of words per fragment
  # @param frags [Integer] the number of fragments to extract
  # @return [self]
  #
  # pkg:gem/redis#lib/redis/commands/modules/search/query.rb:290
  def summarize(fields: T.unsafe(nil), separator: T.unsafe(nil), len: T.unsafe(nil), frags: T.unsafe(nil)); end

  # @return [Array] the fields to RETURN
  # @return [Hash, nil] the HIGHLIGHT options
  # @return [Hash, nil] the SUMMARIZE options
  #
  # pkg:gem/redis#lib/redis/commands/modules/search/query.rb:27
  def summarize_options; end

  # @return [Array] the fields to RETURN
  # @return [Hash, nil] the HIGHLIGHT options
  # @return [Hash, nil] the SUMMARIZE options
  #
  # pkg:gem/redis#lib/redis/commands/modules/search/query.rb:27
  def summarize_options=(_arg0); end

  # Begin a tag-field predicate bound to this query (call +.eq+ on the result).
  #
  # @param field [String] the tag field name
  # @return [TagField] a field bound to this query
  #
  # pkg:gem/redis#lib/redis/commands/modules/search/query.rb:422
  def tag(field); end

  # Begin a text-field predicate bound to this query (call +.match+ on the result).
  #
  # @param field [String] the text field name
  # @return [TextField] a field bound to this query
  #
  # pkg:gem/redis#lib/redis/commands/modules/search/query.rb:430
  def text(field); end

  # Set the query +TIMEOUT+.
  #
  # @param milliseconds [Integer] the timeout in milliseconds
  # @return [self]
  #
  # pkg:gem/redis#lib/redis/commands/modules/search/query.rb:248
  def timeout(milliseconds); end

  # pkg:gem/redis#lib/redis/commands/modules/search/query.rb:360
  def timeout_value; end

  # Render the query and all configured options into the +FT.SEARCH+ argument array.
  #
  # @return [Array] the argument array whose first element is the query string and whose
  #   remaining elements are option tokens
  #
  # pkg:gem/redis#lib/redis/commands/modules/search/query.rb:446
  def to_redis_args; end

  # Disable stemming for the query (+VERBATIM+).
  #
  # @return [self]
  #
  # pkg:gem/redis#lib/redis/commands/modules/search/query.rb:180
  def verbatim; end

  # pkg:gem/redis#lib/redis/commands/modules/search/query.rb:330
  def verbatim_value; end

  # Return the payload attached to each document (+WITHPAYLOADS+).
  #
  # @return [self]
  #
  # pkg:gem/redis#lib/redis/commands/modules/search/query.rb:222
  def with_payloads; end

  # pkg:gem/redis#lib/redis/commands/modules/search/query.rb:345
  def with_payloads_value; end

  # Return the relevance score of each document (+WITHSCORES+).
  #
  # @return [self]
  #
  # pkg:gem/redis#lib/redis/commands/modules/search/query.rb:205
  def with_scores; end

  private

  # pkg:gem/redis#lib/redis/commands/modules/search/query.rb:489
  def append_boolean_options(args); end

  # pkg:gem/redis#lib/redis/commands/modules/search/query.rb:606
  def append_dialect(args); end

  # pkg:gem/redis#lib/redis/commands/modules/search/query.rb:586
  def append_expander(args); end

  # pkg:gem/redis#lib/redis/commands/modules/search/query.rb:520
  def append_filters(args); end

  # pkg:gem/redis#lib/redis/commands/modules/search/query.rb:540
  def append_geo_filters(args); end

  # pkg:gem/redis#lib/redis/commands/modules/search/query.rb:564
  def append_highlight_options(args); end

  # pkg:gem/redis#lib/redis/commands/modules/search/query.rb:590
  def append_in_order(args); end

  # pkg:gem/redis#lib/redis/commands/modules/search/query.rb:582
  def append_language(args); end

  # pkg:gem/redis#lib/redis/commands/modules/search/query.rb:600
  def append_limit(args); end

  # pkg:gem/redis#lib/redis/commands/modules/search/query.rb:508
  def append_limit_fields(args); end

  # pkg:gem/redis#lib/redis/commands/modules/search/query.rb:514
  def append_limit_ids(args); end

  # pkg:gem/redis#lib/redis/commands/modules/search/query.rb:546
  def append_return_fields(args); end

  # pkg:gem/redis#lib/redis/commands/modules/search/query.rb:496
  def append_scorer(args); end

  # pkg:gem/redis#lib/redis/commands/modules/search/query.rb:574
  def append_slop(args); end

  # pkg:gem/redis#lib/redis/commands/modules/search/query.rb:594
  def append_sort_by(args); end

  # pkg:gem/redis#lib/redis/commands/modules/search/query.rb:552
  def append_summarize_options(args); end

  # pkg:gem/redis#lib/redis/commands/modules/search/query.rb:578
  def append_timeout(args); end

  # pkg:gem/redis#lib/redis/commands/modules/search/query.rb:500
  def append_with_scores(args); end

  # Validate a FILTER bound. Numeric values pass through; strings must be a valid RediSearch
  # numeric bound — an optional exclusive "(" prefix followed by a number or +inf/-inf.
  # Anything else (e.g. injected query syntax) raises, matching the guarded predicate DSL.
  #
  # pkg:gem/redis#lib/redis/commands/modules/search/query.rb:529
  def coerce_filter_bound(value); end

  # pkg:gem/redis#lib/redis/commands/modules/search/query.rb:481
  def query_string; end

  class << self
    # Build a Query by evaluating +block+ in the context of a fresh instance.
    #
    # @example
    #   Redis::Commands::Search::Query.build { paging(0, 5); sort_by("name") }
    #
    # @yield evaluated via +instance_eval+ against the new Query
    # @return [Query] the populated query
    #
    # pkg:gem/redis#lib/redis/commands/modules/search/query.rb:56
    def build(&block); end
  end
end

# A numeric-range predicate rendering +(@field:[min max])+.
#
# pkg:gem/redis#lib/redis/commands/modules/search/query.rb:694
class Redis::Commands::Search::RangePredicate < ::Redis::Commands::Search::Predicate
  # @param field [String] the numeric field name
  # @param min [Numeric, String] the lower bound
  # @param max [Numeric, String] the upper bound
  #
  # pkg:gem/redis#lib/redis/commands/modules/search/query.rb:698
  def initialize(field, min, max); end

  # @return [String] the query-string fragment, e.g. +(@price:[10 20])+
  #
  # pkg:gem/redis#lib/redis/commands/modules/search/query.rb:705
  def to_s; end
end

# Factory for the +REDUCE+ functions used inside {AggregateRequest#group_by}.
#
# Each class method returns a +Reducers+ instance carrying the function name, its
# arguments, and an optional result alias.
#
# @example
#   Redis::Commands::Search::Reducers.sum("@price", alias_name: "total")
#
# pkg:gem/redis#lib/redis/commands/modules/search/aggregation.rb:193
class Redis::Commands::Search::Reducers
  # @param name [String] the reducer function name
  # @param args [Array] the reducer arguments
  # @param alias_name [String, nil] the result alias
  #
  # pkg:gem/redis#lib/redis/commands/modules/search/aggregation.rb:379
  def initialize(name, *args, alias_name: T.unsafe(nil)); end

  # @return [String] the reducer function name
  # @return [Array] the reducer arguments
  # @return [String, nil] the result alias
  #
  # pkg:gem/redis#lib/redis/commands/modules/search/aggregation.rb:374
  def alias_name; end

  # @return [String] the reducer function name
  # @return [Array] the reducer arguments
  # @return [String, nil] the result alias
  #
  # pkg:gem/redis#lib/redis/commands/modules/search/aggregation.rb:374
  def args; end

  # Set the result alias (+AS+) for this reducer.
  #
  # @param alias_name [String] the result alias
  # @return [self]
  #
  # pkg:gem/redis#lib/redis/commands/modules/search/aggregation.rb:389
  def as(alias_name); end

  # @return [String] the reducer function name
  # @return [Array] the reducer arguments
  # @return [String, nil] the result alias
  #
  # pkg:gem/redis#lib/redis/commands/modules/search/aggregation.rb:374
  def name; end

  class << self
    # Build an +AVG+ reducer.
    #
    # @param property [String] the property to average
    # @param alias_name [String, nil] the result alias
    # @return [Reducers]
    #
    # pkg:gem/redis#lib/redis/commands/modules/search/aggregation.rb:252
    def avg(property, alias_name: T.unsafe(nil)); end

    # Build a +COLLECT+ reducer, which gathers each group's rows, projects a chosen set of
    # fields, optionally deduplicates, sorts and limits them, and emits them as an array of
    # per-entry maps under the reducer alias.
    #
    # Field and sort-key names must carry an +@+ prefix on the wire (like the other reducers,
    # the caller supplies it); output map keys are the same names with the +@+ stripped.
    #
    # @example top 5 per group by rating
    #   Reducers.collect(
    #     fields: ["@title", "@rating"],
    #     sort_by: [Desc.new("@rating")],
    #     limit: [0, 5],
    #     alias_name: "top"
    #   )
    #
    # @param fields [Symbol, Array<String>] +:all+ emits +FIELDS *+ (projects the fields the
    #   pipeline has materialized at this stage — not a whole-document fetch); an Array emits
    #   +FIELDS <count> <@field> ...+
    # @param distinct [Boolean] emit +DISTINCT+ to deduplicate entries. NOTE: not yet
    #   implemented server-side; sending it currently fails parsing. Kept for forward
    #   compatibility — do not rely on it until the server ships it.
    # @param sort_by [Array<String, Asc, Desc>, nil] sort keys; a plain String sorts ascending
    #   (the default), an +Asc+/+Desc+ wrapper sets the direction explicitly. NOTE: +SORTBY+
    #   without +limit+ returns at most 10 entries per group (the server default).
    # @param limit [Array(Integer, Integer), nil] a +[offset, count]+ pair emitting
    #   +LIMIT <offset> <count>+; with +sort_by+ this is a bounded top-N selection
    # @param alias_name [String, nil] the reducer output column name (+AS+)
    # @return [Reducers]
    # @raise [ArgumentError] if +fields+ is an empty list and not +:all+
    #
    # pkg:gem/redis#lib/redis/commands/modules/search/aggregation.rb:339
    def collect(fields:, distinct: T.unsafe(nil), sort_by: T.unsafe(nil), limit: T.unsafe(nil), alias_name: T.unsafe(nil)); end

    # Build a +COUNT+ reducer.
    #
    # @param alias_name [String, nil] the result alias
    # @return [Reducers]
    #
    # pkg:gem/redis#lib/redis/commands/modules/search/aggregation.rb:198
    def count(alias_name: T.unsafe(nil)); end

    # Build a +COUNT_DISTINCT+ reducer.
    #
    # @param property [String] the property to count distinct values of
    # @param alias_name [String, nil] the result alias
    # @return [Reducers]
    #
    # pkg:gem/redis#lib/redis/commands/modules/search/aggregation.rb:207
    def count_distinct(property, alias_name: T.unsafe(nil)); end

    # Build a +COUNT_DISTINCTISH+ (approximate distinct count) reducer.
    #
    # @param property [String] the property to count distinct values of
    # @param alias_name [String, nil] the result alias
    # @return [Reducers]
    #
    # pkg:gem/redis#lib/redis/commands/modules/search/aggregation.rb:216
    def count_distinctish(property, alias_name: T.unsafe(nil)); end

    # Build a +FIRST_VALUE+ reducer, optionally ordered by another property.
    #
    # @param property [String] the property whose first value is taken
    # @param alias_name [String, nil] the result alias
    # @param sort_by [String, nil] the property to order by before taking the first value
    # @param sort_order [Symbol, String, nil] the sort direction ("ASC"/"DESC", default "ASC")
    # @return [Reducers]
    #
    # pkg:gem/redis#lib/redis/commands/modules/search/aggregation.rb:291
    def first_value(property, alias_name: T.unsafe(nil), sort_by: T.unsafe(nil), sort_order: T.unsafe(nil)); end

    # Build a +MAX+ reducer.
    #
    # @param property [String] the property to take the maximum of
    # @param alias_name [String, nil] the result alias
    # @return [Reducers]
    #
    # pkg:gem/redis#lib/redis/commands/modules/search/aggregation.rb:243
    def max(property, alias_name: T.unsafe(nil)); end

    # Build a +MIN+ reducer.
    #
    # @param property [String] the property to take the minimum of
    # @param alias_name [String, nil] the result alias
    # @return [Reducers]
    #
    # pkg:gem/redis#lib/redis/commands/modules/search/aggregation.rb:234
    def min(property, alias_name: T.unsafe(nil)); end

    # Build a +QUANTILE+ reducer.
    #
    # @param property [String] the property to compute the quantile of
    # @param quantile [Float] the quantile in the range 0..1
    # @param alias_name [String, nil] the result alias
    # @return [Reducers]
    #
    # pkg:gem/redis#lib/redis/commands/modules/search/aggregation.rb:271
    def quantile(property, quantile, alias_name: T.unsafe(nil)); end

    # Build a +RANDOM_SAMPLE+ reducer.
    #
    # @param property [String] the property to sample
    # @param sample_size [Integer] the number of values to sample
    # @param alias_name [String, nil] the result alias
    # @return [Reducers]
    #
    # pkg:gem/redis#lib/redis/commands/modules/search/aggregation.rb:306
    def random_sample(property, sample_size, alias_name: T.unsafe(nil)); end

    # Build a +STDDEV+ (standard deviation) reducer.
    #
    # @param property [String] the property to compute the standard deviation of
    # @param alias_name [String, nil] the result alias
    # @return [Reducers]
    #
    # pkg:gem/redis#lib/redis/commands/modules/search/aggregation.rb:261
    def stddev(property, alias_name: T.unsafe(nil)); end

    # Build a +SUM+ reducer.
    #
    # @param property [String] the property to sum
    # @param alias_name [String, nil] the result alias
    # @return [Reducers]
    #
    # pkg:gem/redis#lib/redis/commands/modules/search/aggregation.rb:225
    def sum(property, alias_name: T.unsafe(nil)); end

    # Build a +TOLIST+ reducer (collects distinct values into a list).
    #
    # @param property [String] the property to collect
    # @param alias_name [String, nil] the result alias
    # @return [Reducers]
    #
    # pkg:gem/redis#lib/redis/commands/modules/search/aggregation.rb:280
    def tolist(property, alias_name: T.unsafe(nil)); end

    private

    # Render the +FIELDS+ clause tokens for {collect}.
    #
    # pkg:gem/redis#lib/redis/commands/modules/search/aggregation.rb:349
    def collect_fields_tokens(fields); end

    # Render the optional +SORTBY+ clause tokens for {collect}. Each Asc/Desc wrapper emits a
    # name and its direction (2 tokens); a plain String emits just the name (ASC is implicit).
    #
    # pkg:gem/redis#lib/redis/commands/modules/search/aggregation.rb:361
    def collect_sortby_tokens(sort_by); end
  end
end

# Reply reshaping for the Query Engine.
#
# Every parser normalises *both* RESP2 (flat arrays) and RESP3 (native maps) replies to
# the same Ruby objects, so the public API is stable regardless of the protocol the
# underlying connection negotiates. RESP3 is the default protocol; the RESP2 branches exist
# for +protocol: 2+ connections.
#
# pkg:gem/redis#lib/redis/commands/modules/search/result.rb:224
module Redis::Commands::Search::ResultParser
  private

  # FT.AGGREGATE / FT.CURSOR READ -> AggregateResult
  #
  # Without a cursor the reply is [num_rows, row, row, ...] (RESP2) or a map with
  # "results" (RESP3). With WITHCURSOR the reply is [aggregate_reply, cursor_id].
  #
  # @param reply [Array, Hash] the FT.AGGREGATE / FT.CURSOR READ reply
  # @return [AggregateResult, nil] the parsed result (nil when +reply+ is nil)
  #
  # pkg:gem/redis#lib/redis/commands/modules/search/result.rb:308
  def aggregate(reply); end

  # FT.CONFIG GET -> Hash. RESP2 returns nested [[option, value], ...] pairs; RESP3 a map.
  #
  # @param reply [Array, Hash] the FT.CONFIG GET reply
  # @return [Hash, nil] option => value (nil when +reply+ is nil)
  #
  # pkg:gem/redis#lib/redis/commands/modules/search/result.rb:394
  def config_get(reply); end

  # JSON-decode a value, returning it unchanged when it is not a parseable JSON String.
  #
  # @param value [Object] the value to decode
  # @return [Object] the parsed value, or +value+ when it is not a String or fails to parse
  #
  # pkg:gem/redis#lib/redis/commands/modules/search/result.rb:478
  def decode_value(value); end

  # pkg:gem/redis#lib/redis/commands/modules/search/result.rb:461
  def hashify_fields(fields, decode_fields); end

  # FT.INFO / FT.CONFIG GET -> Hash. RESP2 returns a flat [k, v, ...] array; RESP3
  # already returns a native map.
  #
  # @param reply [Array, Hash] the FT.INFO reply
  # @return [Hash, nil] the info as a hash (nil when +reply+ is nil)
  #
  # pkg:gem/redis#lib/redis/commands/modules/search/result.rb:383
  def hashify_info(reply); end

  # FT.HYBRID -> HybridResult
  #
  # The reply is a native map under RESP3 and a flat [k, v, ...] array under RESP2. A
  # WITHCURSOR reply carries per-leg cursor ids ("SEARCH"/"VSIM") instead of a result page.
  #
  # @param reply [Array, Hash] the FT.HYBRID reply
  # @return [HybridResult, nil] the parsed result (nil when +reply+ is nil)
  #
  # pkg:gem/redis#lib/redis/commands/modules/search/result.rb:356
  def hybrid(reply); end

  # A COLLECT reducer column is an array of entry-maps: +Array<Hash>+ under RESP3 but
  # +Array<[k, v, ...]>+ (flat key/value arrays) under RESP2. Normalize both to
  # +Array<Hash>+ so callers see a uniform type regardless of protocol. Scalar values and
  # arrays of scalars (e.g. TOLIST) are left untouched, and the RESP3 case is idempotent.
  #
  # @param row [Hash] an already-hashified aggregate row
  # @return [Hash] the row with any array-of-entries column reshaped to +Array<Hash>+
  #
  # pkg:gem/redis#lib/redis/commands/modules/search/result.rb:338
  def normalize_aggregate_row(row); end

  # Turn a flat [field, value, ...] array (RESP2) or a native map (RESP3) of returned
  # fields into a hash, JSON-decoding values whose field is flagged in +decode_fields+.
  #
  # @param fields [Array, Hash, nil] the field/value pairs
  # @param decode_fields [Hash] field name => whether to JSON-decode its value
  # @return [Hash{String => Object}] the fields as a hash (empty when +fields+ is nil)
  # Normalize a WITHSCORES value to a Float so Document#score is the same type regardless of
  # protocol (RESP2 returns the score as a bulk string, RESP3 as a native double). With
  # EXPLAINSCORE the RESP2 value is +[score, explanation]+; coerce the score part and keep
  # the explanation. Anything non-numeric is returned untouched.
  #
  # pkg:gem/redis#lib/redis/commands/modules/search/result.rb:451
  def normalize_score(score); end

  # FT.SEARCH -> SearchResult
  #
  # @param reply [Array, Hash] RESP2 flat array or RESP3 map
  # @param with_scores [Boolean] WITHSCORES was set (RESP2 only; RESP3 carries it inline)
  # @param with_payloads [Boolean] WITHPAYLOADS was set (RESP2 only)
  # @param no_content [Boolean] NOCONTENT was set
  # @param decode_fields [Hash] field name => whether to JSON-decode its value
  # @return [SearchResult, nil] the parsed result (nil when +reply+ is nil)
  #
  # pkg:gem/redis#lib/redis/commands/modules/search/result.rb:235
  def search(reply, with_scores: T.unsafe(nil), with_payloads: T.unsafe(nil), no_content: T.unsafe(nil), decode_fields: T.unsafe(nil)); end

  # Parse a RESP2 flat-array FT.SEARCH reply into a {SearchResult}.
  #
  # @param reply [Array] the flat +[total, id, ..., fields, ...]+ array
  # @param with_scores [Boolean] WITHSCORES was set
  # @param with_payloads [Boolean] WITHPAYLOADS was set
  # @param no_content [Boolean] NOCONTENT was set
  # @param decode_fields [Hash] field name => whether to JSON-decode its value
  # @return [SearchResult]
  #
  # pkg:gem/redis#lib/redis/commands/modules/search/result.rb:253
  def search_resp2(reply, with_scores, with_payloads, no_content, decode_fields); end

  # Parse a RESP3 map FT.SEARCH reply into a {SearchResult}.
  #
  # @param reply [Hash] the native map carrying +"results"+ and +"total_results"+
  # @param decode_fields [Hash] field name => whether to JSON-decode its value
  # @return [SearchResult]
  #
  # pkg:gem/redis#lib/redis/commands/modules/search/result.rb:291
  def search_resp3(reply, decode_fields); end

  # FT.SPELLCHECK -> { term => [{ "suggestion" => ..., "score" => ... }, ...] }
  #
  # @param reply [Array, Hash] the FT.SPELLCHECK reply
  # @return [Hash{String => Array<Hash>}, nil] term => suggestions (nil when +reply+ is nil)
  #
  # pkg:gem/redis#lib/redis/commands/modules/search/result.rb:416
  def spellcheck(reply); end

  # FT.SYNDUMP -> { term => [group_id, ...] }. RESP2 is a flat [term, [ids], ...] array.
  #
  # @param reply [Array, Hash] the FT.SYNDUMP reply
  # @return [Hash{String => Array}, nil] term => group ids (nil when +reply+ is nil)
  #
  # pkg:gem/redis#lib/redis/commands/modules/search/result.rb:405
  def syndump(reply); end

  class << self
    # FT.AGGREGATE / FT.CURSOR READ -> AggregateResult
    #
    # Without a cursor the reply is [num_rows, row, row, ...] (RESP2) or a map with
    # "results" (RESP3). With WITHCURSOR the reply is [aggregate_reply, cursor_id].
    #
    # @param reply [Array, Hash] the FT.AGGREGATE / FT.CURSOR READ reply
    # @return [AggregateResult, nil] the parsed result (nil when +reply+ is nil)
    #
    # pkg:gem/redis#lib/redis/commands/modules/search/result.rb:308
    def aggregate(reply); end

    # FT.CONFIG GET -> Hash. RESP2 returns nested [[option, value], ...] pairs; RESP3 a map.
    #
    # @param reply [Array, Hash] the FT.CONFIG GET reply
    # @return [Hash, nil] option => value (nil when +reply+ is nil)
    #
    # pkg:gem/redis#lib/redis/commands/modules/search/result.rb:394
    def config_get(reply); end

    # JSON-decode a value, returning it unchanged when it is not a parseable JSON String.
    #
    # @param value [Object] the value to decode
    # @return [Object] the parsed value, or +value+ when it is not a String or fails to parse
    #
    # pkg:gem/redis#lib/redis/commands/modules/search/result.rb:478
    def decode_value(value); end

    # pkg:gem/redis#lib/redis/commands/modules/search/result.rb:461
    def hashify_fields(fields, decode_fields); end

    # FT.INFO / FT.CONFIG GET -> Hash. RESP2 returns a flat [k, v, ...] array; RESP3
    # already returns a native map.
    #
    # @param reply [Array, Hash] the FT.INFO reply
    # @return [Hash, nil] the info as a hash (nil when +reply+ is nil)
    #
    # pkg:gem/redis#lib/redis/commands/modules/search/result.rb:383
    def hashify_info(reply); end

    # FT.HYBRID -> HybridResult
    #
    # The reply is a native map under RESP3 and a flat [k, v, ...] array under RESP2. A
    # WITHCURSOR reply carries per-leg cursor ids ("SEARCH"/"VSIM") instead of a result page.
    #
    # @param reply [Array, Hash] the FT.HYBRID reply
    # @return [HybridResult, nil] the parsed result (nil when +reply+ is nil)
    #
    # pkg:gem/redis#lib/redis/commands/modules/search/result.rb:356
    def hybrid(reply); end

    # A COLLECT reducer column is an array of entry-maps: +Array<Hash>+ under RESP3 but
    # +Array<[k, v, ...]>+ (flat key/value arrays) under RESP2. Normalize both to
    # +Array<Hash>+ so callers see a uniform type regardless of protocol. Scalar values and
    # arrays of scalars (e.g. TOLIST) are left untouched, and the RESP3 case is idempotent.
    #
    # @param row [Hash] an already-hashified aggregate row
    # @return [Hash] the row with any array-of-entries column reshaped to +Array<Hash>+
    #
    # pkg:gem/redis#lib/redis/commands/modules/search/result.rb:338
    def normalize_aggregate_row(row); end

    # Turn a flat [field, value, ...] array (RESP2) or a native map (RESP3) of returned
    # fields into a hash, JSON-decoding values whose field is flagged in +decode_fields+.
    #
    # @param fields [Array, Hash, nil] the field/value pairs
    # @param decode_fields [Hash] field name => whether to JSON-decode its value
    # @return [Hash{String => Object}] the fields as a hash (empty when +fields+ is nil)
    # Normalize a WITHSCORES value to a Float so Document#score is the same type regardless of
    # protocol (RESP2 returns the score as a bulk string, RESP3 as a native double). With
    # EXPLAINSCORE the RESP2 value is +[score, explanation]+; coerce the score part and keep
    # the explanation. Anything non-numeric is returned untouched.
    #
    # pkg:gem/redis#lib/redis/commands/modules/search/result.rb:451
    def normalize_score(score); end

    # FT.SEARCH -> SearchResult
    #
    # @param reply [Array, Hash] RESP2 flat array or RESP3 map
    # @param with_scores [Boolean] WITHSCORES was set (RESP2 only; RESP3 carries it inline)
    # @param with_payloads [Boolean] WITHPAYLOADS was set (RESP2 only)
    # @param no_content [Boolean] NOCONTENT was set
    # @param decode_fields [Hash] field name => whether to JSON-decode its value
    # @return [SearchResult, nil] the parsed result (nil when +reply+ is nil)
    #
    # pkg:gem/redis#lib/redis/commands/modules/search/result.rb:235
    def search(reply, with_scores: T.unsafe(nil), with_payloads: T.unsafe(nil), no_content: T.unsafe(nil), decode_fields: T.unsafe(nil)); end

    # Parse a RESP2 flat-array FT.SEARCH reply into a {SearchResult}.
    #
    # @param reply [Array] the flat +[total, id, ..., fields, ...]+ array
    # @param with_scores [Boolean] WITHSCORES was set
    # @param with_payloads [Boolean] WITHPAYLOADS was set
    # @param no_content [Boolean] NOCONTENT was set
    # @param decode_fields [Hash] field name => whether to JSON-decode its value
    # @return [SearchResult]
    #
    # pkg:gem/redis#lib/redis/commands/modules/search/result.rb:253
    def search_resp2(reply, with_scores, with_payloads, no_content, decode_fields); end

    # Parse a RESP3 map FT.SEARCH reply into a {SearchResult}.
    #
    # @param reply [Hash] the native map carrying +"results"+ and +"total_results"+
    # @param decode_fields [Hash] field name => whether to JSON-decode its value
    # @return [SearchResult]
    #
    # pkg:gem/redis#lib/redis/commands/modules/search/result.rb:291
    def search_resp3(reply, decode_fields); end

    # FT.SPELLCHECK -> { term => [{ "suggestion" => ..., "score" => ... }, ...] }
    #
    # @param reply [Array, Hash] the FT.SPELLCHECK reply
    # @return [Hash{String => Array<Hash>}, nil] term => suggestions (nil when +reply+ is nil)
    #
    # pkg:gem/redis#lib/redis/commands/modules/search/result.rb:416
    def spellcheck(reply); end

    # FT.SYNDUMP -> { term => [group_id, ...] }. RESP2 is a flat [term, [ids], ...] array.
    #
    # @param reply [Array, Hash] the FT.SYNDUMP reply
    # @return [Hash{String => Array}, nil] term => group ids (nil when +reply+ is nil)
    #
    # pkg:gem/redis#lib/redis/commands/modules/search/result.rb:405
    def syndump(reply); end
  end
end

# A Redis Query Engine index schema: an ordered collection of {Field}
# objects rendered into the +SCHEMA+ section of an +FT.CREATE+ call.
#
# pkg:gem/redis#lib/redis/commands/modules/search/schema.rb:8
class Redis::Commands::Search::Schema
  include ::Enumerable

  # Build a schema from a list of fields.
  #
  # @param [Array<Field>] fields the fields that make up the schema
  #
  # pkg:gem/redis#lib/redis/commands/modules/search/schema.rb:16
  def initialize(fields = T.unsafe(nil)); end

  # Iterate over the schema's fields.
  #
  # @yieldparam [Field] field each field in order
  # @return [Enumerator, Array<Field>] the fields when no block is given
  #
  # pkg:gem/redis#lib/redis/commands/modules/search/schema.rb:34
  def each(&block); end

  # Find a field by its name/path or its +AS+ alias, so e.g. a JSON field declared as
  # "$.price" AS "price" is found by either "$.price" or "price".
  #
  # @param [String, Symbol] name the field name/path or alias to look up
  # @return [Field, nil] the matching field, or +nil+ if none matches
  #
  # pkg:gem/redis#lib/redis/commands/modules/search/schema.rb:25
  def field(name); end

  # pkg:gem/redis#lib/redis/commands/modules/search/schema.rb:11
  def fields; end

  # Render the schema as the array of +FT.CREATE+ tokens.
  #
  # @example
  #   schema.to_args # => ["SCHEMA", "title", "TEXT", "SORTABLE"]
  #
  # @return [Array] the +SCHEMA+ keyword followed by each field's tokens
  #
  # pkg:gem/redis#lib/redis/commands/modules/search/schema.rb:44
  def to_args; end

  class << self
    # Build a schema using the block DSL evaluated in a {SchemaDefinition}.
    #
    # @example
    #   Redis::Commands::Search::Schema.build do
    #     text_field "title", weight: 5.0, sortable: true
    #     numeric_field "price"
    #   end
    #
    # @return [Schema] the schema built from the block
    # @raise [Redis::CommandError] if a field is given invalid options
    #
    # pkg:gem/redis#lib/redis/commands/modules/search/schema.rb:58
    def build(&block); end
  end
end

# The block DSL used by {Schema.build} to declare fields. Each helper
# appends a {Field} subclass to {#fields}.
#
# pkg:gem/redis#lib/redis/commands/modules/search/schema.rb:71
class Redis::Commands::Search::SchemaDefinition
  # pkg:gem/redis#lib/redis/commands/modules/search/schema.rb:74
  def initialize; end

  # pkg:gem/redis#lib/redis/commands/modules/search/schema.rb:72
  def fields; end

  # Add a {GeoField} to the schema.
  #
  # @param [String, Symbol] name the document attribute the field indexes
  # @return [Array<Field>] the updated field list
  #
  # pkg:gem/redis#lib/redis/commands/modules/search/schema.rb:136
  def geo_field(name, **options); end

  # Add a {GeoShapeField} to the schema.
  #
  # @param [String, Symbol] name the document attribute the field indexes
  # @param [String, nil] coord_system the coordinate system, +FLAT+ or +SPHERICAL+;
  #   nil (the default) omits the token so the server default (+SPHERICAL+) applies
  # @return [Array<Field>] the updated field list
  #
  # pkg:gem/redis#lib/redis/commands/modules/search/schema.rb:146
  def geoshape_field(name, coord_system = T.unsafe(nil), **options); end

  # Add a {NumericField} to the schema.
  #
  # @param [String, Symbol] name the document attribute the field indexes
  # @return [Array<Field>] the updated field list
  #
  # pkg:gem/redis#lib/redis/commands/modules/search/schema.rb:105
  def numeric_field(name, **options); end

  # Add a {TagField} to the schema.
  #
  # @param [String, Symbol] name the document attribute the field indexes
  # @option options [Boolean] :sortable allow sorting by the field
  # @option options [Boolean] :no_index do not index the field
  # @option options [String] :as an alias for the field
  # @option options [String] :separator the tag separator character
  # @option options [Boolean] :case_sensitive keep tag casing
  # @option options [Boolean] :index_empty index empty values
  # @option options [Boolean] :index_missing index documents missing the field
  # @option options [Boolean] :withsuffixtrie build a suffix trie
  # @return [Array<Field>] the updated field list
  # @raise [ArgumentError] if an unknown option key is given
  #
  # pkg:gem/redis#lib/redis/commands/modules/search/schema.rb:122
  def tag_field(name, **options); end

  # Add a {TextField} to the schema.
  #
  # @param [String, Symbol] name the document attribute the field indexes
  # @option options [Numeric] :weight the field's scoring weight
  # @option options [Boolean] :sortable allow sorting by the field
  # @option options [Boolean] :no_index do not index the field
  # @option options [String] :as an alias for the field
  # @option options [String] :phonetic phonetic matcher
  # @option options [Boolean] :no_stem disable stemming
  # @option options [Boolean] :index_empty index empty values
  # @option options [Boolean] :withsuffixtrie build a suffix trie
  # @return [Array<Field>] the updated field list
  # @raise [ArgumentError] if an unknown option key is given
  #
  # pkg:gem/redis#lib/redis/commands/modules/search/schema.rb:91
  def text_field(name, **options); end

  # Add a {VectorField} to the schema.
  #
  # Field-level options (+:as+, +:sortable+, +:no_index+) are extracted from
  # +attributes+; the remaining keys (e.g. +type:+, +dim:+, +distance_metric:+)
  # become vector attributes. An optional block is evaluated in a
  # {VectorFieldDefinition} for declaring attributes.
  #
  # @example
  #   vector_field "embedding", "HNSW", type: "FLOAT32", dim: 4, distance_metric: "L2"
  #
  # @param [String, Symbol] name the document attribute the field indexes
  # @param [String, Symbol] algorithm the indexing method (+FLAT+, +HNSW+, +SVS-VAMANA+)
  # @param [Hash] attributes vector attributes and field-level options
  # @yield an optional block evaluated in a {VectorFieldDefinition}
  # @return [Array<Field>] the updated field list
  #
  # pkg:gem/redis#lib/redis/commands/modules/search/schema.rb:165
  def vector_field(name, algorithm, **attributes, &block); end
end

# Result of FT.SEARCH: the total number of matching documents (which may exceed the
# number returned because of paging) plus the documents on this page.
#
# pkg:gem/redis#lib/redis/commands/modules/search/result.rb:71
class Redis::Commands::Search::SearchResult
  include ::Enumerable

  # @param total [Integer] the total number of matching documents
  # @param documents [Array<Document>] the documents on this page
  # @param warnings [Array<String>] any warnings returned by the server
  #
  # pkg:gem/redis#lib/redis/commands/modules/search/result.rb:85
  def initialize(total, documents, warnings: T.unsafe(nil)); end

  # @param index [Integer] the position within this page
  # @return [Document, nil] the document at +index+, or nil when out of range
  #
  # pkg:gem/redis#lib/redis/commands/modules/search/result.rb:101
  def [](index); end

  # @return [Integer] the total number of matching documents (may exceed +documents.size+
  #   because of paging)
  # @return [Array<Document>] the documents on this page
  # @return [Array<String>] any warnings returned by the server (e.g. a query timeout under
  #   the +return+ policy); only the RESP3 wire carries warnings on FT.SEARCH, so this is
  #   always empty on RESP2 connections
  #
