  def empty?; end

  # pkg:gem/redis#lib/redis/commands/modules/search/result.rb:109
  def length; end

  # @return [Integer] the number of documents on this page
  #
  # pkg:gem/redis#lib/redis/commands/modules/search/result.rb:106
  def size; end

  # @return [Integer] the total number of matching documents (may exceed +documents.size+
  #   because of paging)
