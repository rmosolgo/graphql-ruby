  # @param [String] key
  # @param [Integer] db
  # @return [Boolean] whether the key was moved or not
  #
  # pkg:gem/redis#lib/redis/commands/keys.rb:323
  def move(key, db); end

  # pkg:gem/redis#lib/redis/commands/keys.rb:360
  def object(*args); end

  # Remove the expiration from a key.
