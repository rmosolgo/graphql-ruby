# Result of FT.HYBRID: the fused result rows (each a field => value hash, including the
# synthetic +"__key"+ and +"__score"+) plus the total, any warnings and the execution time.
#
# When the query used WITHCURSOR the server returns per-leg cursor ids instead of an inline
# page; those are exposed via {#search_cursor} / {#vsim_cursor} and {#cursor?} is true.
#
# pkg:gem/redis#lib/redis/commands/modules/search/result.rb:166
class Redis::Commands::Search::HybridResult
  include ::Enumerable

  # pkg:gem/redis#lib/redis/commands/modules/search/result.rb:177
  def initialize(rows: T.unsafe(nil), total: T.unsafe(nil), warnings: T.unsafe(nil), execution_time: T.unsafe(nil), search_cursor: T.unsafe(nil), vsim_cursor: T.unsafe(nil)); end

  # @param index [Integer] the row position
  # @return [Hash, nil] the row at +index+, or nil when out of range
  #
  # pkg:gem/redis#lib/redis/commands/modules/search/result.rb:197
  def [](index); end

  # @return [Boolean] whether this is a WITHCURSOR reply carrying cursor ids
  #
  # pkg:gem/redis#lib/redis/commands/modules/search/result.rb:213
  def cursor?; end

  # Iterate over the result rows.
  #
  # @yieldparam row [Hash{String => Object}]
  # @return [Enumerator, Array<Hash>]
  #
  # pkg:gem/redis#lib/redis/commands/modules/search/result.rb:191
  def each(&block); end

  # @return [Boolean] whether there are no rows
  #
  # pkg:gem/redis#lib/redis/commands/modules/search/result.rb:208
  def empty?; end

  # @return [Array<Hash{String => Object}>] the fused result rows
  # @return [Integer, nil] the total number of fused results
  # @return [Array] any warnings returned by the server
  # @return [Float, nil] the server-side execution time
  # @return [Integer, nil] the SEARCH-leg cursor id (WITHCURSOR only)
  # @return [Integer, nil] the VSIM-leg cursor id (WITHCURSOR only)
  #
  # pkg:gem/redis#lib/redis/commands/modules/search/result.rb:175
  def execution_time; end

  # pkg:gem/redis#lib/redis/commands/modules/search/result.rb:205
  def length; end

  # @return [Array<Hash{String => Object}>] the fused result rows
  # @return [Integer, nil] the total number of fused results
  # @return [Array] any warnings returned by the server
  # @return [Float, nil] the server-side execution time
  # @return [Integer, nil] the SEARCH-leg cursor id (WITHCURSOR only)
  # @return [Integer, nil] the VSIM-leg cursor id (WITHCURSOR only)
  #
  # pkg:gem/redis#lib/redis/commands/modules/search/result.rb:175
  def rows; end

  # @return [Array<Hash{String => Object}>] the fused result rows
  # @return [Integer, nil] the total number of fused results
  # @return [Array] any warnings returned by the server
  # @return [Float, nil] the server-side execution time
  # @return [Integer, nil] the SEARCH-leg cursor id (WITHCURSOR only)
  # @return [Integer, nil] the VSIM-leg cursor id (WITHCURSOR only)
  #
  # pkg:gem/redis#lib/redis/commands/modules/search/result.rb:175
  def search_cursor; end

  # @return [Integer] the number of rows
  #
  # pkg:gem/redis#lib/redis/commands/modules/search/result.rb:202
  def size; end

  # @return [Array<Hash{String => Object}>] the fused result rows
  # @return [Integer, nil] the total number of fused results
  # @return [Array] any warnings returned by the server
  # @return [Float, nil] the server-side execution time
  # @return [Integer, nil] the SEARCH-leg cursor id (WITHCURSOR only)
  # @return [Integer, nil] the VSIM-leg cursor id (WITHCURSOR only)
  #
  # pkg:gem/redis#lib/redis/commands/modules/search/result.rb:175
  def total; end

  # @return [Array<Hash{String => Object}>] the fused result rows
  # @return [Integer, nil] the total number of fused results
  # @return [Array] any warnings returned by the server
  # @return [Float, nil] the server-side execution time
  # @return [Integer, nil] the SEARCH-leg cursor id (WITHCURSOR only)
  # @return [Integer, nil] the VSIM-leg cursor id (WITHCURSOR only)
  #
  # pkg:gem/redis#lib/redis/commands/modules/search/result.rb:175
  def vsim_cursor; end

  # @return [Array<Hash{String => Object}>] the fused result rows
  # @return [Integer, nil] the total number of fused results
  # @return [Array] any warnings returned by the server
  # @return [Float, nil] the server-side execution time
  # @return [Integer, nil] the SEARCH-leg cursor id (WITHCURSOR only)
  # @return [Integer, nil] the VSIM-leg cursor id (WITHCURSOR only)
