# pkg:gem/appsignal#lib/appsignal/rack.rb:7
Appsignal::Rack::APPSIGNAL_EVENT_HANDLER_ID = T.let(T.unsafe(nil), String)

# pkg:gem/appsignal#lib/appsignal/rack.rb:9
Appsignal::Rack::APPSIGNAL_RESPONSE_INSTRUMENTED = T.let(T.unsafe(nil), String)

