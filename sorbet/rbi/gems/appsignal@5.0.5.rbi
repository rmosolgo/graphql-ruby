# There is one registry of event formatters, shared by this class and by
# every formatter that inherits from it. It is kept in a constant because a
# class instance variable is not shared with subclasses. Without this, a
# formatter that registers or unregisters itself would read and write a
# registry of its own that nothing else looks at.
#
# pkg:gem/appsignal#lib/appsignal/event_formatter.rb:19
Appsignal::EventFormatter::REGISTRY = T.let(T.unsafe(nil), Hash)

# Registered for an event that a dedicated AppSignal integration already
# records with richer semantics. The generic instrumentation paths ask the
# registry whether to record an event, so registering this for an event
# name is how that integration claims it.
#
# @!visibility private
#
# pkg:gem/appsignal#lib/appsignal/event_formatter/recorded_elsewhere.rb:11
class Appsignal::EventFormatter::RecordedElsewhere < ::Appsignal::EventFormatter
  # pkg:gem/appsignal#lib/appsignal/event_formatter/recorded_elsewhere.rb:12
  def record?; end
end

# @!visibility private
#
# pkg:gem/appsignal#lib/appsignal/event_formatter/rom/sql_formatter.rb:6
module Appsignal::EventFormatter::Rom; end

# pkg:gem/appsignal#lib/appsignal/event_formatter/rom/sql_formatter.rb:7
class Appsignal::EventFormatter::Rom::SqlFormatter < ::Appsignal::EventFormatter
  # dry-monitor reports an event under an id rather than a name, so the
  # first value here names the event. Naming it after ROM keeps every ROM
  # query in one group.
  #
  # The payload also says which database ROM is talking to, as Sequel's
  # database type. That is deliberately not part of the name. It would
  # put an application's queries in a group per database engine, so the
  # same application would report one group in production and another in
  # its tests.
  #
  # pkg:gem/appsignal#lib/appsignal/event_formatter/rom/sql_formatter.rb:29
  def format(payload); end

  # The payload's `name` is Sequel's `database_type` symbol for the
  # database ROM is talking to, so this uses Sequel's own lookup
  # rather than a coincidentally similar one. A symbol the mapping does
  # not recognise is left to the SQL sentinel, same as an engine this
  # gem has never heard of.
  #
  # pkg:gem/appsignal#lib/appsignal/event_formatter/rom/sql_formatter.rb:38
  def opentelemetry_attributes(payload); end

  # A query is an outgoing call to a datastore.
  #
  # pkg:gem/appsignal#lib/appsignal/event_formatter/rom/sql_formatter.rb:16
  def opentelemetry_kind; end

  # These events arrive over dry-monitor, which is a notification bus
  # rather than a library that queries a database. ROM is what emits
  # them, so that is what the scope names.
  #
  # pkg:gem/appsignal#lib/appsignal/event_formatter/rom/sql_formatter.rb:11
  def opentelemetry_scope; end
end

# @return [Integer]
# @api public
#
# pkg:gem/appsignal#lib/appsignal/event_formatter.rb:209
Appsignal::EventFormatter::SQL_BODY_FORMAT = T.let(T.unsafe(nil), Integer)

# @!visibility private
#
# pkg:gem/appsignal#lib/appsignal/event_formatter/sequel/sql_formatter.rb:6
module Appsignal::EventFormatter::Sequel; end

# Compatibility with the sequel-rails gem.
# The sequel-rails gem adds its own ActiveSupport::Notifications events
# that conflict with our own sequel instrumentor. Without this event
# formatter the sequel-rails events are recorded without the SQL query
# that's being executed.
#
# pkg:gem/appsignal#lib/appsignal/event_formatter/sequel/sql_formatter.rb:12
class Appsignal::EventFormatter::Sequel::SqlFormatter < ::Appsignal::EventFormatter
  # pkg:gem/appsignal#lib/appsignal/event_formatter/sequel/sql_formatter.rb:18
  def format(payload); end

  # A query is an outgoing call to a datastore.
  #
  # pkg:gem/appsignal#lib/appsignal/event_formatter/sequel/sql_formatter.rb:14
  def opentelemetry_kind; end
end

# @!visibility private
#
# pkg:gem/appsignal#lib/appsignal/event_formatter/view_component/render_formatter.rb:6
module Appsignal::EventFormatter::ViewComponent; end

# pkg:gem/appsignal#lib/appsignal/event_formatter/view_component/render_formatter.rb:7
class Appsignal::EventFormatter::ViewComponent::RenderFormatter < ::Appsignal::EventFormatter
  # pkg:gem/appsignal#lib/appsignal/event_formatter/view_component/render_formatter.rb:14
  def format(payload); end

  # pkg:gem/appsignal#lib/appsignal/event_formatter/view_component/render_formatter.rb:10
  def opentelemetry_attributes(_payload); end

  # The application's root, which a component's path is made relative to.
  #
  # Whether there is an application is decided here, when the event is
  # formatted, rather than when this file is loaded. AppSignal can be
  # required before Rails is, and deciding it at load time would leave
  # every component render in the application without a title.
  #
  # pkg:gem/appsignal#lib/appsignal/event_formatter/view_component/render_formatter.rb:29
  def root_path; end
end

