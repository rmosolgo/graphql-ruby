# pkg:gem/appsignal#lib/appsignal/utils/request_headers.rb:5
class Appsignal::Utils::RequestHeaders
  class << self
    # pkg:gem/appsignal#lib/appsignal/utils/request_headers.rb:49
    def header_name(env_key); end

    # Several OpenTelemetry SDKs write header attribute names with underscores,
    # where the semantic conventions the collector compares against use dashes.
    #
    # pkg:gem/appsignal#lib/appsignal/utils/request_headers.rb:72
    def normalize(name); end

    # A key does not always make the round trip as itself, because two Rack keys
    # can name the same header: a server that sets both `CONTENT_LENGTH` and
    # `HTTP_CONTENT_LENGTH` gets the second one back as the first.
    #
    # pkg:gem/appsignal#lib/appsignal/utils/request_headers.rb:63
    def rack_name(header); end

    # pkg:gem/appsignal#lib/appsignal/utils/request_headers.rb:24
    def split(env); end

    # pkg:gem/appsignal#lib/appsignal/utils/request_headers.rb:42
    def split_lazily(&block); end
  end
end

# pkg:gem/appsignal#lib/appsignal/utils/request_headers.rb:21
Appsignal::Utils::RequestHeaders::HTTP_PREFIX = T.let(T.unsafe(nil), String)

# `HTTP_VERSION` is a CGI variable holding the same value as
# `SERVER_PROTOCOL`, not a header.
#
# pkg:gem/appsignal#lib/appsignal/utils/request_headers.rb:12
Appsignal::Utils::RequestHeaders::NON_HEADER_KEYS = T.let(T.unsafe(nil), Array)

# The environment keys the instrumentation already describes with a semantic
# convention attribute, read from the request itself.
#
# pkg:gem/appsignal#lib/appsignal/utils/request_headers.rb:16
Appsignal::Utils::RequestHeaders::TRANSLATED_ENV_KEYS = T.let(T.unsafe(nil), Array)

# The only two request headers Rack passes without the `HTTP_` prefix,
# because CGI reserves the prefixed spelling of them.
#
# pkg:gem/appsignal#lib/appsignal/utils/request_headers.rb:8
Appsignal::Utils::RequestHeaders::UNPREFIXED_HEADER_KEYS = T.let(T.unsafe(nil), Array)

