  # pkg:gem/appsignal#lib/appsignal/helpers/instrumentation.rb:853
  def set_session_data(session_data = T.unsafe(nil), &block); end

  # pkg:gem/appsignal#lib/appsignal/helpers/instrumentation.rb:652
