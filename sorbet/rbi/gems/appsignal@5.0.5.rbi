# Logger that flushes logs to the AppSignal logging service.
#
# @see https://docs.appsignal.com/logging/platforms/integrations/ruby.html
#   AppSignal Ruby logging documentation.
#
# pkg:gem/appsignal#lib/appsignal/logger.rb:10
class Appsignal::Logger < ::Logger
  # Create a new logger instance
  #
  # @param group [String] Name of the group for this logger.
  # @param level [Integer] Minimum log level to report. Log lines below this
  #   level will be ignored.
  # @param format [Integer] Format to use to parse log line attributes.
  # @param attributes [Hash<String, String>] Default attributes for all log lines.
  # @return [void]
  #
  # pkg:gem/appsignal#lib/appsignal/logger.rb:81
  def initialize(group, level: T.unsafe(nil), format: T.unsafe(nil), attributes: T.unsafe(nil)); end

  # Log an info level message
  #
  # Returns the number of characters written.
  #
  # @param message [String] Message to log
  # @return [Integer]
  #
  # pkg:gem/appsignal#lib/appsignal/logger.rb:201
  def <<(message); end

  # We support the various methods in the Ruby
  # logger class by supplying this method.
  # @!visibility private
  #
  # pkg:gem/appsignal#lib/appsignal/logger.rb:108
  def add(severity, message = T.unsafe(nil), group = T.unsafe(nil), &block); end

  # Adds a logger to broadcast log messages to.
  #
  # This implementation of the broadcasting logic exists here in the
  # AppSignal Ruby gem, because it doesn't work in Rails using tagged logging.
  # It would log a log line as many times as there are `Rails.logger.tagged`
  # calls wrapping it.
  #
  # For example, this setup with one log line:
  #
  # ```ruby
  # appsignal_logger = Appsignal::Logger.new("rails")
  # Rails.logger.broadcast_to(appsignal_logger)
  #
  # Rails.logger.tagged("my tag") do
  #   Rails.logger.tagged("my nested tag") do
  #     Rails.logger.info("Nested log")
  #   end
  # end
  # ```
  #
  # Is logged as the following to the AppSignal logger.
  # Each combination of tags is sent separately.
  #
  # ```
  # Nested log
  # [my nested tag] Nested log
  # [my tag] Nested log
  # [my tag] [my nested tag] Nested log
  # ```
  #
  # Once it's fixed in Rails, it can be removed here.
  #
  # Related issues and PRs:
  #
  # - https://github.com/rails/rails/issues/46084
  # - https://github.com/rails/rails/issues/44668
  # - https://github.com/rails/rails/pull/53105
  # - https://github.com/rails/rails/pull/49771
  #
  # Another issue was that the Rails `.broadcast_to` implementation in
  # `ActiveSupport::BroadcastLogger` will run the block passed to `.tagged`
  # as many times as there are loggers.
  # Very early in the Rails execution stack, a middleware runs
  # `logger.tagged(...) { @app.call(env) }`.
  # This would cause the request handler to run twice, and it also causes
  # the Rack response to be an array of Rack responses instead,
  # which breaks the app entirely.
  #
  # Related issues:
  #
  # - https://github.com/rails/rails/issues/49745
  # - https://github.com/rails/rails/issues/49745#issuecomment-1775100622
  #
  # @param logger [Logger] The logger to add to the broadcast list.
  # @return [Array<Logger>]
  #
  # pkg:gem/appsignal#lib/appsignal/logger.rb:283
  def broadcast_to(logger); end

  # Log a debug level message
  # @param message [String] Message to log
  # @param attributes [Hash<String, Object>] Attributes to tag the log with
  # @return [void]
  #
  # pkg:gem/appsignal#lib/appsignal/logger.rb:159
  def debug(message = T.unsafe(nil), attributes = T.unsafe(nil), &block); end

  # Log an error level message
  # @param message [String, Exception] Message to log
  # @param attributes [Hash<String, Object>] Attributes to tag the log with
  # @return [void]
  #
  # pkg:gem/appsignal#lib/appsignal/logger.rb:183
  def error(message = T.unsafe(nil), attributes = T.unsafe(nil), &block); end

  # Log a fatal level message
  # @param message [String, Exception] Message to log
  # @param attributes [Hash<String, Object>] Attributes to tag the log with
  # @return [void]
  #
  # pkg:gem/appsignal#lib/appsignal/logger.rb:191
  def fatal(message = T.unsafe(nil), attributes = T.unsafe(nil), &block); end

  # Sets the formatter for this logger and all broadcasted loggers.
  # @param formatter [Proc] The formatter to use for log messages.
  # @return [Proc]
  #
  # pkg:gem/appsignal#lib/appsignal/logger.rb:98
  def formatter=(formatter); end

  # Log an info level message
  # @param message [String] Message to log
  # @param attributes [Hash<String, Object>] Attributes to tag the log with
  # @return [void]
  #
  # pkg:gem/appsignal#lib/appsignal/logger.rb:167
  def info(message = T.unsafe(nil), attributes = T.unsafe(nil), &block); end

  # Logging severity threshold
  # @return [Integer]
  #
  # pkg:gem/appsignal#lib/appsignal/logger.rb:69
  def level; end

  # pkg:gem/appsignal#lib/appsignal/logger.rb:153
  def log(severity, message = T.unsafe(nil), group = T.unsafe(nil), &block); end

  # Temporarily silences the logger to a specified level while executing a block.
  #
  # When using ActiveSupport::TaggedLogging without the broadcast feature,
  # the passed logger is required to respond to the `silence` method.
  #
  # Reference links:
  #
  # - https://github.com/rails/rails/blob/e11ebc04cfbe41c06cdfb70ee5a9fdbbd98bb263/activesupport/lib/active_support/logger.rb#L60-L76
  # - https://github.com/rails/rails/blob/e11ebc04cfbe41c06cdfb70ee5a9fdbbd98bb263/activesupport/lib/active_support/logger_silence.rb
  #
  # @param severity [Integer] The minimum severity level to log during the block.
  # @return [Object] The return value of the block.
  #
  # pkg:gem/appsignal#lib/appsignal/logger.rb:218
  def silence(severity = T.unsafe(nil), &block); end

  # Log a warn level message
  # @param message [String] Message to log
  # @param attributes [Hash<String, Object>] Attributes to tag the log with
  # @return [void]
  #
  # pkg:gem/appsignal#lib/appsignal/logger.rb:175
  def warn(message = T.unsafe(nil), attributes = T.unsafe(nil), &block); end

  private

  # pkg:gem/appsignal#lib/appsignal/logger.rb:291
  def add_with_attributes(severity, message, group, attributes, &block); end

  # pkg:gem/appsignal#lib/appsignal/logger.rb:289
  def appsignal_attributes; end

  # pkg:gem/appsignal#lib/appsignal/logger.rb:289
  def default_attributes; end

  # pkg:gem/appsignal#lib/appsignal/logger.rb:298
  def validated_format(format); end
end

# @!visibility private
#
# pkg:gem/appsignal#lib/appsignal/logger.rb:55
Appsignal::Logger::AUTODETECT = T.let(T.unsafe(nil), Integer)

# A wrapper for a block that ensures it is only called once.
# If called again, it will return the result of the first call.
# This is useful for ensuring that a block is not executed multiple
# times when it is broadcasted to multiple loggers.
#
# @!visibility private
#
# pkg:gem/appsignal#lib/appsignal/logger.rb:17
class Appsignal::Logger::BlockOnce
  # pkg:gem/appsignal#lib/appsignal/logger.rb:18
  def initialize(&block); end

  # pkg:gem/appsignal#lib/appsignal/logger.rb:26
  def call(*args, **kwargs); end

  # pkg:gem/appsignal#lib/appsignal/logger.rb:43
  def to_proc; end
end

