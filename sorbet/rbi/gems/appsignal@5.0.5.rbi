# pkg:gem/appsignal#lib/appsignal/opentelemetry/rendering.rb:14
module Appsignal::OpenTelemetry::Rendering
  class << self
    # The attributes describing an event as template rendering, as a Hash
    # to pass to `add_opentelemetry_attributes`.
    #
    # pkg:gem/appsignal#lib/appsignal/opentelemetry/rendering.rb:23
    def attributes; end
  end
end

