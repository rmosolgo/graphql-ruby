    # Only called from `instrument` while the mutex is held, so the plain
    # memoisation needs no extra locking of its own.
    #
    # pkg:gem/appsignal#lib/appsignal/metrics/opentelemetry_backend.rb:83
    def meter; end
  end
end

# pkg:gem/appsignal#lib/appsignal/metrics/opentelemetry_backend.rb:24
Appsignal::Metrics::OpenTelemetryBackend::MUTEX = T.let(T.unsafe(nil), Thread::Mutex)

