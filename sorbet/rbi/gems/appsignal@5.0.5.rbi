# The value the semantic conventions use for a method they do not know.
#
# pkg:gem/appsignal#lib/appsignal/opentelemetry/http_method.rb:31
Appsignal::OpenTelemetry::HttpMethod::OTHER = T.let(T.unsafe(nil), String)

# @!visibility private
#
# Builds the OpenTelemetry attributes that describe an HTTP response.
