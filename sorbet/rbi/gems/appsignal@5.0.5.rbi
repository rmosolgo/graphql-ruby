    # pkg:gem/appsignal#lib/appsignal/opentelemetry/process_resource.rb:76
    def refresh(name, provider, update, instance_id_before_fork); end

    # pkg:gem/appsignal#lib/appsignal/opentelemetry/process_resource.rb:109
    def write_resource(provider, resource); end
  end
end

