    def force_linux_arm_build?; end

    # Returns whether or not the musl build was forced by the user.
    #
    # @return [Boolean]
    #
    # pkg:gem/appsignal#lib/appsignal/system.rb:79
    def force_musl_build?; end

    # Returns if system is recognized as a Heroku dyno.
    #
    # @return [Boolean]
    #
    # pkg:gem/appsignal#lib/appsignal/system.rb:19
    def heroku?; end

    # Returns if the app is recognized as a JRuby app.
    #
    # @return [Boolean]
    #
    # pkg:gem/appsignal#lib/appsignal/system.rb:106
    def jruby?; end

    # pkg:gem/appsignal#lib/appsignal/system.rb:94
    def ldd_version_output; end

    # pkg:gem/appsignal#lib/appsignal/system.rb:90
    def versionify(version); end
  end
end

