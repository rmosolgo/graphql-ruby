# pkg:gem/appsignal#lib/appsignal/event_formatter/active_record/sql_formatter.rb:7
class Appsignal::EventFormatter::ActiveRecord::SqlFormatter < ::Appsignal::EventFormatter
  # pkg:gem/appsignal#lib/appsignal/event_formatter/active_record/sql_formatter.rb:27
  def format(payload); end

  # The payload carries the connection the query ran on (Rails 6.0+),
  # whose `adapter_name` is each adapter's own name for itself, such as
  # `"PostgreSQL"` or `"Mysql2"`. A name the mapping does not recognise
  # is left to the SQL sentinel, same as an adapter this gem has never
  # heard of.
  #
  # pkg:gem/appsignal#lib/appsignal/event_formatter/active_record/sql_formatter.rb:18
  def opentelemetry_attributes(payload); end

  # A query is an outgoing call to a datastore.
  #
  # pkg:gem/appsignal#lib/appsignal/event_formatter/active_record/sql_formatter.rb:9
  def opentelemetry_kind; end
end

