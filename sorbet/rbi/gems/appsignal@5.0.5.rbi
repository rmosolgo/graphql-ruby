  # pkg:gem/appsignal#lib/appsignal/transaction.rb:1460
  def channel_set?(channel); end

  # pkg:gem/appsignal#lib/appsignal/transaction.rb:1519
  def cleaned_backtrace(backtrace); end

  # Clean error messages that are known to potentially contain user data.
  # Returns an unchanged message otherwise.
  #
  # pkg:gem/appsignal#lib/appsignal/transaction.rb:1536
  def cleaned_error_message(error); end

  # @!visibility private
  #
  # pkg:gem/appsignal#lib/appsignal/transaction.rb:1527
  def custom_data; end

  # pkg:gem/appsignal#lib/appsignal/transaction.rb:1368
  def duplicate; end

  # pkg:gem/appsignal#lib/appsignal/transaction.rb:1464
  def headers_value(sample); end

  # pkg:gem/appsignal#lib/appsignal/transaction.rb:1456
  def mark_channel_set(channel); end

  # pkg:gem/appsignal#lib/appsignal/transaction.rb:1489
  def normalized_headers(headers); end

  # pkg:gem/appsignal#lib/appsignal/transaction.rb:1385
  def params; end

  # pkg:gem/appsignal#lib/appsignal/transaction.rb:1155
  def params_channel(channel); end

  # The `SampleData` bucket a logical params channel is stored in, per the
  # backend's `params_mapping`. In agent mode every channel resolves to the
  # same `:params` bucket (so they merge and share an `_if_nil` guard); in
  # collector mode the request payload, function parameters and query
  # parameters resolve to separate buckets. `fetch` raises if a backend's
  # mapping omits a channel.
  #
  # pkg:gem/appsignal#lib/appsignal/transaction.rb:1148
  def params_data(channel); end

  # pkg:gem/appsignal#lib/appsignal/transaction.rb:1165
  def params_unset?(channel); end

  # Reads a params bucket's value. Evaluating it runs any block the caller
  # passed to `add_params`/`add_request_payload`/`add_function_parameters`,
  # which is user code that can raise, so a failure is logged and swallowed.
  #
  # pkg:gem/appsignal#lib/appsignal/transaction.rb:1400
  def params_value(sample); end

  # Wrap a block handed to the transaction by user code so that, wherever it
  # later runs, a failure is logged and swallowed instead of breaking the
  # transaction lifecycle. A raise would otherwise skip the rest of creation or
  # completion, including the backend teardown that detaches the transaction's
  # OpenTelemetry context, which would then become the parent of the next
  # request's spans on that thread. Re-raising is wrong because the block runs
  # far from where its caller defined it.
  #
  # Returns `nil` when no block is given, so it can wrap an optional block.
  #
  # pkg:gem/appsignal#lib/appsignal/transaction.rb:1194
  def protect(description, &block); end

  # Reports the errors stored on the transaction at completion.
  #
  # In eager (collector) mode nothing is left to do: each error was recorded
  # and its block run when the error was added. In deferred (agent) mode the
  # extension holds a single error, so the primary error's blocks run on this
  # transaction and every additional error is reported as a duplicate
  # transaction.
  #
  # pkg:gem/appsignal#lib/appsignal/transaction.rb:1230
  def report_errors; end

  # Agent-only legacy path. The extension transaction holds a single error, so
  # extra errors are reported as duplicate transactions. This whole method
  # disappears once agent mode is dropped: collector mode records every error
  # eagerly and leaves nothing to do at completion.
  #
  # pkg:gem/appsignal#lib/appsignal/transaction.rb:1240
  def report_errors_as_duplicates; end

  # Hooks are registered both as blocks and as method objects pushed onto the
  # set directly, so there is no single entry point to wrap them at. They are
  # protected here instead, at the one place that runs all of them.
  #
  # pkg:gem/appsignal#lib/appsignal/transaction.rb:1211
  def run_after_create_hooks; end

  # pkg:gem/appsignal#lib/appsignal/transaction.rb:1217
  def run_before_complete_hooks; end

  # pkg:gem/appsignal#lib/appsignal/transaction.rb:1346
  def sample_data; end

  # pkg:gem/appsignal#lib/appsignal/transaction.rb:1472
  def sanitized_headers(bucket, sample); end

  # pkg:gem/appsignal#lib/appsignal/transaction.rb:1389
  def sanitized_params(bucket, sample); end

  # Returns sanitized session data.
  #
  # The session data is sanitized by the
  # {Appsignal::Utils::SampleDataSanitizer}.
  #
  # @return [nil] if `:send_session_data` config is set to `false`.
  # @return [nil] if the {#request} object doesn't respond to `#session`.
  # @return [nil] if the {#request} session data is `nil`.
  # @return [Hash<String, Object>]
  #
  # pkg:gem/appsignal#lib/appsignal/transaction.rb:1426
  def sanitized_session_data; end

  # Only keep tags if they meet the following criteria:
  # * Key is a symbol or string with less then 100 chars
  # * Value is a symbol or string with less then 100 chars
  # * Value is an integer
  #
  # @see https://docs.appsignal.com/ruby/instrumentation/tagging.html
  #
  # pkg:gem/appsignal#lib/appsignal/transaction.rb:1501
  def sanitized_tags; end

  # @!visibility private
  #
  # pkg:gem/appsignal#lib/appsignal/transaction.rb:1409
  def session_data; end

  # pkg:gem/appsignal#lib/appsignal/transaction.rb:1318
  def set_sample_data(key, data); end

  # pkg:gem/appsignal#lib/appsignal/transaction.rb:1450
  def transform_headers(transform, headers); end

  # `add_params`/`set_params` don't say whether the params are a request
  # payload or function parameters, so in collector mode they always map to
  # the request payload. Warn once per process to nudge callers toward the
  # explicit methods.
  #
  # pkg:gem/appsignal#lib/appsignal/transaction.rb:1173
  def warn_params_deprecation; end

  class << self
    # Add a block, if given, to be executed after a transaction is created.
    # The block will be called with the transaction as an argument.
    # Returns the array of blocks that will be executed after a transaction
    # is created.
    #
    # @return [Array<Proc>]
    # @!visibility private
    #
    # pkg:gem/appsignal#lib/appsignal/transaction.rb:93
    def after_create(&block); end

    # Add a block, if given, to be executed before a transaction is completed.
    # This happens after duplicating the transaction for each error that was
    # reported in the transaction -- that is, when a transaction with
    # several errors is completed, the block will be called once for each
    # error, with the transaction (either the original one or a duplicate of it)
    # that has each of the errors set.
    # The block will be called with the transaction as the first argument,
    # and the error reported by the transaction, if any, as the second argument.
    # Returns the array of blocks that will be executed before a transaction is
    # completed.
    #
    # @return [Array<Proc>]
    # @!visibility private
    #
    # pkg:gem/appsignal#lib/appsignal/transaction.rb:114
    def before_complete(&block); end

    # Remove current transaction from current Thread.
    # @!visibility private
    #
    # pkg:gem/appsignal#lib/appsignal/transaction.rb:173
    def clear_current_transaction!; end

    # Complete the currently active transaction and unset it as the active
    # transaction.
    #
    # @return [void]
    #
    # pkg:gem/appsignal#lib/appsignal/transaction.rb:161
    def complete_current!; end

    # Create a new transaction and set it as the currently active
    # transaction.
    #
    # @param namespace [String] Namespace of the to be created transaction.
    # @param opentelemetry_kind [Symbol] In collector mode, the OpenTelemetry
    #   span kind: one of `:server`, `:consumer`, `:producer` or `:internal`.
    #   Defaults to `:server`.
    # @param opentelemetry_relationship [Symbol] In collector mode, how an
    #   incoming `opentelemetry_context` relates to this transaction's span:
    #   one of `:parent`, `:link`, `:both` or `:none`. Defaults to `:parent`.
    # @param opentelemetry_context In collector mode, an incoming OpenTelemetry
    #   trace context to relate this transaction's span to.
    # @param opentelemetry_scope [Array(String, String)] In collector mode, the
    #   OpenTelemetry instrumentation scope to record this transaction's spans
    #   under, given as a `[name, version]` pair. Defaults to the AppSignal
    #   scope.
    # @return [Transaction]
    #
    # pkg:gem/appsignal#lib/appsignal/transaction.rb:49
    def create(namespace, opentelemetry_context: T.unsafe(nil), opentelemetry_scope: T.unsafe(nil), opentelemetry_kind: T.unsafe(nil), opentelemetry_relationship: T.unsafe(nil)); end

    # Returns currently active transaction or a {NilTransaction} if none is
    # active.
    #
    # @see .current?
    # @return [Appsignal::Transaction, Appsignal::Transaction::NilTransaction]
    #
    # pkg:gem/appsignal#lib/appsignal/transaction.rb:144
    def current; end

    # Returns if any transaction is currently active or not. A
    # {NilTransaction} is not considered an active transaction.
    #
    # @see .current
    # @return [Boolean]
    #
    # pkg:gem/appsignal#lib/appsignal/transaction.rb:153
    def current?; end

    # @!visibility private
    #
    # pkg:gem/appsignal#lib/appsignal/transaction.rb:178
    def last_errors; end

    # @!visibility private
    #
    # pkg:gem/appsignal#lib/appsignal/transaction.rb:183
    def last_errors=(_arg0); end

    # @!visibility private
    # Resets the warn-once state. Only used to keep test runs isolated.
    #
    # pkg:gem/appsignal#lib/appsignal/transaction.rb:201
    def reset_params_deprecation_warning!; end

    # @!visibility private
    #
    # pkg:gem/appsignal#lib/appsignal/transaction.rb:123
    def set_current_transaction(transaction); end

    # Runs the block to emit the collector-mode `add_params`/`set_params`
    # deprecation warning the first time it is called in the process, then
    # stays quiet. The check-and-set is done under a lock so concurrent
    # transactions on threaded runtimes don't race and warn more than once.
    # @!visibility private
    #
    # pkg:gem/appsignal#lib/appsignal/transaction.rb:190
    def warn_params_deprecation_once; end

    # Set the current for the duration of the given block.
    # It restores the original transaction (if any) when the block has executed.
    #
    # @!visibility private
    #
    # pkg:gem/appsignal#lib/appsignal/transaction.rb:131
    def with_transaction(transaction); end
  end
end

# @!visibility private
#
# pkg:gem/appsignal#lib/appsignal/transaction.rb:12
Appsignal::Transaction::ACTION_CABLE = T.let(T.unsafe(nil), String)

# @!visibility private
#
# pkg:gem/appsignal#lib/appsignal/transaction.rb:16
Appsignal::Transaction::ALLOWED_TAG_KEY_TYPES = T.let(T.unsafe(nil), Array)

# @!visibility private
#
# pkg:gem/appsignal#lib/appsignal/transaction.rb:18
Appsignal::Transaction::ALLOWED_TAG_VALUE_TYPES = T.let(T.unsafe(nil), Array)

# @return [String]
#
# pkg:gem/appsignal#lib/appsignal/transaction.rb:10
Appsignal::Transaction::BACKGROUND_JOB = T.let(T.unsafe(nil), String)

# @!visibility private
#
# pkg:gem/appsignal#lib/appsignal/transaction.rb:14
Appsignal::Transaction::BLANK = T.let(T.unsafe(nil), String)

# @!visibility private
#
# pkg:gem/appsignal#lib/appsignal/transaction.rb:20
Appsignal::Transaction::BREADCRUMB_LIMIT = T.let(T.unsafe(nil), Integer)

# @!visibility private
#
# The interface every transaction backend implements. `Appsignal::Backends
# .transaction` picks a concrete backend per mode -- ExtensionBackend in
# agent mode, OpenTelemetryBackend in collector mode. This base documents the
# contract; a backend that leaves a method unimplemented raises here.
#
# pkg:gem/appsignal#lib/appsignal/transaction/base_backend.rb:11
class Appsignal::Transaction::BaseBackend
  # pkg:gem/appsignal#lib/appsignal/transaction/base_backend.rb:88
  def add_breadcrumb(_breadcrumb); end

  # pkg:gem/appsignal#lib/appsignal/transaction/base_backend.rb:108
  def complete; end

  # pkg:gem/appsignal#lib/appsignal/transaction/base_backend.rb:112
  def discard; end

  # Only used when `supports_multiple_errors?` is false (agent mode).
  # Backends that support multiple errors never duplicate and leave this
  # unimplemented.
  #
  # pkg:gem/appsignal#lib/appsignal/transaction/base_backend.rb:119
  def duplicate(_new_transaction_id); end

  # Lifecycle.
  #
  # pkg:gem/appsignal#lib/appsignal/transaction/base_backend.rb:104
  def finish; end

  # pkg:gem/appsignal#lib/appsignal/transaction/base_backend.rb:17
  def finish_event(_name, _title, _body, _body_format); end

  # Maps each header bucket to the configuration option that lists the
  # keys to keep in it. An option holding `nil` keeps every key.
  #
  # pkg:gem/appsignal#lib/appsignal/transaction/base_backend.rb:79
  def headers_allowlist; end

  # Maps each logical header channel (`:request_headers`,
  # `:request_environment`) to the storage bucket it lands in and the
  # transform to apply to each key and value added on it, as
  # `[bucket, transform]`. A `nil` transform leaves the value alone.
  #
  # pkg:gem/appsignal#lib/appsignal/transaction/base_backend.rb:73
  def headers_mapping; end

  # Maps each logical params channel (`:params`, `:request_payload`,
  # `:function_parameters`) to the storage bucket it lands in. Channels that
  # share a bucket merge into one `SampleData` object on the transaction;
  # distinct buckets stay separate. The bucket name is also the sample-data
  # key `set_sample_data` receives for that bucket, so it must be a key this
  # backend's `set_sample_data` knows how to store.
  #
  # pkg:gem/appsignal#lib/appsignal/transaction/base_backend.rb:58
  def params_mapping; end

  # Maps each params bucket to the configuration options that decide what
  # it reports: `:filter`, naming the keys to filter out of it, and
  # `:send`, deciding whether to report it at all.
  #
  # pkg:gem/appsignal#lib/appsignal/transaction/base_backend.rb:65
  def params_options; end

  # pkg:gem/appsignal#lib/appsignal/transaction/base_backend.rb:21
  def record_event(_name, _title, _body, _body_format, _duration, opentelemetry_kind: T.unsafe(nil), opentelemetry_scope: T.unsafe(nil)); end

  # Transaction metadata.
  #
  # pkg:gem/appsignal#lib/appsignal/transaction/base_backend.rb:29
  def set_action(_action); end

  # OpenTelemetry span attributes, set on whichever span the backend is
  # currently recording. Only meaningful in collector mode; agent mode has
  # no span to hang them on.
  #
  # pkg:gem/appsignal#lib/appsignal/transaction/base_backend.rb:48
  def set_attributes(_attributes); end

  # pkg:gem/appsignal#lib/appsignal/transaction/base_backend.rb:92
  def set_error(_class_name, _message, _backtrace, _causes, _root_cause_missing); end

  # pkg:gem/appsignal#lib/appsignal/transaction/base_backend.rb:37
  def set_metadata(_key, _value); end

  # pkg:gem/appsignal#lib/appsignal/transaction/base_backend.rb:33
  def set_namespace(_namespace); end

  # pkg:gem/appsignal#lib/appsignal/transaction/base_backend.rb:41
  def set_queue_start(_start); end

  # Sample data (params, session, tags, ...), breadcrumbs and errors.
  #
  # pkg:gem/appsignal#lib/appsignal/transaction/base_backend.rb:84
  def set_sample_data(_key, _data); end

  # Instrumented events.
  #
  # pkg:gem/appsignal#lib/appsignal/transaction/base_backend.rb:13
  def start_event(opentelemetry_kind: T.unsafe(nil), opentelemetry_scope: T.unsafe(nil)); end

  # Whether the backend can hold more than one error on a single
  # transaction. When it can't (agent mode), the Transaction reports the
  # extra errors as duplicate transactions instead.
  #
  # pkg:gem/appsignal#lib/appsignal/transaction/base_backend.rb:99
  def supports_multiple_errors?; end

  # pkg:gem/appsignal#lib/appsignal/transaction/base_backend.rb:123
  def to_json; end
end

# @!visibility private
#
# pkg:gem/appsignal#lib/appsignal/transaction.rb:24
Appsignal::Transaction::ERRORS_LIMIT = T.let(T.unsafe(nil), Integer)

# @!visibility private
#
# pkg:gem/appsignal#lib/appsignal/transaction.rb:22
Appsignal::Transaction::ERROR_CAUSES_LIMIT = T.let(T.unsafe(nil), Integer)

# @!visibility private
#
# The transaction backend used in agent mode. Wraps a per-transaction
# handle on the C extension (`Appsignal::Extension::Transaction`) and
# forwards every call to it.
#
# In agent mode `Appsignal::Backends.transaction` returns this class;
# `Appsignal::Transaction#initialize` instantiates one and stores it in
# `@backend`.
#
# pkg:gem/appsignal#lib/appsignal/transaction/extension_backend.rb:14
class Appsignal::Transaction::ExtensionBackend < ::Appsignal::Transaction::BaseBackend
  # The `opentelemetry_*` keyword arguments (context, scope, kind and
  # relationship) shape the OpenTelemetry span in collector mode. Agent mode
  # has no notion of them, so they are accepted and ignored. They are listed
  # explicitly, rather than swallowed with `**`, so an unexpected keyword
  # still raises, matching the OpenTelemetry backend.
  #
  # pkg:gem/appsignal#lib/appsignal/transaction/extension_backend.rb:29
  def initialize(transaction_id, namespace, handle: T.unsafe(nil), opentelemetry_context: T.unsafe(nil), opentelemetry_scope: T.unsafe(nil), opentelemetry_kind: T.unsafe(nil), opentelemetry_relationship: T.unsafe(nil)); end

  # Buffer breadcrumbs, keeping the last `BREADCRUMB_LIMIT`, and flush them as
  # sample data on completion.
  #
  # pkg:gem/appsignal#lib/appsignal/transaction/extension_backend.rb:133
  def add_breadcrumb(breadcrumb); end

  # @!visibility private
  #
  # pkg:gem/appsignal#lib/appsignal/transaction/extension_backend.rb:21
  def breadcrumbs=(_arg0); end

  # pkg:gem/appsignal#lib/appsignal/transaction/extension_backend.rb:157
  def complete; end

  # Discarding in agent mode drops the transaction: the extension handle is
  # simply abandoned and never told to complete, so nothing is sent. There
  # is no `ignore_subtrace` concept on the agent path. This mirrors the
  # pre-backend behavior, where `Transaction#complete` returned before
  # touching the handle on a discarded transaction.
  #
  # pkg:gem/appsignal#lib/appsignal/transaction/extension_backend.rb:169
  def discard; end

  # pkg:gem/appsignal#lib/appsignal/transaction/extension_backend.rb:178
  def duplicate(new_transaction_id); end

  # pkg:gem/appsignal#lib/appsignal/transaction/extension_backend.rb:153
  def finish; end

  # pkg:gem/appsignal#lib/appsignal/transaction/extension_backend.rb:52
  def finish_event(name, title, body, body_format); end

  # pkg:gem/appsignal#lib/appsignal/transaction/extension_backend.rb:121
  def headers_allowlist; end

  # pkg:gem/appsignal#lib/appsignal/transaction/extension_backend.rb:115
  def headers_mapping; end

  # pkg:gem/appsignal#lib/appsignal/transaction/extension_backend.rb:95
  def params_mapping; end

  # pkg:gem/appsignal#lib/appsignal/transaction/extension_backend.rb:103
  def params_options; end

  # Agent mode has no span kind or instrumentation scope;
  # `opentelemetry_kind` and `opentelemetry_scope` are ignored here.
  #
  # pkg:gem/appsignal#lib/appsignal/transaction/extension_backend.rb:58
  def record_event(name, title, body, body_format, duration, opentelemetry_kind: T.unsafe(nil), opentelemetry_scope: T.unsafe(nil), opentelemetry_attributes: T.unsafe(nil)); end

  # pkg:gem/appsignal#lib/appsignal/transaction/extension_backend.rb:62
  def set_action(action); end

  # Agent mode has no OpenTelemetry spans, so there is nothing to set the
  # attributes on. A transaction event has no attribute equivalent in the
  # agent protocol either, so they are dropped rather than stored somewhere
  # else.
  #
  # pkg:gem/appsignal#lib/appsignal/transaction/extension_backend.rb:82
  def set_attributes(_attributes); end

  # Serializes the backtrace to a C-extension `Data` object and records the
  # error, then flushes the causes as `error_causes` sample data in the
  # agent's first-line shape.
  #
  # pkg:gem/appsignal#lib/appsignal/transaction/extension_backend.rb:141
  def set_error(class_name, message, backtrace, causes, root_cause_missing); end

  # pkg:gem/appsignal#lib/appsignal/transaction/extension_backend.rb:74
  def set_metadata(key, value); end

  # pkg:gem/appsignal#lib/appsignal/transaction/extension_backend.rb:66
  def set_namespace(namespace); end

  # pkg:gem/appsignal#lib/appsignal/transaction/extension_backend.rb:70
  def set_queue_start(start); end

  # `data` is a raw Ruby Hash/Array; the C extension wants a `Data` object,
  # so serialize it here (mirrors how `set_error` serializes its backtrace).
  #
  # pkg:gem/appsignal#lib/appsignal/transaction/extension_backend.rb:127
  def set_sample_data(key, data); end

  # Agent mode has no span kind or instrumentation scope;
  # `opentelemetry_kind` and `opentelemetry_scope` are ignored here.
  #
  # pkg:gem/appsignal#lib/appsignal/transaction/extension_backend.rb:48
  def start_event(opentelemetry_kind: T.unsafe(nil), opentelemetry_scope: T.unsafe(nil)); end

  # The extension transaction holds a single error, so the Transaction
  # reports additional errors as duplicate transactions instead.
  #
  # pkg:gem/appsignal#lib/appsignal/transaction/extension_backend.rb:174
  def supports_multiple_errors?; end

  # pkg:gem/appsignal#lib/appsignal/transaction/extension_backend.rb:184
  def to_json; end

  private

  # Projects the neutral causes to the agent's first-line shape. A truncated
  # chain marks its last entry as not the root cause.
  #
  # pkg:gem/appsignal#lib/appsignal/transaction/extension_backend.rb:192
  def error_causes_sample_data(causes, root_cause_missing); end

  # Parses the first backtrace line into the fields the UI links on (gem,
  # path, line, method), with the path made relative to the app root.
  #
  # pkg:gem/appsignal#lib/appsignal/transaction/extension_backend.rb:206
  def first_formatted_backtrace_line(backtrace); end
end

# pkg:gem/appsignal#lib/appsignal/transaction/extension_backend.rb:16
Appsignal::Transaction::ExtensionBackend::BACKTRACE_REGEX = T.let(T.unsafe(nil), Regexp)

# pkg:gem/appsignal#lib/appsignal/transaction/extension_backend.rb:119
Appsignal::Transaction::ExtensionBackend::HEADERS_ALLOWLIST = T.let(T.unsafe(nil), Hash)

# pkg:gem/appsignal#lib/appsignal/transaction/extension_backend.rb:107
Appsignal::Transaction::ExtensionBackend::HEADERS_MAPPING = T.let(T.unsafe(nil), Hash)

# The agent has a single params slot, so every params channel maps to one
# `:params` bucket. The transaction merges the channels into it, and only
# the `:params` key ever reaches `set_sample_data`.
#
# pkg:gem/appsignal#lib/appsignal/transaction/extension_backend.rb:88
Appsignal::Transaction::ExtensionBackend::PARAMS_MAPPING = T.let(T.unsafe(nil), Hash)

# pkg:gem/appsignal#lib/appsignal/transaction/extension_backend.rb:99
Appsignal::Transaction::ExtensionBackend::PARAMS_OPTIONS = T.let(T.unsafe(nil), Hash)

# @return [String]
#
# pkg:gem/appsignal#lib/appsignal/transaction.rb:8
Appsignal::Transaction::HTTP_REQUEST = T.let(T.unsafe(nil), String)

# Stub that is returned by {Transaction.current} if there is no current
# transaction, so that it's still safe to call methods on it if there is no
# current transaction.
#
# @!visibility private
#
# pkg:gem/appsignal#lib/appsignal/transaction.rb:1550
class Appsignal::Transaction::NilTransaction
  # Instrument should still yield
  #
  # pkg:gem/appsignal#lib/appsignal/transaction.rb:1555
  def instrument(*_args); end

  # pkg:gem/appsignal#lib/appsignal/transaction.rb:1551
  def method_missing(_method, *args, &block); end

  # pkg:gem/appsignal#lib/appsignal/transaction.rb:1559
  def nil_transaction?; end
end

# @!visibility private
#
# The transaction backend used in collector mode. Emits an OpenTelemetry
# root span for the transaction, a child span per instrumented event, and
# queue timing as a metric. Errors and breadcrumbs attach to whichever span
# is current when they happen.
#
# pkg:gem/appsignal#lib/appsignal/transaction/opentelemetry_backend.rb:14
class Appsignal::Transaction::OpenTelemetryBackend < ::Appsignal::Transaction::BaseBackend
  # pkg:gem/appsignal#lib/appsignal/transaction/opentelemetry_backend.rb:115
  def initialize(transaction_id, namespace, opentelemetry_context: T.unsafe(nil), opentelemetry_scope: T.unsafe(nil), opentelemetry_kind: T.unsafe(nil), opentelemetry_relationship: T.unsafe(nil)); end

  # Emits a breadcrumb as an `appsignal.breadcrumb` span event on AppSignal's
  # current span -- the open event span, falling back to the root -- rather
  # than the OTel current span, which may belong to another instrumentation.
  #
  # Emitted immediately, because by completion the event span has finished
  # and the SDK drops events added to an ended span. The breadcrumb's time
  # becomes the event's timestamp, and the metadata Hash is a JSON string,
  # because event attributes are flat.
  #
  # Capped at `BREADCRUMB_LIMIT` per transaction, keeping the first N where
  # agent mode keeps the last N: a streamed event cannot be retracted.
  #
  # pkg:gem/appsignal#lib/appsignal/transaction/opentelemetry_backend.rb:414
  def add_breadcrumb(breadcrumb); end

  # pkg:gem/appsignal#lib/appsignal/transaction/opentelemetry_backend.rb:438
  def complete; end

  # Discarding does not mean "don't send" as it does in agent mode. The root
  # span is still finished and exported, flagged with
  # `appsignal.ignore_subtrace` so the collector drops the whole subtrace.
  # The flag has to be written before the span finishes, because attributes
  # set on an ended span are dropped. Tearing the span down here also
  # detaches the context, so a discarded transaction cannot leave its root
  # span current on the thread.
  #
  # pkg:gem/appsignal#lib/appsignal/transaction/opentelemetry_backend.rb:460
  def discard; end

  # Returns `true` so `Transaction#complete` runs `sample_data`, flushing the
  # params/session/custom-data/tags/etc. onto the still-open root span before
  # `complete` finishes it. The OTel SDK makes its own sampling decision; the
  # gem always populates the span.
  #
  # pkg:gem/appsignal#lib/appsignal/transaction/opentelemetry_backend.rb:434
  def finish; end

  # pkg:gem/appsignal#lib/appsignal/transaction/opentelemetry_backend.rb:167
  def finish_event(name, title, body, body_format); end

  # pkg:gem/appsignal#lib/appsignal/transaction/opentelemetry_backend.rb:320
  def headers_allowlist; end

  # pkg:gem/appsignal#lib/appsignal/transaction/opentelemetry_backend.rb:311
  def headers_mapping; end

  # pkg:gem/appsignal#lib/appsignal/transaction/opentelemetry_backend.rb:283
  def params_mapping; end

  # pkg:gem/appsignal#lib/appsignal/transaction/opentelemetry_backend.rb:302
  def params_options; end

  # `opentelemetry_kind` is set at span creation (kind is immutable in OTel),
  # mirroring `start_event`. `nil` leaves the SDK default (INTERNAL).
  #
  # pkg:gem/appsignal#lib/appsignal/transaction/opentelemetry_backend.rb:180
  def record_event(name, title, body, body_format, duration, opentelemetry_kind: T.unsafe(nil), opentelemetry_scope: T.unsafe(nil), opentelemetry_attributes: T.unsafe(nil)); end

  # pkg:gem/appsignal#lib/appsignal/transaction/opentelemetry_backend.rb:208
  def set_action(action); end

  # Sets OpenTelemetry attributes on AppSignal's current span -- the open
  # event span, or the root span when no event is open. This is how an
  # integration describes what it instrumented in OpenTelemetry's own terms,
  # such as `db.system.name` on a database query.
  #
  # Never the OTel current span, which may belong to another
  # instrumentation. Values are coerced to the primitives OTLP accepts.
  #
  # pkg:gem/appsignal#lib/appsignal/transaction/opentelemetry_backend.rb:259
  def set_attributes(attributes); end

  # Records the error as an `exception` event on AppSignal's current span --
  # the open event span, or the root -- so it attaches to the operation that
  # raised it. `appsignal.alert_this_error` tells the collector to report it
  # even on a child span.
  #
  # Causes ride on one `appsignal.error_causes` JSON attribute, whose keys
  # match the processor's `ErrorSubCause`. Separate cause events would each
  # become their own incident. Each cause carries only the part of its
  # backtrace that is not shared (see `trim_shared_tail`).
  #
  # pkg:gem/appsignal#lib/appsignal/transaction/opentelemetry_backend.rb:365
  def set_error(class_name, message, backtrace, causes, _root_cause_missing); end

  # Transaction metadata (request path, method, ...) has no dedicated OTel
  # attribute, but it is the same shape as tags and the collector/trace UI
  # already surface `appsignal.tag.*`, so emit metadata as a tag.
  #
  # pkg:gem/appsignal#lib/appsignal/transaction/opentelemetry_backend.rb:248
  def set_metadata(key, value); end

  # pkg:gem/appsignal#lib/appsignal/transaction/opentelemetry_backend.rb:218
  def set_namespace(namespace); end

  # Queue start has no OTel-native home, so surface it two ways: an
  # `appsignal.queue_start` event on the root span (per-trace timeline) and,
  # at completion, a `transaction_queue_duration` metric (the aggregate
  # graph). Like the agent, we record the delta and never shift span timing.
  #
  # The queue start time becomes the event's timestamp (events carry their
  # own time), so it is not duplicated as an attribute.
  #
  # pkg:gem/appsignal#lib/appsignal/transaction/opentelemetry_backend.rb:235
  def set_queue_start(start); end

  # Routes each sample-data category to the attribute the collector reads.
  # The params arrive on one of three channels: `request_payload` (web),
  # `function_parameters` (jobs) and `query_parameters` (a request's query
  # string), each its own attribute. The other JSON-blob
  # categories (session, custom data) are serialized as JSON; `environment`
  # becomes request-header attributes; tags fan out to `appsignal.tag.*`.
  # Unknown keys pass through as `appsignal.<key>` JSON so nothing is lost.
  # Breadcrumbs never reach here (the backend emits them as span events);
  # causes ride on the exception event (see #set_error).
  #
  # pkg:gem/appsignal#lib/appsignal/transaction/opentelemetry_backend.rb:333
  def set_sample_data(key, data); end

  # `opentelemetry_kind` (e.g. `:client` for an outgoing HTTP request) is set
  # at span creation because OTel span kind is immutable afterwards. `nil`
  # leaves the SDK default (INTERNAL).
  #
  # pkg:gem/appsignal#lib/appsignal/transaction/opentelemetry_backend.rb:158
  def start_event(opentelemetry_kind: T.unsafe(nil), opentelemetry_scope: T.unsafe(nil)); end

  # Each error is recorded eagerly as its own `exception` event on the span
  # current when it was added, so a trace holds many errors and the
  # Transaction never duplicates itself -- which is why `duplicate` is left
  # unimplemented (see BaseBackend).
  #
  # pkg:gem/appsignal#lib/appsignal/transaction/opentelemetry_backend.rb:471
  def supports_multiple_errors?; end

  # Returned so `Transaction#to_h` (`JSON.parse(@backend.to_json)`) yields an
  # empty Hash. Collector mode asserts on emitted spans, not `to_h`.
  #
  # pkg:gem/appsignal#lib/appsignal/transaction/opentelemetry_backend.rb:477
  def to_json; end

  private

  # The allocation counter is thread-local and only ever increases, so a
  # negative delta means the transaction or event finished on a different
  # thread than it started on. The count is then meaningless, so warn and
  # tell the caller to drop it rather than report a wrong value.
  #
  # pkg:gem/appsignal#lib/appsignal/transaction/opentelemetry_backend.rb:622
  def allocation_count_reversed?(delta); end

  # Allocation tracking runs only when enabled by config and not on JRuby,
  # matching the condition under which `Appsignal.start` installs the
  # allocation event hook that feeds the counter.
  #
  # pkg:gem/appsignal#lib/appsignal/transaction/opentelemetry_backend.rb:645
  def allocation_tracking?; end

  # The thread's cumulative object allocation count, or nil when allocation
  # tracking is off. Callers snapshot this at a start boundary and subtract
  # it from a later read to get the allocations made in between; a nil
  # snapshot disables allocation reporting for that transaction or event.
  #
  # pkg:gem/appsignal#lib/appsignal/transaction/opentelemetry_backend.rb:638
  def current_allocation_count; end

  # The open event span, or the root span when no event is open. Not the OTel
  # current span, which may belong to another instrumentation.
  #
  # pkg:gem/appsignal#lib/appsignal/transaction/opentelemetry_backend.rb:677
  def current_span; end

  # pkg:gem/appsignal#lib/appsignal/transaction/opentelemetry_backend.rb:756
  def display_namespace(namespace); end

  # Emits the queue duration as a distribution metric in both the
  # per-namespace and per-namespace-and-host series the queue-time graph
  # reads. Nothing downstream fans these out, so emit both ourselves.
  #
  # pkg:gem/appsignal#lib/appsignal/transaction/opentelemetry_backend.rb:538
  def emit_queue_duration_metric; end

  # pkg:gem/appsignal#lib/appsignal/transaction/opentelemetry_backend.rb:651
  def hostname; end

  # Whether a formatted attributes hash names a real `db.system.name`,
  # as opposed to merely having the key. `Attributes.format` coerces an
  # explicit `nil` (or any other non-primitive) to `""`, so the key can
  # be present with a blank value. A blank value must not count as set:
  # it would block the SQL sentinel the same way a real value should,
  # but leave the span with nothing the collector's sanitizer
  # recognizes, instead of the sentinel that keeps sanitization on.
  #
  # pkg:gem/appsignal#lib/appsignal/transaction/opentelemetry_backend.rb:847
  def named_db_system?(formatted_attributes); end

  # The first caller frame outside the gem: where the invalid value was
  # passed to `Transaction.create`, `Appsignal.monitor`, etc. Falls back to
  # the immediate caller if every frame is inside the gem. Only walks the
  # stack when a warning is actually emitted (see `validated_option`).
  #
  # pkg:gem/appsignal#lib/appsignal/transaction/opentelemetry_backend.rb:751
  def option_caller_location; end

  # pkg:gem/appsignal#lib/appsignal/transaction/opentelemetry_backend.rb:687
  def placeholder_span_name(namespace); end

  # Pushes an open event onto the stack, snapshotting the allocation counter
  # so `finish_event` can measure the event's allocations as the delta since.
  #
  # pkg:gem/appsignal#lib/appsignal/transaction/opentelemetry_backend.rb:683
  def push_event(span, token); end

  # Sets the transaction's allocation counts on the root span, and, when the
  # transaction has an action to group by, emits the total as a counter
  # metric. The counter is read once so the attributes and the metric share
  # the same value.
  #
  # The root's total is `appsignal.transaction_allocation_count`, named apart
  # from an event's `appsignal.allocation_count` because it resets per
  # transaction: it is the whole that a span's `self_allocation_count` is a
  # part of, including across a distributed trace.
  #
  # The metric is emitted in both the per-namespace and
  # per-namespace-and-action series the allocation graph reads, as a counter,
  # never host-tagged. Nothing downstream fans these out.
  #
  # pkg:gem/appsignal#lib/appsignal/transaction/opentelemetry_backend.rb:567
  def report_allocation_count; end

  # Decides what to do about a transaction that never set an action, which
  # has nothing to group by. Collector mode cannot represent "no action", so
  # it needs a name for the ones it reports and a way to drop the rest.
  #
  # A reported one is named after the marker. Leaving the action unset would
  # not report nothing: the collector fills an empty action in from the span
  # name, which here is the placeholder this backend opened the span with,
  # and that reads as though it were the application's own action.
  #
  # The rest are noise, such as serving assets in development, so their
  # subtrace is flagged for the collector to drop, the same way `discard`
  # does.
  #
  # Both branches have to run before `teardown` finishes the span, because
  # attributes set on an ended span are dropped.
  #
  # pkg:gem/appsignal#lib/appsignal/transaction/opentelemetry_backend.rb:525
  def resolve_missing_action; end

  # pkg:gem/appsignal#lib/appsignal/transaction/opentelemetry_backend.rb:760
  def service_namespace; end

  # Whether this transaction is reported at all. One that set an action is
  # reported so it can be grouped under it. One that recorded an error is
  # reported even without an action, because the failure is worth reporting
  # even when we cannot say what failed. The agent draws the line in the
  # same place: it drops a transaction only when it has neither.
  #
  # pkg:gem/appsignal#lib/appsignal/transaction/opentelemetry_backend.rb:506
  def should_report?; end

  # Open the transaction's span, relating it to any incoming trace context
  # by the requested relationship:
  #
  # - `:parent`: parent under the remote span so the transaction continues
  #   the upstream trace.
  # - `:link`: start a fresh trace linked back to the remote span. The
  #   transaction is its own unit of work decoupled from the caller, so it
  #   gets its own trace, with a link recording the causal relationship.
  # - `:both`: parent under the remote span and also link back to it, so the
  #   transaction continues the trace and keeps the explicit link.
  # - `:none`: a plain root span that ignores any incoming context.
  #
  # With no context or an invalid remote span, every relationship falls back
  # to a plain root span, since there is nothing to parent or link to.
  #
  # pkg:gem/appsignal#lib/appsignal/transaction/opentelemetry_backend.rb:705
  def start_transaction_span(namespace, kind, relationship, opentelemetry_context); end

  # Detaches the OTel context and finishes the root span. Idempotent: the
  # Transaction can complete directly and again via a cleanup path, and
  # re-detaching/re-finishing an ended span would error.
  #
  # pkg:gem/appsignal#lib/appsignal/transaction/opentelemetry_backend.rb:486
  def teardown; end

  # Resolve the tracer for an instrumentation scope. `scope` is a
  # `[name, version]` pair supplied by the integration that created the
  # span, or nil. A nil scope, a nil/blank name, or a nil version each fall
  # back to the default AppSignal scope, so every span always carries a
  # scope (the collector drops scope-less spans). The tracer provider caches
  # tracers by `(name, version)`, so this resolves rather than rebuilds.
  #
  # pkg:gem/appsignal#lib/appsignal/transaction/opentelemetry_backend.rb:661
  def tracer_for(scope); end

  # Returns the leading lines of a cause's backtrace that the reported
  # error's backtrace does not already end with, and how many trailing lines
  # were dropped to get there.
  #
  # A cause shares its trailing frames with the error it led to, and those
  # are already sent in `exception.stacktrace`. Repeating them for every
  # cause makes `appsignal.error_causes` too long for the collector to read.
  #
  # If every line is shared, one is kept, because a cause with no lines
  # leaves the UI nothing to show. That kept line does not count as dropped.
  #
  # pkg:gem/appsignal#lib/appsignal/transaction/opentelemetry_backend.rb:798
  def trim_shared_tail(cause_lines, error_lines); end

  # Returns the given option when it is one of the allowed values, the
  # default when it is nil, or the default with a warning when it is an
  # unknown value. Keeps an unexpected `opentelemetry_kind` from raising
  # inside span creation, and an unexpected `opentelemetry_relationship`
  # from silently dropping the incoming context.
  #
  # pkg:gem/appsignal#lib/appsignal/transaction/opentelemetry_backend.rb:731
  def validated_option(value, allowed, default, name); end

  # Sets a finished event's allocation counts and rolls its full count up to
  # its parent. `appsignal.allocation_count` covers the event's whole
  # subtree; `appsignal.self_allocation_count` excludes its children, so
  # allocations can be attributed to a layer without walking the span tree.
  #
  # Only the immediate parent is updated, because each event's full count
  # already includes its whole subtree. Nothing is set when allocation
  # tracking is off.
  #
  # pkg:gem/appsignal#lib/appsignal/transaction/opentelemetry_backend.rb:599
  def write_event_allocation_count(frame); end

  # pkg:gem/appsignal#lib/appsignal/transaction/opentelemetry_backend.rb:823
  def write_event_body_attributes(span, body, body_format, db_system_name_set); end

  # The OTel span name is what the collector surfaces as the event's
  # label in the trace UI. The AS::N `name` (e.g. "sql.active_record")
  # always leads the span name so it stays visible. When a formatter
  # supplied a human-readable `title` (e.g. "User Load", "GET
  # https://example.com"), it follows in parentheses, giving
  # "sql.active_record (User Load)". Some integrations pass the event
  # name as the title as well; in that case the name is not repeated.
  #
  # pkg:gem/appsignal#lib/appsignal/transaction/opentelemetry_backend.rb:818
  def write_event_span_name(span, name, title); end

  # pkg:gem/appsignal#lib/appsignal/transaction/opentelemetry_backend.rb:770
  def write_request_environment(environment); end

  # pkg:gem/appsignal#lib/appsignal/transaction/opentelemetry_backend.rb:764
  def write_request_headers(headers); end

  # Each tag becomes its own `appsignal.tag.<key>` attribute, which the
  # collector hoists and the trace UI lists under "Tags". `sanitized_tags`
  # already restricts values to String/Symbol/Integer/boolean; OTel
  # attribute values must be primitives, so coerce the Symbol case to a
  # string (the only non-primitive that survives sanitization).
  #
  # pkg:gem/appsignal#lib/appsignal/transaction/opentelemetry_backend.rb:781
  def write_tags(tags); end

  class << self
    # @!visibility private
    # Resets the warn-once state. Only used to keep test runs isolated.
    #
    # pkg:gem/appsignal#lib/appsignal/transaction/opentelemetry_backend.rb:45
    def clear_warned!; end

    # Logs the block's message the first time it sees `key`, then stays quiet
    # for that key for the rest of the process. Used for warnings that would
    # otherwise repeat on every transaction. The message is built lazily, so
    # a deduplicated call skips building it. The check-and-set is locked so
    # concurrent transactions cannot both warn.
    #
    # pkg:gem/appsignal#lib/appsignal/transaction/opentelemetry_backend.rb:34
    def warn_once(key); end

    private

    # pkg:gem/appsignal#lib/appsignal/transaction/opentelemetry_backend.rb:51
    def warned_keys; end
  end
end

# How the transaction's span relates to an incoming OpenTelemetry context
# when none is given. A web request continues the upstream trace, so
# parenting is the safe default.
#
# pkg:gem/appsignal#lib/appsignal/transaction/opentelemetry_backend.rb:68
Appsignal::Transaction::OpenTelemetryBackend::DEFAULT_RELATIONSHIP = T.let(T.unsafe(nil), Symbol)

# Collector treats SERVER/CONSUMER spans as subtrace roots; SERVER is the
# safe default when no kind is given (a transaction is almost always an
# external-triggered unit of work).
#
# pkg:gem/appsignal#lib/appsignal/transaction/opentelemetry_backend.rb:59
Appsignal::Transaction::OpenTelemetryBackend::DEFAULT_SPAN_KIND = T.let(T.unsafe(nil), Symbol)

# The collector expects "web"/"background"; the agent's processor converts
# these internal namespaces in agent mode, but nothing does in collector
# mode. Other namespaces pass through unchanged.
#
# pkg:gem/appsignal#lib/appsignal/transaction/opentelemetry_backend.rb:78
Appsignal::Transaction::OpenTelemetryBackend::DISPLAY_NAMESPACE = T.let(T.unsafe(nil), Hash)

# Placeholder name an event span carries between `start_event` and
# `finish_event`. `finish_event` overwrites it with the AS::N event name,
# so it only surfaces when `complete` has to drain a span that was started
# but never finished. It is deliberately an obvious placeholder rather
# than a plausible event name, so such a span reads as the unfinished
# event it is and is not mistaken for a real one.
#
# pkg:gem/appsignal#lib/appsignal/transaction/opentelemetry_backend.rb:89
Appsignal::Transaction::OpenTelemetryBackend::EVENT_SPAN_PLACEHOLDER_NAME = T.let(T.unsafe(nil), String)

# One open event on the event stack. Holds the OpenTelemetry span and the
# context token attached for it, plus the allocation bookkeeping for the
# event. `allocation_start` is the allocation counter when the event began
# (nil when allocation tracking is off), and `child_allocation_count`
# accumulates the full allocation counts of the event's finished children,
# so the event's own allocations are `full - child_allocation_count`.
# `db_system_name_set` tracks whether the event itself already set
# `db.system.name` (through `set_attributes`) before it finishes, so the
# SQL sentinel written at finish only fills in a value that is missing.
#
# pkg:gem/appsignal#lib/appsignal/transaction/opentelemetry_backend.rb:110
class Appsignal::Transaction::OpenTelemetryBackend::EventFrame < ::Struct
  # pkg:gem/appsignal#lib/appsignal/transaction/opentelemetry_backend.rb:110
  def allocation_start; end

  # pkg:gem/appsignal#lib/appsignal/transaction/opentelemetry_backend.rb:110
  def allocation_start=(_); end

  # pkg:gem/appsignal#lib/appsignal/transaction/opentelemetry_backend.rb:110
  def child_allocation_count; end

  # pkg:gem/appsignal#lib/appsignal/transaction/opentelemetry_backend.rb:110
  def child_allocation_count=(_); end

  # pkg:gem/appsignal#lib/appsignal/transaction/opentelemetry_backend.rb:110
  def db_system_name_set; end

  # pkg:gem/appsignal#lib/appsignal/transaction/opentelemetry_backend.rb:110
  def db_system_name_set=(_); end

  # pkg:gem/appsignal#lib/appsignal/transaction/opentelemetry_backend.rb:110
  def span; end

  # pkg:gem/appsignal#lib/appsignal/transaction/opentelemetry_backend.rb:110
  def span=(_); end

  # pkg:gem/appsignal#lib/appsignal/transaction/opentelemetry_backend.rb:110
  def token; end

  # pkg:gem/appsignal#lib/appsignal/transaction/opentelemetry_backend.rb:110
  def token=(_); end

  class << self
    # pkg:gem/appsignal#lib/appsignal/transaction/opentelemetry_backend.rb:110
    def [](*_arg0); end

    # pkg:gem/appsignal#lib/appsignal/transaction/opentelemetry_backend.rb:110
    def inspect; end

    # pkg:gem/appsignal#lib/appsignal/transaction/opentelemetry_backend.rb:110
    def keyword_init?; end

    # pkg:gem/appsignal#lib/appsignal/transaction/opentelemetry_backend.rb:110
    def members; end

    # pkg:gem/appsignal#lib/appsignal/transaction/opentelemetry_backend.rb:110
    def new(*_arg0); end
  end
end

# pkg:gem/appsignal#lib/appsignal/transaction/opentelemetry_backend.rb:315
Appsignal::Transaction::OpenTelemetryBackend::HEADERS_ALLOWLIST = T.let(T.unsafe(nil), Hash)

# pkg:gem/appsignal#lib/appsignal/transaction/opentelemetry_backend.rb:306
Appsignal::Transaction::OpenTelemetryBackend::HEADERS_MAPPING = T.let(T.unsafe(nil), Hash)

# The collector keeps the request payload, the function parameters and the
# query parameters as separate attributes, so each gets its own bucket.
# Legacy `params` has no channel of its own, so it maps to the request
# payload (the web/server default), matching how the span kind defaults to
# `:server`.
#
# pkg:gem/appsignal#lib/appsignal/transaction/opentelemetry_backend.rb:276
Appsignal::Transaction::OpenTelemetryBackend::PARAMS_MAPPING = T.let(T.unsafe(nil), Hash)

# pkg:gem/appsignal#lib/appsignal/transaction/opentelemetry_backend.rb:287
Appsignal::Transaction::OpenTelemetryBackend::PARAMS_OPTIONS = T.let(T.unsafe(nil), Hash)

# Epoch-ms floor (~year 2000) below which a queue start is ignored. Mirrors
# the agent's `set_queue_start` (ext `transaction.rs`), which only records a
# queue duration when `queue_start_ms > 946_681_200_000`.
#
# pkg:gem/appsignal#lib/appsignal/transaction/opentelemetry_backend.rb:99
Appsignal::Transaction::OpenTelemetryBackend::QUEUE_START_MIN = T.let(T.unsafe(nil), Integer)

# How the transaction's span may relate to an incoming context. An unknown
# value would silently behave like `:none`, so it falls back to the
# default instead.
#
# pkg:gem/appsignal#lib/appsignal/transaction/opentelemetry_backend.rb:73
Appsignal::Transaction::OpenTelemetryBackend::RELATIONSHIPS = T.let(T.unsafe(nil), Array)

# The span kinds a transaction may take. An unknown value would raise
# inside OpenTelemetry span creation, so it falls back to the default.
#
# pkg:gem/appsignal#lib/appsignal/transaction/opentelemetry_backend.rb:63
Appsignal::Transaction::OpenTelemetryBackend::SPAN_KINDS = T.let(T.unsafe(nil), Array)

# Sentinel value the AppSignal collector recognizes as "a SQL system
# we don't know the specific dialect of" — sufficient to trigger SQL
# sanitization on `db.query.text`.
#
# pkg:gem/appsignal#lib/appsignal/transaction/opentelemetry_backend.rb:94
Appsignal::Transaction::OpenTelemetryBackend::SQL_DB_SYSTEM = T.let(T.unsafe(nil), String)

# pkg:gem/appsignal#lib/appsignal/transaction/opentelemetry_backend.rb:15
Appsignal::Transaction::OpenTelemetryBackend::TRACER_NAME = T.let(T.unsafe(nil), String)

# The action name given to a transaction that recorded an error without
# ever setting one. Bracketed so it reads as a marker rather than as a
# class the application defines, and so it sorts apart from real action
# names.
#
# pkg:gem/appsignal#lib/appsignal/transaction/opentelemetry_backend.rb:21
Appsignal::Transaction::OpenTelemetryBackend::UNNAMED_ACTION = T.let(T.unsafe(nil), String)

# Guards the process-wide warn-once state, which transactions touch
# concurrently on threaded servers. A constant so it is created once at
# load time rather than lazily (which would race).
#
# pkg:gem/appsignal#lib/appsignal/transaction/opentelemetry_backend.rb:26
Appsignal::Transaction::OpenTelemetryBackend::WARN_ONCE_LOCK = T.let(T.unsafe(nil), Thread::Mutex)

# pkg:gem/appsignal#lib/appsignal/transaction.rb:1152
Appsignal::Transaction::PARAMS_CHANNEL_ALIASES = T.let(T.unsafe(nil), Hash)

# Guards the process-wide `add_params`/`set_params` deprecation warn-once
# flag, which transactions touch concurrently on threaded servers. A
# constant so it is created once at load time rather than lazily.
# @!visibility private
#
# pkg:gem/appsignal#lib/appsignal/transaction.rb:29
Appsignal::Transaction::PARAMS_DEPRECATION_LOCK = T.let(T.unsafe(nil), Thread::Mutex)

# @!visibility private
#
# pkg:gem/appsignal#lib/appsignal/transmitter.rb:11
class Appsignal::Transmitter
  # @param base_uri [String] Base URI for the transmitter to use. If a full
  #   URI is given (including the HTTP protocol) it is used as the full base.
  #   If only a path is given the `config[:endpoint]` is prefixed along with
  #   `/1/` (API v1 endpoint).
  # @param config [Appsignal::Config] AppSignal configuration to use for this
  #   transmission.
  #
  # pkg:gem/appsignal#lib/appsignal/transmitter.rb:35
  def initialize(base_uri, config = T.unsafe(nil)); end

  # pkg:gem/appsignal#lib/appsignal/transmitter.rb:27
  def base_uri; end

  # pkg:gem/appsignal#lib/appsignal/transmitter.rb:27
  def config; end

  # pkg:gem/appsignal#lib/appsignal/transmitter.rb:57
  def transmit(payload, format: T.unsafe(nil)); end

  # pkg:gem/appsignal#lib/appsignal/transmitter.rb:45
  def uri; end

  private

  # pkg:gem/appsignal#lib/appsignal/transmitter.rb:71
  def content_type_for(format); end

  # pkg:gem/appsignal#lib/appsignal/transmitter.rb:82
