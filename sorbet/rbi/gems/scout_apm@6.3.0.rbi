# pkg:gem/scout_apm#lib/scout_apm/scored_item_set.rb:8
class ScoutApm::ScoredItemSet
  include ::Enumerable

  # pkg:gem/scout_apm#lib/scout_apm/scored_item_set.rb:20
  def initialize(max_size = T.unsafe(nil)); end

  # This function is a large if statement, with a few branches. See inline comments for each branch.
  #
  # pkg:gem/scout_apm#lib/scout_apm/scored_item_set.rb:32
  def <<(new_item); end

  # pkg:gem/scout_apm#lib/scout_apm/scored_item_set.rb:71
  def ==(other); end

  # pkg:gem/scout_apm#lib/scout_apm/scored_item_set.rb:25
  def each; end

  # Equal to another set only if exactly the same set of items is inside
  #
  # pkg:gem/scout_apm#lib/scout_apm/scored_item_set.rb:67
  def eql?(other); end

  # pkg:gem/scout_apm#lib/scout_apm/scored_item_set.rb:18
  def items; end

  # pkg:gem/scout_apm#lib/scout_apm/scored_item_set.rb:17
  def max_size; end

  private

  # pkg:gem/scout_apm#lib/scout_apm/scored_item_set.rb:75
  def full?; end

  # pkg:gem/scout_apm#lib/scout_apm/scored_item_set.rb:79
  def store!(new_item); end
end

# A number larger than any score we will actually get.
#
# pkg:gem/scout_apm#lib/scout_apm/scored_item_set.rb:12
ScoutApm::ScoredItemSet::ARBITRARILY_LARGE = T.let(T.unsafe(nil), Integer)

# Without otherwise saying, default the size to this
#
# pkg:gem/scout_apm#lib/scout_apm/scored_item_set.rb:15
ScoutApm::ScoredItemSet::DEFAULT_MAX_SIZE = T.let(T.unsafe(nil), Integer)

