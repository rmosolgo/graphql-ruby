# We insert this middleware into the Sidekiq stack, to capture each job,
# and time them.
#
# pkg:gem/scout_apm#lib/scout_apm/background_job_integrations/sidekiq.rb:51
class ScoutApm::BackgroundJobIntegrations::SidekiqMiddleware
  # pkg:gem/scout_apm#lib/scout_apm/background_job_integrations/sidekiq.rb:139
  def add_context!(msg, class_name); end

  # pkg:gem/scout_apm#lib/scout_apm/background_job_integrations/sidekiq.rb:52
  def call(_worker, msg, queue); end

  # pkg:gem/scout_apm#lib/scout_apm/background_job_integrations/sidekiq.rb:135
  def capture_job_args?; end

  # Check, if a key should be filtered
  #
  # pkg:gem/scout_apm#lib/scout_apm/background_job_integrations/sidekiq.rb:218
  def filter_key?(key); end

  # Replaces parameter values with a string / set in config file
  #
  # pkg:gem/scout_apm#lib/scout_apm/background_job_integrations/sidekiq.rb:196
  def filter_params(params); end

  # pkg:gem/scout_apm#lib/scout_apm/background_job_integrations/sidekiq.rb:213
  def filter_value?(value); end

  # TODO: Flip this over to use a new class like filtered exceptions? Some shared logic between
  # this and the error service.
  #
  # pkg:gem/scout_apm#lib/scout_apm/background_job_integrations/sidekiq.rb:230
  def filtered_params_config; end

  # Capturing the class name is a little tricky, since we need to handle several cases:
  # 1. ActiveJob, with the class in the key 'wrapped'
  # 2. ActiveJob, but the 'wrapped' key is wrong (due to YAJL serializing weirdly), find it in args.job_class
  # 3. DelayedJob wrapper, deserializing using YAML into the real object, which can be introspected
  # 4. No wrapper, just sidekiq's class
  #
  # pkg:gem/scout_apm#lib/scout_apm/background_job_integrations/sidekiq.rb:98
  def job_class(msg); end

  # pkg:gem/scout_apm#lib/scout_apm/background_job_integrations/sidekiq.rb:173
  def latency(msg, time = T.unsafe(nil)); end

  # pkg:gem/scout_apm#lib/scout_apm/background_job_integrations/sidekiq.rb:224
  def params_to_filter; end

  # pkg:gem/scout_apm#lib/scout_apm/background_job_integrations/sidekiq.rb:234
  def rails_filtered_params; end

  class << self
    # pkg:gem/scout_apm#lib/scout_apm/background_job_integrations/sidekiq.rb:75
    def sidekiq_version_8?; end
  end
end

# This name was changed in Sidekiq 8
