# pkg:gem/scout_apm#lib/scout_apm/server_integrations/puma.rb:3
class ScoutApm::ServerIntegrations::Puma
  # pkg:gem/scout_apm#lib/scout_apm/server_integrations/puma.rb:6
  def initialize(logger); end

  # pkg:gem/scout_apm#lib/scout_apm/server_integrations/puma.rb:14
  def forking?; end

  # pkg:gem/scout_apm#lib/scout_apm/server_integrations/puma.rb:83
  def found?; end

  # Puma::UserFileDefaultOptions exposes `options` based on three underlying
  # hashes: user_options, file_options, and default_options. While getting an `options`
  # key consults all three underlying hashes, setting an `options` key only sets the
  # user_options hash:
  #
  #    def [](key)
  #      fetch(key)
  #    end
  #
  #    def []=(key, value)
  #      user_options[key] = value
  #    end
  #
  #    def fetch(key, default_value = nil)
  #      return user_options[key]    if user_options.key?(key)
  #      return file_options[key]    if file_options.key?(key)
  #      return default_options[key] if default_options.key?(key)
  #
  #      default_value
  #    end
  #
  # Because of this, we can't read options[:before_worker_boot], modify, and then re-set
  # options[:before_worker_boot], since doing so could cause duplication if `before_worker_boot`
  # exists on the other two underlying hashes (file_options, default_options).
  #
  # To get around this, we explicitly read from `user_options` only, and still set using `options[]=`,
  # which Puma allows for setting `user_options`.
  #
  # pkg:gem/scout_apm#lib/scout_apm/server_integrations/puma.rb:54
  def install; end

  # pkg:gem/scout_apm#lib/scout_apm/server_integrations/puma.rb:4
  def logger; end

  # pkg:gem/scout_apm#lib/scout_apm/server_integrations/puma.rb:10
  def name; end

  # pkg:gem/scout_apm#lib/scout_apm/server_integrations/puma.rb:22
  def present?; end
end

