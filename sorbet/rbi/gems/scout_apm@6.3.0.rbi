# pkg:gem/scout_apm#lib/scout_apm/context.rb:7
class ScoutApm::Context
  # pkg:gem/scout_apm#lib/scout_apm/context.rb:12
  def initialize(context); end

  # Add context
  # ScoutApm::Context.add(account: current_account.name)
  #
  # pkg:gem/scout_apm#lib/scout_apm/context.rb:43
  def add(hash); end

  # pkg:gem/scout_apm#lib/scout_apm/context.rb:47
  def add_user(hash); end

  # pkg:gem/scout_apm#lib/scout_apm/context.rb:8
  def context; end

  # pkg:gem/scout_apm#lib/scout_apm/context.rb:18
  def logger; end

  # pkg:gem/scout_apm#lib/scout_apm/context.rb:28
  def to_flat_hash; end

  # Generates a hash representation of the Context.
  # Example: {:monthly_spend => 100, :user => {:ip => '127.0.0.1'}}
  #
  # pkg:gem/scout_apm#lib/scout_apm/context.rb:24
  def to_hash; end

  private

  # for consistently with #value_valid?, takes a hash eventhough the value isn't yet used.
  #
  # pkg:gem/scout_apm#lib/scout_apm/context.rb:107
  def key_valid?(key_value); end

  # pkg:gem/scout_apm#lib/scout_apm/context.rb:63
  def update_context(attr, hash); end

  # Returns true if the obj is one of the provided valid classes.
  #
  # pkg:gem/scout_apm#lib/scout_apm/context.rb:81
  def valid_type?(classes, obj); end

  # take the entire Hash vs. just the value so the logger output is more helpful on error.
  #
  # pkg:gem/scout_apm#lib/scout_apm/context.rb:93
  def value_valid?(key_value); end

  class << self
    # Convenience accessor so you can just call @ScoutAPM::Context#add@
    #
    # pkg:gem/scout_apm#lib/scout_apm/context.rb:52
    def add(hash); end

    # Convenience accessor so you can just call @ScoutAPM::Context#add_user@
    #
    # pkg:gem/scout_apm#lib/scout_apm/context.rb:57
    def add_user(hash); end

    # pkg:gem/scout_apm#lib/scout_apm/context.rb:37
    def current; end
  end
end

