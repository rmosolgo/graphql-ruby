# pkg:gem/scout_apm#lib/scout_apm/extensions/config.rb:2
module ScoutApm::Extensions; end

# !!! Extensions are a 0.x level API and breakage is expected as the API is refined.
# Extensions fan out data collected by the agent to additional services.
#
# pkg:gem/scout_apm#lib/scout_apm/extensions/config.rb:5
class ScoutApm::Extensions::Config
  # pkg:gem/scout_apm#lib/scout_apm/extensions/config.rb:33
  def initialize(agent_context); end

  # pkg:gem/scout_apm#lib/scout_apm/extensions/config.rb:6
  def agent_context; end

  # pkg:gem/scout_apm#lib/scout_apm/extensions/config.rb:81
  def logger; end

  # pkg:gem/scout_apm#lib/scout_apm/extensions/config.rb:8
  def periodic_callbacks; end

  # pkg:gem/scout_apm#lib/scout_apm/extensions/config.rb:8
  def periodic_callbacks=(_arg0); end

  # Runs each reporting period callback.
  # Each callback runs inside a begin/rescue block so a broken callback doesn't prevent other
  # callbacks from executing or reporting data from being sent.
  #
  # pkg:gem/scout_apm#lib/scout_apm/extensions/config.rb:42
  def run_periodic_callbacks(reporting_period, metadata); end

  # Runs each transaction callback.
  # Each callback runs inside a begin/rescue block so a broken callback doesn't prevent other
  # callbacks from executing or the transaction from being recorded.
  #
  # pkg:gem/scout_apm#lib/scout_apm/extensions/config.rb:59
  def run_transaction_callbacks(converter_results, context, scope_layer); end

  # pkg:gem/scout_apm#lib/scout_apm/extensions/config.rb:7
  def transaction_callbacks; end

  # pkg:gem/scout_apm#lib/scout_apm/extensions/config.rb:7
  def transaction_callbacks=(_arg0); end

  class << self
    # Adds a callback that runs when the per-minute report data is sent to Scout.
    # These run in a background thread so external HTTP calls are OK.
    # +callback+ must be an object that responds to a +call(reporting_period, metadata)+ method.
    #
    # Example:
    # ScoutApm::Extensions::Config.add_periodic_callback(Proc.new { |reporting_period, metadata| ... })
    #
    # pkg:gem/scout_apm#lib/scout_apm/extensions/config.rb:29
    def add_periodic_callback(callback); end

    # Adds a new callback that runs after a transaction completes.
    # These run inline during the request and thus should add minimal overhead.
    # For example, a transaction callback should NOT make inline HTTP calls to outside services.
    # +callback+ must be an object that respond to a +call(payload)+ method.
    #
    # Example:
    # ScoutApm::Extensions::Config.add_transaction_callback(Proc.new { |payload| puts "Duration: #{payload.duration_ms}" })
    #
    # +payload+ is a +ScoutApm::Extensions::TransactionCallbackPayload+ object.
    #
    # pkg:gem/scout_apm#lib/scout_apm/extensions/config.rb:19
    def add_transaction_callback(callback); end

    # pkg:gem/scout_apm#lib/scout_apm/extensions/config.rb:77
    def agent_context; end
  end
end

# A +TransactionCallbackPayload+ is passed to each Transaction callback's +call+ method.
# It encapsulates the data about a specific transaction.
#
# pkg:gem/scout_apm#lib/scout_apm/extensions/transaction_callback_payload.rb:5
class ScoutApm::Extensions::TransactionCallbackPayload
  # pkg:gem/scout_apm#lib/scout_apm/extensions/transaction_callback_payload.rb:9
  def initialize(agent_context, converter_results, context, scope_layer); end

  # pkg:gem/scout_apm#lib/scout_apm/extensions/transaction_callback_payload.rb:44
  def app_name; end

  # A flat hash of the context associated w/this transaction (ie user ip and another other data added to context).
  #
  # pkg:gem/scout_apm#lib/scout_apm/extensions/transaction_callback_payload.rb:17
  def context; end

  # A Hash that stores the output of each layer converter by name. See the naming conventions in +TrackedRequest+.
  #
  # pkg:gem/scout_apm#lib/scout_apm/extensions/transaction_callback_payload.rb:7
  def converter_results; end

  # A Hash that stores the output of each layer converter by name. See the naming conventions in +TrackedRequest+.
  #
  # pkg:gem/scout_apm#lib/scout_apm/extensions/transaction_callback_payload.rb:7
  def converter_results=(_arg0); end

  # The total duration of the transaction
  #
  # pkg:gem/scout_apm#lib/scout_apm/extensions/transaction_callback_payload.rb:22
  def duration_ms; end

  # Returns +true+ if the transaction raised an exception.
  #
  # pkg:gem/scout_apm#lib/scout_apm/extensions/transaction_callback_payload.rb:49
  def error?; end

  # pkg:gem/scout_apm#lib/scout_apm/extensions/transaction_callback_payload.rb:40
  def hostname; end

  # The time in queue of the transaction in ms. If not present, +nil+ is returned as this is unknown.
  #
  # pkg:gem/scout_apm#lib/scout_apm/extensions/transaction_callback_payload.rb:27
  def queue_time_ms; end

  # pkg:gem/scout_apm#lib/scout_apm/extensions/transaction_callback_payload.rb:57
  def transaction_name; end

  # Web/Job are more language-agnostic names for controller/job. For example, Python Django does not have controllers.
  #
  # pkg:gem/scout_apm#lib/scout_apm/extensions/transaction_callback_payload.rb:62
  def transaction_type_slug; end

  # pkg:gem/scout_apm#lib/scout_apm/extensions/transaction_callback_payload.rb:53
  def transation_type; end
end

# pkg:gem/scout_apm#lib/scout_apm/external_service_metric_set.rb:3
class ScoutApm::ExternalServiceMetricSet
  include ::Enumerable

  # pkg:gem/scout_apm#lib/scout_apm/external_service_metric_set.rb:17
  def initialize(context); end

  # Add a single ExternalServiceMetricStats object to this set.
  #
  # Looks up an existing one under this key and merges, or just saves a new
  # one under the key
  #
  # pkg:gem/scout_apm#lib/scout_apm/external_service_metric_set.rb:54
  def <<(stat); end

  # pkg:gem/scout_apm#lib/scout_apm/external_service_metric_set.rb:91
  def at_limit?; end

  # Take another set, and merge it with this one
  #
  # pkg:gem/scout_apm#lib/scout_apm/external_service_metric_set.rb:43
  def combine!(other); end

  # Need to look this up again if we end up as nil. Which I guess can happen
  # after a Marshal load?
  #
  # pkg:gem/scout_apm#lib/scout_apm/external_service_metric_set.rb:26
  def context; end

  # pkg:gem/scout_apm#lib/scout_apm/external_service_metric_set.rb:30
  def each; end

  # pkg:gem/scout_apm#lib/scout_apm/external_service_metric_set.rb:66
  def increment_transaction_count!; end

  # pkg:gem/scout_apm#lib/scout_apm/external_service_metric_set.rb:85
  def inspect; end

  # Looks up a ExternalServiceMetricStats instance in the +@metrics+ hash. Sets the value to +other+ if no key
  # Returns a ExternalServiceMetricStats instance
  #
  # pkg:gem/scout_apm#lib/scout_apm/external_service_metric_set.rb:38
  def lookup(other); end

  # the raw metrics. You probably want #metrics_to_report
  #
  # pkg:gem/scout_apm#lib/scout_apm/external_service_metric_set.rb:8
  def marshal_dump; end

  # pkg:gem/scout_apm#lib/scout_apm/external_service_metric_set.rb:12
  def marshal_load(array); end

  # pkg:gem/scout_apm#lib/scout_apm/external_service_metric_set.rb:6
  def metrics; end

  # pkg:gem/scout_apm#lib/scout_apm/external_service_metric_set.rb:72
  def metrics_to_report; end
end

# pkg:gem/scout_apm#lib/scout_apm/external_service_metric_stats.rb:2
class ScoutApm::ExternalServiceMetricStats
  # pkg:gem/scout_apm#lib/scout_apm/external_service_metric_stats.rb:20
  def initialize(domain_name, operation, scope, call_count, call_time); end

  # pkg:gem/scout_apm#lib/scout_apm/external_service_metric_stats.rb:59
  def as_json; end

  # pkg:gem/scout_apm#lib/scout_apm/external_service_metric_stats.rb:12
  def call_count; end

  # pkg:gem/scout_apm#lib/scout_apm/external_service_metric_stats.rb:13
  def call_time; end

  # Combine data from another ExternalServiceMetricStats into +self+. Modifies and returns +self+
  #
  # pkg:gem/scout_apm#lib/scout_apm/external_service_metric_stats.rb:45
  def combine!(other); end

  # pkg:gem/scout_apm#lib/scout_apm/external_service_metric_stats.rb:6
  def domain_name; end

  # pkg:gem/scout_apm#lib/scout_apm/external_service_metric_stats.rb:18
  def histogram; end

  # Called by the Set on each ExternalServiceMetricStats object that it holds, only
  # once during the recording of a transaction.
  #
  # Don't call elsewhere, and don't set to 1 in the initializer.
  #
  # pkg:gem/scout_apm#lib/scout_apm/external_service_metric_stats.rb:81
  def increment_transaction_count!; end

  # Merge data in this scope. Used in ExternalServiceMetricSet
  #
  # pkg:gem/scout_apm#lib/scout_apm/external_service_metric_stats.rb:40
  def key; end

  # pkg:gem/scout_apm#lib/scout_apm/external_service_metric_stats.rb:16
  def max_call_time; end

  # pkg:gem/scout_apm#lib/scout_apm/external_service_metric_stats.rb:15
  def min_call_time; end

  # pkg:gem/scout_apm#lib/scout_apm/external_service_metric_stats.rb:7
  def operation; end

  # pkg:gem/scout_apm#lib/scout_apm/external_service_metric_stats.rb:8
  def scope; end

  # pkg:gem/scout_apm#lib/scout_apm/external_service_metric_stats.rb:10
  def transaction_count; end
end

