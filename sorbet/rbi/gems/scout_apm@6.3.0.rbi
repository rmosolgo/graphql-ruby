# pkg:gem/scout_apm#lib/scout_apm/reporter.rb:4
class ScoutApm::Reporter
  # pkg:gem/scout_apm#lib/scout_apm/reporter.rb:11
  def initialize(context, type, instant_key = T.unsafe(nil)); end

  # pkg:gem/scout_apm#lib/scout_apm/reporter.rb:61
  def can_report?; end

  # pkg:gem/scout_apm#lib/scout_apm/reporter.rb:17
  def config; end

  # pkg:gem/scout_apm#lib/scout_apm/reporter.rb:8
  def context; end

  # pkg:gem/scout_apm#lib/scout_apm/reporter.rb:9
  def instant_key; end

  # pkg:gem/scout_apm#lib/scout_apm/reporter.rb:21
  def logger; end

  # The fully serialized string payload to be sent
  #
  # pkg:gem/scout_apm#lib/scout_apm/reporter.rb:26
  def report(payload, headers = T.unsafe(nil)); end

  # pkg:gem/scout_apm#lib/scout_apm/reporter.rb:7
  def type; end

  # pkg:gem/scout_apm#lib/scout_apm/reporter.rb:43
  def uri(host); end

  private

  # pkg:gem/scout_apm#lib/scout_apm/reporter.rb:135
  def compress_payload(payload); end

  # Headers passed up with all API requests.
  #
  # pkg:gem/scout_apm#lib/scout_apm/reporter.rb:111
  def default_http_headers; end

  # Some posts (typically ones under development) bypass the ingestion
  # pipeline and go directly to the webserver. They use direct_host instead
  # of host
  #
  # pkg:gem/scout_apm#lib/scout_apm/reporter.rb:145
  def determine_hosts; end

  # Take care of the http proxy, if specified in config.
  # Given a blank string, the proxy_uri URI instance's host/port/user/pass will be nil.
  # Net::HTTP::Proxy returns a regular Net::HTTP class if the first argument (host) is nil.
  #
  # pkg:gem/scout_apm#lib/scout_apm/reporter.rb:121
  def http(url); end

  # pkg:gem/scout_apm#lib/scout_apm/reporter.rb:78
  def post(uri, body, headers = T.unsafe(nil)); end

  # pkg:gem/scout_apm#lib/scout_apm/reporter.rb:155
  def post_payload(hosts, payload, headers); end

  # pkg:gem/scout_apm#lib/scout_apm/reporter.rb:90
  def request(uri, &connector); end
end

# pkg:gem/scout_apm#lib/scout_apm/reporter.rb:5
ScoutApm::Reporter::VERIFY_MODE = T.let(T.unsafe(nil), Integer)

# pkg:gem/scout_apm#lib/scout_apm/reporting.rb:3
class ScoutApm::Reporting
  # pkg:gem/scout_apm#lib/scout_apm/reporting.rb:6
  def initialize(context); end

  # Before reporting, lookup metric_id for each MetricMeta. This speeds up
  # reporting on the server-side.
  #
  # pkg:gem/scout_apm#lib/scout_apm/reporting.rb:136
  def add_metric_ids(metrics); end

  # pkg:gem/scout_apm#lib/scout_apm/reporting.rb:4
  def context; end

  # pkg:gem/scout_apm#lib/scout_apm/reporting.rb:79
  def deliver_period(reporting_period, metadata); end

  # TODO: Move this into PayloadSerializer?
  # XXX: Remove non-json report format entirely
  #
  # pkg:gem/scout_apm#lib/scout_apm/reporting.rb:126
  def headers; end

  # pkg:gem/scout_apm#lib/scout_apm/reporting.rb:101
  def log_deliver(metrics, slow_transactions, metadata, jobs_traces, histograms); end

  # pkg:gem/scout_apm#lib/scout_apm/reporting.rb:10
  def logger; end

  # pkg:gem/scout_apm#lib/scout_apm/reporting.rb:68
  def metadata(reporting_period); end

  # The data moves through a treadmill of reporting, coordinating several Rails processes by using an external file.
  # * During the minute it is being recorded by the instruments, it gets
  #   recorded into the ram of each process (in the Store class).
  # * The minute after, each process writes its own metrics to a shared LayawayFile
  # * The minute after that, the first process to wake up pushes the combined
  #   data to the server, and wipes it. Next processes don't have anything to do.
  #
  # At any given point, there is data in each of those steps, moving its way through the process
  #
  # pkg:gem/scout_apm#lib/scout_apm/reporting.rb:26
  def process_metrics; end

  # In a running app, one process will get the period ready for delivery, the others will see 0.
  #
  # pkg:gem/scout_apm#lib/scout_apm/reporting.rb:40
  def report_to_server; end

  # pkg:gem/scout_apm#lib/scout_apm/reporting.rb:14
  def reporter; end
end

# pkg:gem/scout_apm#lib/scout_apm/request_histograms.rb:2
class ScoutApm::RequestHistograms
  # pkg:gem/scout_apm#lib/scout_apm/request_histograms.rb:16
  def initialize(histogram_size = T.unsafe(nil)); end

  # pkg:gem/scout_apm#lib/scout_apm/request_histograms.rb:33
  def add(item, value); end

  # pkg:gem/scout_apm#lib/scout_apm/request_histograms.rb:37
  def approximate_quantile_of_value(item, value); end

  # pkg:gem/scout_apm#lib/scout_apm/request_histograms.rb:25
  def as_json; end

  # pkg:gem/scout_apm#lib/scout_apm/request_histograms.rb:21
  def each_name; end

  # pkg:gem/scout_apm#lib/scout_apm/request_histograms.rb:14
  def histogram_size; end

  # pkg:gem/scout_apm#lib/scout_apm/request_histograms.rb:54
  def initialize_histograms_hash; end

  # pkg:gem/scout_apm#lib/scout_apm/request_histograms.rb:41
  def quantile(item, q); end

  # pkg:gem/scout_apm#lib/scout_apm/request_histograms.rb:50
  def raw(item); end

  # Wipes all histograms, setting them back to empty
  #
  # pkg:gem/scout_apm#lib/scout_apm/request_histograms.rb:46
  def reset_all!; end

  private

  # Private Accessor:
  # A hash of Endpoint Name to an approximate histogram
  #
  # Each time a new request is requested to see if it's slow or not, we
  # should insert it into the histogram, and get the approximate percentile
  # of that time
  #
  # pkg:gem/scout_apm#lib/scout_apm/request_histograms.rb:11
  def histograms; end
end

# pkg:gem/scout_apm#lib/scout_apm/request_histograms.rb:3
ScoutApm::RequestHistograms::DEFAULT_HISTOGRAM_SIZE = T.let(T.unsafe(nil), Integer)

