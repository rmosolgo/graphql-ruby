# to the real SQL, and an AR generated "name" for the Query
#
# pkg:gem/scout_apm#lib/scout_apm/instruments/active_record.rb:168
module ScoutApm::Instruments::ActiveRecordInstruments
  # pkg:gem/scout_apm#lib/scout_apm/instruments/active_record.rb:173
