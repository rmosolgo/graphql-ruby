  # pkg:gem/scout_apm#lib/scout_apm/histogram.rb:12
  def marshal_dump; end

  # pkg:gem/scout_apm#lib/scout_apm/histogram.rb:16
  def marshal_load(array); end

  # pkg:gem/scout_apm#lib/scout_apm/histogram.rb:8
  def max_bins; end

  # pkg:gem/scout_apm#lib/scout_apm/histogram.rb:79
  def mean; end

  # This class should be threadsafe.
  #
  # pkg:gem/scout_apm#lib/scout_apm/histogram.rb:6
  def mutex; end

  # pkg:gem/scout_apm#lib/scout_apm/histogram.rb:36
  def quantile(q); end

  # pkg:gem/scout_apm#lib/scout_apm/histogram.rb:10
  def total; end

  # pkg:gem/scout_apm#lib/scout_apm/histogram.rb:10
  def total=(_arg0); end

  private

  # If we exactly match an existing bin, add to it, otherwise create a new bin holding a count for the new value.
  #
  # pkg:gem/scout_apm#lib/scout_apm/histogram.rb:119
  def create_new_bin(new_value); end

  # pkg:gem/scout_apm#lib/scout_apm/histogram.rb:140
  def trim; end

  # pkg:gem/scout_apm#lib/scout_apm/histogram.rb:146
