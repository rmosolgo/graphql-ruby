class ScoutApm::StoreReportingPeriodTimestamp
  # pkg:gem/scout_apm#lib/scout_apm/store.rb:154
  def initialize(time = T.unsafe(nil)); end

  # pkg:gem/scout_apm#lib/scout_apm/store.rb:184
  def ==(o); end

  # pkg:gem/scout_apm#lib/scout_apm/store.rb:192
  def age_in_seconds; end

  # pkg:gem/scout_apm#lib/scout_apm/store.rb:180
  def eql?(o); end

  # pkg:gem/scout_apm#lib/scout_apm/store.rb:188
  def hash; end

  # pkg:gem/scout_apm#lib/scout_apm/store.rb:168
  def strftime(pattern = T.unsafe(nil)); end

  # pkg:gem/scout_apm#lib/scout_apm/store.rb:152
  def timestamp; end

  # pkg:gem/scout_apm#lib/scout_apm/store.rb:164
  def to_s; end

  # pkg:gem/scout_apm#lib/scout_apm/store.rb:176
  def to_time; end

  class << self
    # pkg:gem/scout_apm#lib/scout_apm/store.rb:159
    def minutes_ago(min, base_time = T.unsafe(nil)); end
  end
end

