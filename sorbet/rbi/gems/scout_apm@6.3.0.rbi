  # pkg:gem/scout_apm#lib/scout_apm/instruments/action_controller_rails_3_rails4.rb:16
  def installed?; end

  # pkg:gem/scout_apm#lib/scout_apm/instruments/action_controller_rails_3_rails4.rb:12
  def logger; end

  class << self
    # Returns a new anonymous module each time it is called. So
    # we can insert this multiple times into the ancestors
    # stack. Otherwise it only exists the first time you include it
