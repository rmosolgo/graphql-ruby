# Represents a random ID that we can use to track a certain transaction.
# The `trans` prefix is only for ease of reading logs - it should not be
# interpreted to convey any sort of meaning.
#
# pkg:gem/scout_apm#lib/scout_apm/utils/unique_id.rb:18
class ScoutApm::Utils::TransactionId
  # pkg:gem/scout_apm#lib/scout_apm/utils/unique_id.rb:19
  def initialize; end

  # pkg:gem/scout_apm#lib/scout_apm/utils/unique_id.rb:23
  def to_s; end
end

# pkg:gem/scout_apm#lib/scout_apm/utils/unique_id.rb:3
class ScoutApm::Utils::UniqueId
  class << self
    # pkg:gem/scout_apm#lib/scout_apm/utils/unique_id.rb:6
    def simple(length = T.unsafe(nil)); end
  end
end

# pkg:gem/scout_apm#lib/scout_apm/utils/unique_id.rb:4
ScoutApm::Utils::UniqueId::ALPHABET = T.let(T.unsafe(nil), Array)

