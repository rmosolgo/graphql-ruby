  # Given a value, where in this histogram does it fall?
  # Returns a float between 0 and 1
  #
  # pkg:gem/scout_apm#lib/scout_apm/histogram.rb:61
  def approximate_quantile_of_value(v); end

  # pkg:gem/scout_apm#lib/scout_apm/histogram.rb:105
  def as_json; end

  # pkg:gem/scout_apm#lib/scout_apm/histogram.rb:9
  def bins; end

  # pkg:gem/scout_apm#lib/scout_apm/histogram.rb:90
