# pkg:gem/scout_apm#lib/scout_apm/db_query_metric_set.rb:3
class ScoutApm::DbQueryMetricSet
  include ::Enumerable

  # pkg:gem/scout_apm#lib/scout_apm/db_query_metric_set.rb:17
  def initialize(context); end

  # Add a single DbQueryMetricStats object to this set.
  #
  # Looks up an existing one under this key and merges, or just saves a new
  # one under the key
  #
  # pkg:gem/scout_apm#lib/scout_apm/db_query_metric_set.rb:54
  def <<(stat); end

  # pkg:gem/scout_apm#lib/scout_apm/db_query_metric_set.rb:91
  def at_limit?; end

  # Take another set, and merge it with this one
  #
  # pkg:gem/scout_apm#lib/scout_apm/db_query_metric_set.rb:43
  def combine!(other); end

  # Need to look this up again if we end up as nil. Which I guess can happen
  # after a Marshal load?
  #
  # pkg:gem/scout_apm#lib/scout_apm/db_query_metric_set.rb:26
  def context; end

  # pkg:gem/scout_apm#lib/scout_apm/db_query_metric_set.rb:30
  def each; end

  # pkg:gem/scout_apm#lib/scout_apm/db_query_metric_set.rb:66
  def increment_transaction_count!; end

  # pkg:gem/scout_apm#lib/scout_apm/db_query_metric_set.rb:85
  def inspect; end

  # Looks up a DbQueryMetricStats instance in the +@metrics+ hash. Sets the value to +other+ if no key
  # Returns a DbQueryMetricStats instance
  #
  # pkg:gem/scout_apm#lib/scout_apm/db_query_metric_set.rb:38
  def lookup(other); end

  # the raw metrics. You probably want #metrics_to_report
  #
  # pkg:gem/scout_apm#lib/scout_apm/db_query_metric_set.rb:8
  def marshal_dump; end

  # pkg:gem/scout_apm#lib/scout_apm/db_query_metric_set.rb:12
  def marshal_load(array); end

  # pkg:gem/scout_apm#lib/scout_apm/db_query_metric_set.rb:6
  def metrics; end

  # pkg:gem/scout_apm#lib/scout_apm/db_query_metric_set.rb:72
  def metrics_to_report; end
end

# pkg:gem/scout_apm#lib/scout_apm/db_query_metric_stats.rb:2
class ScoutApm::DbQueryMetricStats
  # pkg:gem/scout_apm#lib/scout_apm/db_query_metric_stats.rb:24
  def initialize(model_name, operation, scope, call_count, call_time, rows_returned); end

  # pkg:gem/scout_apm#lib/scout_apm/db_query_metric_stats.rb:72
  def as_json; end

  # pkg:gem/scout_apm#lib/scout_apm/db_query_metric_stats.rb:12
  def call_count; end

  # pkg:gem/scout_apm#lib/scout_apm/db_query_metric_stats.rb:13
  def call_time; end

  # Combine data from another DbQueryMetricStats into +self+. Modifies and returns +self+
  #
  # pkg:gem/scout_apm#lib/scout_apm/db_query_metric_stats.rb:54
  def combine!(other); end

  # pkg:gem/scout_apm#lib/scout_apm/db_query_metric_stats.rb:22
  def histogram; end

  # Called by the Set on each DbQueryMetricStats object that it holds, only
  # once during the recording of a transaction.
  #
  # Don't call elsewhere, and don't set to 1 in the initializer.
  #
  # pkg:gem/scout_apm#lib/scout_apm/db_query_metric_stats.rb:98
  def increment_transaction_count!; end

  # Merge data in this scope. Used in DbQueryMetricSet
  #
  # pkg:gem/scout_apm#lib/scout_apm/db_query_metric_stats.rb:49
  def key; end

  # pkg:gem/scout_apm#lib/scout_apm/db_query_metric_stats.rb:17
  def max_call_time; end

  # pkg:gem/scout_apm#lib/scout_apm/db_query_metric_stats.rb:20
  def max_rows_returned; end

  # pkg:gem/scout_apm#lib/scout_apm/db_query_metric_stats.rb:16
  def min_call_time; end

  # pkg:gem/scout_apm#lib/scout_apm/db_query_metric_stats.rb:19
  def min_rows_returned; end

  # pkg:gem/scout_apm#lib/scout_apm/db_query_metric_stats.rb:6
  def model_name; end

  # pkg:gem/scout_apm#lib/scout_apm/db_query_metric_stats.rb:7
  def operation; end

  # pkg:gem/scout_apm#lib/scout_apm/db_query_metric_stats.rb:14
  def rows_returned; end

  # pkg:gem/scout_apm#lib/scout_apm/db_query_metric_stats.rb:8
  def scope; end

  # pkg:gem/scout_apm#lib/scout_apm/db_query_metric_stats.rb:10
  def transaction_count; end
end

