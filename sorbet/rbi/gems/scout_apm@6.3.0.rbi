# pkg:gem/scout_apm#lib/scout_apm/environment.rb:5
class ScoutApm::Environment
  include ::Singleton::SingletonInstanceMethods
  include ::Singleton
  extend ::Singleton::SingletonClassMethods

  # App server's name (symbol)
  #
  # pkg:gem/scout_apm#lib/scout_apm/environment.rb:140
  def app_server; end

  # Returns the whole integration object
  # This needs to be improved. Frequently, multiple app servers gem are present and which
  # ever is checked first becomes the designated app server.
  #
  # Next step: (1) list out all detected app servers (2) install hooks for those that need it (passenger, rainbows, unicorn).
  #
  # pkg:gem/scout_apm#lib/scout_apm/environment.rb:134
  def app_server_integration(force = T.unsafe(nil)); end

  # pkg:gem/scout_apm#lib/scout_apm/environment.rb:67
  def application_name; end

  # pkg:gem/scout_apm#lib/scout_apm/environment.rb:150
  def background_job_integrations; end

  # pkg:gem/scout_apm#lib/scout_apm/environment.rb:73
  def database_engine; end

  # pkg:gem/scout_apm#lib/scout_apm/environment.rb:51
  def env; end

  # If forking, don't start worker thread in the master process. Since it's
  # started as a Thread, it won't survive the fork.
  #
  # pkg:gem/scout_apm#lib/scout_apm/environment.rb:146
  def forking?; end

  # pkg:gem/scout_apm#lib/scout_apm/environment.rb:55
  def framework; end

  # pkg:gem/scout_apm#lib/scout_apm/environment.rb:59
  def framework_integration; end

  # pkg:gem/scout_apm#lib/scout_apm/environment.rb:106
  def framework_root; end

  # pkg:gem/scout_apm#lib/scout_apm/environment.rb:125
  def git_revision; end

  # pkg:gem/scout_apm#lib/scout_apm/environment.rb:121
  def hostname; end

  # If both stdin & stdout are interactive and the Rails::Console constant is defined
  #
  # pkg:gem/scout_apm#lib/scout_apm/environment.rb:159
  def interactive?; end

  # pkg:gem/scout_apm#lib/scout_apm/environment.rb:169
  def jruby?; end

  # Returns a string representation of the OS (ex: darwin, linux)
  #
  # pkg:gem/scout_apm#lib/scout_apm/environment.rb:219
  def os; end

  # pkg:gem/scout_apm#lib/scout_apm/environment.rb:63
  def platform_integration; end

  # pkg:gem/scout_apm#lib/scout_apm/environment.rb:81
  def processors; end

  # pkg:gem/scout_apm#lib/scout_apm/environment.rb:77
  def raw_database_adapter; end

  # pkg:gem/scout_apm#lib/scout_apm/environment.rb:102
  def root; end

  # ruby checks
  #
  # pkg:gem/scout_apm#lib/scout_apm/environment.rb:165
  def rubinius?; end

  # pkg:gem/scout_apm#lib/scout_apm/environment.rb:178
  def ruby_187?; end

  # pkg:gem/scout_apm#lib/scout_apm/environment.rb:173
  def ruby_19?; end

  # pkg:gem/scout_apm#lib/scout_apm/environment.rb:183
  def ruby_2?; end

  # pkg:gem/scout_apm#lib/scout_apm/environment.rb:198
  def ruby_2_or_above?; end

  # pkg:gem/scout_apm#lib/scout_apm/environment.rb:188
  def ruby_3?; end

  # pkg:gem/scout_apm#lib/scout_apm/environment.rb:193
  def ruby_4?; end

  # pkg:gem/scout_apm#lib/scout_apm/environment.rb:203
  def ruby_minor; end

  # pkg:gem/scout_apm#lib/scout_apm/environment.rb:94
  def scm_subdirectory; end

  # framework checks
  #
  # pkg:gem/scout_apm#lib/scout_apm/environment.rb:232
  def sinatra?; end

  # Returns true if this Ruby version makes positional and keyword arguments incompatible
  #
  # pkg:gem/scout_apm#lib/scout_apm/environment.rb:214
  def supports_kwarg_delegation?; end

  # Returns true if this Ruby version supports Module#prepend.
  #
  # pkg:gem/scout_apm#lib/scout_apm/environment.rb:209
  def supports_module_prepend?; end

  class << self
    private

    # pkg:gem/scout_apm#lib/scout_apm/environment.rb:6
    def allocate; end

    # pkg:gem/scout_apm#lib/scout_apm/environment.rb:6
    def new(*_arg0); end
  end
end

