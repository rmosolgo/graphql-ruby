# pkg:gem/scout_apm#lib/scout_apm/layer_converters/slow_job_converter.rb:7
class ScoutApm::LayerConverters::SlowJobConverter < ::ScoutApm::LayerConverters::ConverterBase
  # Called by the set to force this to actually be created.
  #
  # pkg:gem/scout_apm#lib/scout_apm/layer_converters/slow_job_converter.rb:29
  def call; end

  # pkg:gem/scout_apm#lib/scout_apm/layer_converters/slow_job_converter.rb:63
  def create_metrics; end

  # pkg:gem/scout_apm#lib/scout_apm/layer_converters/slow_job_converter.rb:93
