# pkg:gem/scout_apm#lib/scout_apm/agent_context.rb:2
class ScoutApm::AgentContext
  # Initially start up without attempting to load a configuration file. We
  # need to be able to lookup configuration options like "application_root"
  # which would then in turn influence where the yaml configuration file is
  # located
  #
  # Later in initialization, we set config= to include the file.
  #
  # pkg:gem/scout_apm#lib/scout_apm/agent_context.rb:12
  def initialize; end

  # Maintains a Histogram of insignificant/significant autoinstrument layers.
  # significant = 1
  # insignificant = 0
  #
  # pkg:gem/scout_apm#lib/scout_apm/agent_context.rb:113
  def auto_instruments_layer_histograms; end

  # Execute this in the child process of a remote agent. The parent is
  # expected to have its accepting webserver up and running
  #
  # pkg:gem/scout_apm#lib/scout_apm/agent_context.rb:57
  def become_remote_client!(host, port); end

  # pkg:gem/scout_apm#lib/scout_apm/agent_context.rb:70
  def config; end

  # When we set the config for any reason, there are some values we must
  # reinitialize, since the config could have changed their settings, so nil
  # them out here, then let them get lazily reset as needed
  #
  # Don't use this in initializer, since it'll attempt to log immediately
  #
  # pkg:gem/scout_apm#lib/scout_apm/agent_context.rb:170
  def config=(config); end

  # pkg:gem/scout_apm#lib/scout_apm/agent_context.rb:145
  def dev_trace_enabled?; end

  # pkg:gem/scout_apm#lib/scout_apm/agent_context.rb:74
  def environment; end

  # I believe this is only useful for testing?
  #
  # pkg:gem/scout_apm#lib/scout_apm/agent_context.rb:214
  def environment=(env); end

  #  Error Service  #
  #
  # pkg:gem/scout_apm#lib/scout_apm/agent_context.rb:153
  def error_buffer; end

  # pkg:gem/scout_apm#lib/scout_apm/agent_context.rb:4
  def extensions; end

  # pkg:gem/scout_apm#lib/scout_apm/agent_context.rb:4
  def extensions=(_arg0); end

  # pkg:gem/scout_apm#lib/scout_apm/agent_context.rb:157
  def ignored_exceptions; end

  # pkg:gem/scout_apm#lib/scout_apm/agent_context.rb:98
  def ignored_uris; end

  # pkg:gem/scout_apm#lib/scout_apm/agent_context.rb:187
  def installed!; end

  # pkg:gem/scout_apm#lib/scout_apm/agent_context.rb:86
  def installed?; end

  # pkg:gem/scout_apm#lib/scout_apm/agent_context.rb:137
  def layaway; end

  # Called after config is reset and loaded from file
  #
  # pkg:gem/scout_apm#lib/scout_apm/agent_context.rb:225
  def log_configuration_settings; end

  # pkg:gem/scout_apm#lib/scout_apm/agent_context.rb:90
  def logger; end

  # pkg:gem/scout_apm#lib/scout_apm/agent_context.rb:18
  def marshal_dump; end

  # pkg:gem/scout_apm#lib/scout_apm/agent_context.rb:22
  def marshal_load(*args); end

  #  Accessors  #
  #
  # pkg:gem/scout_apm#lib/scout_apm/agent_context.rb:68
  def process_start_time; end

  # pkg:gem/scout_apm#lib/scout_apm/agent_context.rb:141
  def recorder; end

  # pkg:gem/scout_apm#lib/scout_apm/agent_context.rb:209
  def recorder=(recorder); end

  # Histogram of the cumulative requests since the start of the process
  #
  # pkg:gem/scout_apm#lib/scout_apm/agent_context.rb:118
  def request_histograms; end

  # Histogram of the requests, distinct by reporting period (minute)
  # { StoreReportingPeriodTimestamp => RequestHistograms }
  #
  # pkg:gem/scout_apm#lib/scout_apm/agent_context.rb:124
  def request_histograms_by_time; end

  # pkg:gem/scout_apm#lib/scout_apm/agent_context.rb:94
  def sampling; end

  # pkg:gem/scout_apm#lib/scout_apm/agent_context.rb:195
  def shutting_down!; end

  # pkg:gem/scout_apm#lib/scout_apm/agent_context.rb:82
  def shutting_down?; end

  # pkg:gem/scout_apm#lib/scout_apm/agent_context.rb:106
  def slow_job_policy; end

  # pkg:gem/scout_apm#lib/scout_apm/agent_context.rb:102
  def slow_request_policy; end

  #  Lifecycle: Remote Server/Client
  #
  #  This allows short lived forked processes to communicate back to the parent process.
  #  Used in the Resque instrumentation
  #
  #  Parent Pre-fork: start_remote_server! once
  #  Child Post-fork: become_remote_client! after each fork
  #
  #  TODO: Figure out where to extract this to
  #
  # pkg:gem/scout_apm#lib/scout_apm/agent_context.rb:39
  def start_remote_server!(bind, port); end

  # pkg:gem/scout_apm#lib/scout_apm/agent_context.rb:191
  def started!; end

  # pkg:gem/scout_apm#lib/scout_apm/agent_context.rb:78
  def started?; end

  # pkg:gem/scout_apm#lib/scout_apm/agent_context.rb:132
  def store; end

  # pkg:gem/scout_apm#lib/scout_apm/agent_context.rb:199
  def store=(store); end

  # pkg:gem/scout_apm#lib/scout_apm/agent_context.rb:128
  def transaction_time_consumed; end
end

# pkg:gem/scout_apm#lib/scout_apm/exceptions.rb:2
module ScoutApm::AllExceptionsExceptOnesWeMustNotRescue
  class << self
    # pkg:gem/scout_apm#lib/scout_apm/exceptions.rb:8
    def ===(exception); end
  end
end

# Borrowed from https://github.com/rspec/rspec-support/blob/v3.8.0/lib/rspec/support.rb#L132-L140
# These exceptions are dangerous to rescue as rescuing them
# would interfere with things we should not interfere with.
#
# pkg:gem/scout_apm#lib/scout_apm/exceptions.rb:6
ScoutApm::AllExceptionsExceptOnesWeMustNotRescue::AVOID_RESCUING = T.let(T.unsafe(nil), Array)

# pkg:gem/scout_apm#lib/scout_apm/app_server_load.rb:2
class ScoutApm::AppServerLoad
  # pkg:gem/scout_apm#lib/scout_apm/app_server_load.rb:6
  def initialize(context); end

  # pkg:gem/scout_apm#lib/scout_apm/app_server_load.rb:4
  def context; end

  # pkg:gem/scout_apm#lib/scout_apm/app_server_load.rb:31
  def data; end

  # pkg:gem/scout_apm#lib/scout_apm/app_server_load.rb:67
  def environment; end

  # pkg:gem/scout_apm#lib/scout_apm/app_server_load.rb:3
  def logger; end

  # pkg:gem/scout_apm#lib/scout_apm/app_server_load.rb:11
  def run; end

  # Calls `.to_s` on the object passed in.
  # Returns literal string 'to_s error' if the object does not respond to .to_s
  #
  # pkg:gem/scout_apm#lib/scout_apm/app_server_load.rb:59
  def to_s_safe(obj); end
end

# pkg:gem/scout_apm#lib/scout_apm/attribute_arranger.rb:2
module ScoutApm::AttributeArranger
  class << self
    # pass in an array of symbols to return as hash keys
    # if the symbol doesn't match the name of the method, pass an array: [:key, :method_name]
    #
