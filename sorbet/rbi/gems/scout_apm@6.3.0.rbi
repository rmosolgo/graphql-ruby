# pkg:gem/scout_apm#lib/scout_apm/layer_converters/slow_request_converter.rb:3
class ScoutApm::LayerConverters::SlowRequestConverter < ::ScoutApm::LayerConverters::ConverterBase
  # Unconditionally attempts to convert this into a SlowTransaction object.
  # Can return nil if the request didn't have any scope_layer.
  #
  # pkg:gem/scout_apm#lib/scout_apm/layer_converters/slow_request_converter.rb:26
  def call; end

  # Full metrics from this request. These get stored permanently in a SlowTransaction.
  # Some merging of metrics will happen here, so if a request calls the same
  # ActiveRecord or View repeatedly, it'll get merged.
  #
  # This returns a 2-element of Metric Hashes (the first element is timing metrics, the second element is allocation metrics)
  #
  # pkg:gem/scout_apm#lib/scout_apm/layer_converters/slow_request_converter.rb:64
  def create_metrics; end

  #  ScoreItemSet API #
  #
  # pkg:gem/scout_apm#lib/scout_apm/layer_converters/slow_request_converter.rb:21
  def name; end

  #  Converter API  #
  #
  # pkg:gem/scout_apm#lib/scout_apm/layer_converters/slow_request_converter.rb:7
  def record!; end

  # pkg:gem/scout_apm#lib/scout_apm/layer_converters/slow_request_converter.rb:22
  def score; end

  #  Also create a new style trace. This is not a good      #
  #  spot for this long term, but fixes an issue for now.   #
  #
  # pkg:gem/scout_apm#lib/scout_apm/layer_converters/slow_request_converter.rb:92
  def span_trace; end
end

# pkg:gem/scout_apm#lib/scout_apm/layer_converters/trace_converter.rb:3
class ScoutApm::LayerConverters::TraceConverter < ::ScoutApm::LayerConverters::ConverterBase
  # Take an array of ruby backtrace lines and split it into an array of hashes like:
  # ["/Users/cschneid/.rvm/rubies/ruby-2.2.7/lib/ruby/2.2.0/irb/workspace.rb:86:in `eval'", ...]
  #    turns into:
  # [ {
  #     "file": "app/controllers/users_controller.rb",
  #     "line": 10,
  #     "function": "index"
  # },
  # ]
  #
  # pkg:gem/scout_apm#lib/scout_apm/layer_converters/trace_converter.rb:142
  def backtrace_parser(lines); end

  # Unconditionally attempts to convert this into a DetailedTrace object.
  # Can return nil if the request didn't have any scope_layer or if `timeline_traces` aren't enabled.
  #
  # pkg:gem/scout_apm#lib/scout_apm/layer_converters/trace_converter.rb:27
  def call; end

  # Returns an array of span objects. Uses recursion to get all children
  # wired up w/ correct parent_ids
  #
  # pkg:gem/scout_apm#lib/scout_apm/layer_converters/trace_converter.rb:89
  def create_spans(layer, parent_id = T.unsafe(nil)); end

  # pkg:gem/scout_apm#lib/scout_apm/layer_converters/trace_converter.rb:179
  def limited?; end

  # pkg:gem/scout_apm#lib/scout_apm/layer_converters/trace_converter.rb:173
  def log_over_span_limit; end

  #  ScoreItemSet API #
  #
  # pkg:gem/scout_apm#lib/scout_apm/layer_converters/trace_converter.rb:22
  def name; end

  # pkg:gem/scout_apm#lib/scout_apm/layer_converters/trace_converter.rb:164
  def over_span_limit?(spans); end

  # pkg:gem/scout_apm#lib/scout_apm/layer_converters/trace_converter.rb:9
  def record!; end

  # pkg:gem/scout_apm#lib/scout_apm/layer_converters/trace_converter.rb:23
  def score; end
end

# To prevent huge traces from being generated, we stop collecting
# spans as we go beyond some reasonably large count.
#
# pkg:gem/scout_apm#lib/scout_apm/layer_converters/trace_converter.rb:162
ScoutApm::LayerConverters::TraceConverter::MAX_SPANS = T.let(T.unsafe(nil), Integer)

# A LimitedLayer is a lossy-compression approach to fall back on once we max out
# the number of detailed layer objects we store.  See LayerChildrenSet for the
# logic on when that change over happens
#
# QUESTION: What do we do if we attempt to merge an item that has children?
#
# pkg:gem/scout_apm#lib/scout_apm/limited_layer.rb:7
class ScoutApm::LimitedLayer
  # pkg:gem/scout_apm#lib/scout_apm/limited_layer.rb:10
  def initialize(type); end

  # pkg:gem/scout_apm#lib/scout_apm/limited_layer.rb:20
  def absorb(layer); end

  #  Many methods don't make any sense on a limited layer. Raise errors  #
  #  aggressively for now to detect mistaken calls                      #
  #
  # pkg:gem/scout_apm#lib/scout_apm/limited_layer.rb:97
  def add_child; end

  # pkg:gem/scout_apm#lib/scout_apm/limited_layer.rb:113
  def annotate_layer(*); end

  # pkg:gem/scout_apm#lib/scout_apm/limited_layer.rb:64
  def annotations; end

  # pkg:gem/scout_apm#lib/scout_apm/limited_layer.rb:87
  def backtrace; end

  # pkg:gem/scout_apm#lib/scout_apm/limited_layer.rb:125
  def caller_array; end

  # pkg:gem/scout_apm#lib/scout_apm/limited_layer.rb:121
  def capture_backtrace!; end

  # pkg:gem/scout_apm#lib/scout_apm/limited_layer.rb:60
  def children; end

  # pkg:gem/scout_apm#lib/scout_apm/limited_layer.rb:49
  def count; end

  # pkg:gem/scout_apm#lib/scout_apm/limited_layer.rb:83
  def desc; end

  # pkg:gem/scout_apm#lib/scout_apm/limited_layer.rb:109
  def desc=(*); end

  # This is the old style name. This function is used for now, but should be
  # removed, and the new type & name split should be enforced through the
  # app.
  #
  # pkg:gem/scout_apm#lib/scout_apm/limited_layer.rb:56
  def legacy_metric_name; end

  # pkg:gem/scout_apm#lib/scout_apm/limited_layer.rb:72
  def limited?; end

  # pkg:gem/scout_apm#lib/scout_apm/limited_layer.rb:105
  def record_allocations!; end

  # pkg:gem/scout_apm#lib/scout_apm/limited_layer.rb:101
  def record_stop_time!(*); end

  # pkg:gem/scout_apm#lib/scout_apm/limited_layer.rb:117
  def subscopable!; end

  #  Stub out some methods with static default values  #
  #
  # pkg:gem/scout_apm#lib/scout_apm/limited_layer.rb:79
  def subscopable?; end

  # pkg:gem/scout_apm#lib/scout_apm/limited_layer.rb:68
  def to_s; end

  # pkg:gem/scout_apm#lib/scout_apm/limited_layer.rb:41
  def total_allocations; end

  # pkg:gem/scout_apm#lib/scout_apm/limited_layer.rb:33
  def total_call_time; end

  # pkg:gem/scout_apm#lib/scout_apm/limited_layer.rb:45
  def total_exclusive_allocations; end

  # pkg:gem/scout_apm#lib/scout_apm/limited_layer.rb:37
  def total_exclusive_time; end

  # pkg:gem/scout_apm#lib/scout_apm/limited_layer.rb:8
  def type; end
end

