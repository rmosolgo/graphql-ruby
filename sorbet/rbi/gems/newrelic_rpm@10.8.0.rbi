  # pkg:gem/newrelic_rpm#lib/new_relic/agent/distributed_tracing/distributed_trace_payload.rb:106
  def sampled; end

  # pkg:gem/newrelic_rpm#lib/new_relic/agent/distributed_tracing/distributed_trace_payload.rb:106
