# A worker loop executes a set of registered tasks on a single thread.
# A task is a proc or block with a specified call period in seconds.
#
# pkg:gem/newrelic_rpm#lib/new_relic/agent/worker_loop.rb:11
class NewRelic::Agent::WorkerLoop
  # Optional argument :duration (in seconds) for how long the worker loop runs
  # or :limit (integer) for max number of iterations
  #
  # pkg:gem/newrelic_rpm#lib/new_relic/agent/worker_loop.rb:17
  def initialize(opts = T.unsafe(nil)); end

  # pkg:gem/newrelic_rpm#lib/new_relic/agent/worker_loop.rb:13
  def iterations; end

  # a simple accessor for @should_run
  #
  # pkg:gem/newrelic_rpm#lib/new_relic/agent/worker_loop.rb:62
  def keep_running?; end

  # pkg:gem/newrelic_rpm#lib/new_relic/agent/worker_loop.rb:12
  def period; end

  # pkg:gem/newrelic_rpm#lib/new_relic/agent/worker_loop.rb:12
  def period=(_arg0); end

  # pkg:gem/newrelic_rpm#lib/new_relic/agent/worker_loop.rb:12
  def propagate_errors; end

  # pkg:gem/newrelic_rpm#lib/new_relic/agent/worker_loop.rb:12
  def propagate_errors=(_arg0); end

  # Run infinitely, calling the registered tasks at their specified
  # call periods.  The caller is responsible for creating the thread
  # that runs this worker loop.  This will run the task immediately.
  #
  # pkg:gem/newrelic_rpm#lib/new_relic/agent/worker_loop.rb:43
  def run(period = T.unsafe(nil), &block); end

  # Executes the block given to the worker loop, and handles errors.
  #
  # pkg:gem/newrelic_rpm#lib/new_relic/agent/worker_loop.rb:80
  def run_task; end

  # pkg:gem/newrelic_rpm#lib/new_relic/agent/worker_loop.rb:53
  def schedule_next_invocation; end

  # Reset state that is changed by running the worker loop
  #
  # pkg:gem/newrelic_rpm#lib/new_relic/agent/worker_loop.rb:29
  def setup(period, task); end

  # Sets @should_run to false. Returns false
  #
  # pkg:gem/newrelic_rpm#lib/new_relic/agent/worker_loop.rb:75
  def stop; end

  # pkg:gem/newrelic_rpm#lib/new_relic/agent/worker_loop.rb:66
  def under_duration?; end

  # pkg:gem/newrelic_rpm#lib/new_relic/agent/worker_loop.rb:70
  def under_limit?; end
end

