  # pkg:gem/newrelic_rpm#lib/new_relic/agent/database/explain_plan_helpers.rb:34
  def handle_exception_in_explain; end

  # pkg:gem/newrelic_rpm#lib/new_relic/agent/database/explain_plan_helpers.rb:15
