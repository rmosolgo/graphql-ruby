# pkg:gem/newrelic_rpm#lib/new_relic/agent/instrumentation/notifications_subscriber.rb:8
class NewRelic::Agent::Instrumentation::NotificationsSubscriber
  # pkg:gem/newrelic_rpm#lib/new_relic/agent/instrumentation/notifications_subscriber.rb:9
  def initialize; end

  # for subclasses
  #
  # pkg:gem/newrelic_rpm#lib/new_relic/agent/instrumentation/notifications_subscriber.rb:84
  def add_segment_params(segment, payload); end

  # pkg:gem/newrelic_rpm#lib/new_relic/agent/instrumentation/notifications_subscriber.rb:117
  def define_exception_method; end

  # pkg:gem/newrelic_rpm#lib/new_relic/agent/instrumentation/notifications_subscriber.rb:60
  def finish(name, id, payload); end

  # pkg:gem/newrelic_rpm#lib/new_relic/agent/instrumentation/notifications_subscriber.rb:74
  def finish_segment(id, payload); end

  # pkg:gem/newrelic_rpm#lib/new_relic/agent/instrumentation/notifications_subscriber.rb:93
  def log_notification_error(error, name, event_type); end

  # for subclasses
  #
  # pkg:gem/newrelic_rpm#lib/new_relic/agent/instrumentation/notifications_subscriber.rb:89
  def metric_name(name, payload); end

  # pkg:gem/newrelic_rpm#lib/new_relic/agent/instrumentation/notifications_subscriber.rb:104
  def pop_segment(id); end

  # pkg:gem/newrelic_rpm#lib/new_relic/agent/instrumentation/notifications_subscriber.rb:100
  def push_segment(id, segment); end

  # pkg:gem/newrelic_rpm#lib/new_relic/agent/instrumentation/notifications_subscriber.rb:109
  def segment_stack; end

  # The agent doesn't use the traditional ActiveSupport::Notifications.subscribe
  # pattern due to threading issues discovered on initial instrumentation.
  # Instead we define a #start and #finish method, which Rails responds to.
  # See: https://github.com/rails/rails/issues/12069
  #
  # pkg:gem/newrelic_rpm#lib/new_relic/agent/instrumentation/notifications_subscriber.rb:52
  def start(name, id, payload); end

  # pkg:gem/newrelic_rpm#lib/new_relic/agent/instrumentation/notifications_subscriber.rb:68
  def start_segment(name, id, payload); end

  # pkg:gem/newrelic_rpm#lib/new_relic/agent/instrumentation/notifications_subscriber.rb:113
  def state; end

  class << self
    # pkg:gem/newrelic_rpm#lib/new_relic/agent/instrumentation/notifications_subscriber.rb:18
    def find_all_subscribers; end

    # pkg:gem/newrelic_rpm#lib/new_relic/agent/instrumentation/notifications_subscriber.rb:42
    def subscribe(pattern); end

    # pkg:gem/newrelic_rpm#lib/new_relic/agent/instrumentation/notifications_subscriber.rb:14
    def subscribed?; end
  end
end

