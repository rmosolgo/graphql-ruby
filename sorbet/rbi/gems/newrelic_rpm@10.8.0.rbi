# pkg:gem/newrelic_rpm#lib/new_relic/agent/new_relic_service/encoders.rb:20
module NewRelic::Agent::NewRelicService::Encoders::Compressed; end

# pkg:gem/newrelic_rpm#lib/new_relic/agent/new_relic_service/encoders.rb:21
module NewRelic::Agent::NewRelicService::Encoders::Compressed::Deflate
