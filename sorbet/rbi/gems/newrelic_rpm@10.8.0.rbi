    # pkg:gem/newrelic_rpm#lib/new_relic/agent/datastores/metric_helper.rb:96
    def metrics_from_sql(product, sql); end

    # pkg:gem/newrelic_rpm#lib/new_relic/agent/datastores/metric_helper.rb:101
