    # pkg:gem/newrelic_rpm#lib/new_relic/agent/datastores/metric_helper.rb:32
    def product_rollup(product); end

    # pkg:gem/newrelic_rpm#lib/new_relic/agent/datastores/metric_helper.rb:28
