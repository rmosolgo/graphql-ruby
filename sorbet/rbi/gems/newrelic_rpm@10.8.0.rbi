# This class contains the logic for recording and storing transaction
# traces (sometimes referred to as 'transaction samples').
#
# A transaction trace is a detailed timeline of the events that happened
# during the processing of a single transaction, including database calls,
# template rendering calls, and other instrumented method calls.
#
# @api public
#
# pkg:gem/newrelic_rpm#lib/new_relic/agent/transaction_sampler.rb:19
class NewRelic::Agent::TransactionSampler
  # pkg:gem/newrelic_rpm#lib/new_relic/agent/transaction_sampler.rb:22
  def initialize; end

  # pkg:gem/newrelic_rpm#lib/new_relic/agent/transaction_sampler.rb:100
  def count; end

  # pkg:gem/newrelic_rpm#lib/new_relic/agent/transaction_sampler.rb:48
  def enabled?; end

  # Gather transaction traces that we'd like to transmit to the server.
  #
  # pkg:gem/newrelic_rpm#lib/new_relic/agent/transaction_sampler.rb:69
  def harvest!; end

  # pkg:gem/newrelic_rpm#lib/new_relic/agent/transaction_sampler.rb:107
  def harvest_from_sample_buffers; end

  # pkg:gem/newrelic_rpm#lib/new_relic/agent/transaction_sampler.rb:20
  def last_sample; end

  # pkg:gem/newrelic_rpm#lib/new_relic/agent/transaction_sampler.rb:92
  def merge!(previous); end

  # pkg:gem/newrelic_rpm#lib/new_relic/agent/transaction_sampler.rb:52
  def on_finishing_transaction(txn); end

  # pkg:gem/newrelic_rpm#lib/new_relic/agent/transaction_sampler.rb:79
  def prepare_samples(samples); end

  # reset samples without rebooting the web server (used by dev mode)
  #
  # pkg:gem/newrelic_rpm#lib/new_relic/agent/transaction_sampler.rb:124
  def reset!; end

  # pkg:gem/newrelic_rpm#lib/new_relic/agent/transaction_sampler.rb:62
  def store_sample(sample); end
end

