  def fix_transaction_threshold(merged_settings); end

  # pkg:gem/newrelic_rpm#lib/new_relic/agent/configuration/server_source.rb:64
  def merge_agent_config_hash(merged_settings, connect_reply); end

  # pkg:gem/newrelic_rpm#lib/new_relic/agent/configuration/server_source.rb:56
