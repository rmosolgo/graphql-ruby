# This class contains the logic of recording slow SQL traces, which may
# represent multiple aggregated SQL queries.
#
# A slow SQL trace consists of a collection of SQL instrumented SQL queries
# that all normalize to the same text. For example, the following two
# queries would be aggregated together into a single slow SQL trace:
#
#   SELECT * FROM table WHERE id=42
#   SELECT * FROM table WHERE id=1234
#
# Each slow SQL trace keeps track of the number of times the same normalized
# query was seen, the min, max, and total time spent executing those
# queries, and an example backtrace from one of the aggregated queries.
#
# @api public
#
# pkg:gem/newrelic_rpm#lib/new_relic/agent/sql_sampler.rb:24
class NewRelic::Agent::SqlSampler
  # pkg:gem/newrelic_rpm#lib/new_relic/agent/sql_sampler.rb:32
  def initialize; end

  # pkg:gem/newrelic_rpm#lib/new_relic/agent/sql_sampler.rb:25
  def disabled; end

  # pkg:gem/newrelic_rpm#lib/new_relic/agent/sql_sampler.rb:126
  def distributed_trace_attributes(state); end

  # pkg:gem/newrelic_rpm#lib/new_relic/agent/sql_sampler.rb:41
  def enabled?; end

  # pkg:gem/newrelic_rpm#lib/new_relic/agent/sql_sampler.rb:165
  def harvest!; end

  # this should always be called under the @samples_lock
  #
  # pkg:gem/newrelic_rpm#lib/new_relic/agent/sql_sampler.rb:114
  def has_room?; end

  # pkg:gem/newrelic_rpm#lib/new_relic/agent/sql_sampler.rb:152
  def merge!(sql_traces); end

  # pkg:gem/newrelic_rpm#lib/new_relic/agent/sql_sampler.rb:138
  def notice_sql_statement(statement, metric_name, duration); end

  # This is called when we are done with the transaction.
  #
  # pkg:gem/newrelic_rpm#lib/new_relic/agent/sql_sampler.rb:66
  def on_finishing_transaction(state, name); end

  # pkg:gem/newrelic_rpm#lib/new_relic/agent/sql_sampler.rb:47
  def on_start_transaction(state, uri = T.unsafe(nil)); end

  # this should always be called under the @samples_lock
  #
  # pkg:gem/newrelic_rpm#lib/new_relic/agent/sql_sampler.rb:119
  def remove_shortest_trace; end

  # pkg:gem/newrelic_rpm#lib/new_relic/agent/sql_sampler.rb:177
  def reset!; end

  # this should always be called under the @samples_lock
  #
  # pkg:gem/newrelic_rpm#lib/new_relic/agent/sql_sampler.rb:82
  def save_slow_sql(transaction_sql_data); end

  # this should always be called under the @samples_lock
  #
  # pkg:gem/newrelic_rpm#lib/new_relic/agent/sql_sampler.rb:107
  def should_add_trace?(sql_item); end

  # this is for unit tests only
  #
  # pkg:gem/newrelic_rpm#lib/new_relic/agent/sql_sampler.rb:28
  def sql_traces; end

  # pkg:gem/newrelic_rpm#lib/new_relic/agent/sql_sampler.rb:61
  def tl_transaction_data; end
end

# pkg:gem/newrelic_rpm#lib/new_relic/agent/sql_sampler.rb:30
NewRelic::Agent::SqlSampler::MAX_SAMPLES = T.let(T.unsafe(nil), Integer)

