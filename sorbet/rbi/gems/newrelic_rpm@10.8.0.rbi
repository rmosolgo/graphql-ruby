  # pkg:gem/newrelic_rpm#lib/new_relic/coerce.rb:51
  def scalar(val); end

  # pkg:gem/newrelic_rpm#lib/new_relic/coerce.rb:42
  def string(value, context = T.unsafe(nil)); end

  # pkg:gem/newrelic_rpm#lib/new_relic/coerce.rb:85
  def value_or_nil(value); end

  class << self
    # Use when you plan to perform a boolean check using the integer 1
    # for true and the integer 0 for false
    # String values will be converted to 0
    #
    # pkg:gem/newrelic_rpm#lib/new_relic/coerce.rb:75
