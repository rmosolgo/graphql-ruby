  # See #ignore above.
  #
  # pkg:gem/newrelic_rpm#lib/new_relic/agent/error_filter.rb:96
  def expect(*args); end

  # pkg:gem/newrelic_rpm#lib/new_relic/agent/error_filter.rb:58
  def expected?(ex, status_code = T.unsafe(nil)); end

  # pkg:gem/newrelic_rpm#lib/new_relic/agent/error_filter.rb:65
  def fetch_agent_config(cfg); end

  # A generic method for adding ignore filters manually. This is kept for compatibility
  # with the previous ErrorCollector#ignore method, and adds some flexibility for adding
  # different ignore/expected error types by examining each argument.
  #
  # pkg:gem/newrelic_rpm#lib/new_relic/agent/error_filter.rb:72
  def ignore(*args); end

  # pkg:gem/newrelic_rpm#lib/new_relic/agent/error_filter.rb:51
  def ignore?(ex, status_code = T.unsafe(nil)); end

  # pkg:gem/newrelic_rpm#lib/new_relic/agent/error_filter.rb:20
  def load_all; end

  # pkg:gem/newrelic_rpm#lib/new_relic/agent/error_filter.rb:27
  def load_from_config(setting, value = T.unsafe(nil)); end

  # pkg:gem/newrelic_rpm#lib/new_relic/agent/error_filter.rb:14
  def reset; end

  private

  # pkg:gem/newrelic_rpm#lib/new_relic/agent/error_filter.rb:121
  def log_filter(setting, errors); end

  # pkg:gem/newrelic_rpm#lib/new_relic/agent/error_filter.rb:146
  def parse_status_codes(codes); end
end

# pkg:gem/newrelic_rpm#lib/new_relic/agent/error_trace_aggregator.rb:8
class NewRelic::Agent::ErrorTraceAggregator
  # pkg:gem/newrelic_rpm#lib/new_relic/agent/error_trace_aggregator.rb:9
  def initialize(capacity); end

  # Synchronizes adding an error to the error queue, and checks if
  # the error queue is too long - if so, we drop the error on the
  # floor after logging a warning.
