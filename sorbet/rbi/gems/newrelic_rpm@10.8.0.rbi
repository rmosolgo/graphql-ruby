# pkg:gem/newrelic_rpm#lib/new_relic/agent/system_info.rb:15
module NewRelic::Agent::SystemInfo
  class << self
    # pkg:gem/newrelic_rpm#lib/new_relic/agent/system_info.rb:324
    def boot_id; end

    # pkg:gem/newrelic_rpm#lib/new_relic/agent/system_info.rb:44
    def bsd?; end

    # pkg:gem/newrelic_rpm#lib/new_relic/agent/system_info.rb:54
    def clear_processor_info; end

    # pkg:gem/newrelic_rpm#lib/new_relic/agent/system_info.rb:36
    def darwin?; end

    # When operating within a Docker container, attempt to obtain the
    # container id.
    #
    # First look for `/proc/self/mountinfo` to exist on disk to signify
    # cgroups v2. If that file exists, read it and expect it to contain one
    # or more "/docker/containers/<container_id>/" lines from which the
    # container id can be gleaned.
    #
    # Next look for `/proc/self/cgroup` to exist on disk to signify cgroup v1.
    # If that file exists, read it and parse the "cpu" group info in the hope
    # of finding a 64 character container id value.
    #
    # For non-cgroups based containers, use a `nil` value for the container
    # id without generating any warnings or errors.
    #
    # pkg:gem/newrelic_rpm#lib/new_relic/agent/system_info.rb:205
    def docker_container_id; end

    # pkg:gem/newrelic_rpm#lib/new_relic/agent/system_info.rb:217
    def docker_container_id_for_cgroupsv2; end

    # pkg:gem/newrelic_rpm#lib/new_relic/agent/system_info.rb:50
    def ip_addresses; end

    # pkg:gem/newrelic_rpm#lib/new_relic/agent/system_info.rb:40
    def linux?; end

    # pkg:gem/newrelic_rpm#lib/new_relic/agent/system_info.rb:181
    def num_logical_processors; end

    # pkg:gem/newrelic_rpm#lib/new_relic/agent/system_info.rb:179
    def num_physical_cores; end

    # pkg:gem/newrelic_rpm#lib/new_relic/agent/system_info.rb:177
    def num_physical_packages; end

    # pkg:gem/newrelic_rpm#lib/new_relic/agent/system_info.rb:22
    def os_distribution; end

    # pkg:gem/newrelic_rpm#lib/new_relic/agent/system_info.rb:187
    def os_version; end

    # pkg:gem/newrelic_rpm#lib/new_relic/agent/system_info.rb:261
    def parse_cgroup_ids(cgroup_info); end

    # pkg:gem/newrelic_rpm#lib/new_relic/agent/system_info.rb:123
    def parse_cpuinfo(cpuinfo); end

    # pkg:gem/newrelic_rpm#lib/new_relic/agent/system_info.rb:224
    def parse_docker_container_id(cgroup_info); end

    # pkg:gem/newrelic_rpm#lib/new_relic/agent/system_info.rb:315
    def parse_linux_meminfo_in_mib(meminfo); end

    # A File.read against /(proc|sysfs)/* can hang with some older Linuxes.
