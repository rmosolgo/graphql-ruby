  # pkg:gem/newrelic_rpm#lib/new_relic/agent/distributed_tracing/distributed_trace_payload.rb:106
  def trusted_account_key=(_arg0); end

  # pkg:gem/newrelic_rpm#lib/new_relic/agent/distributed_tracing/distributed_trace_payload.rb:106
  def version; end

  # pkg:gem/newrelic_rpm#lib/new_relic/agent/distributed_tracing/distributed_trace_payload.rb:106
  def version=(_arg0); end

  class << self
    # pkg:gem/newrelic_rpm#lib/new_relic/agent/distributed_tracing/distributed_trace_payload.rb:37
    def for_transaction(transaction); end

    # pkg:gem/newrelic_rpm#lib/new_relic/agent/distributed_tracing/distributed_trace_payload.rb:80
    def from_http_safe(http_safe_payload); end

    # pkg:gem/newrelic_rpm#lib/new_relic/agent/distributed_tracing/distributed_trace_payload.rb:58
    def from_json(serialized_payload); end

    # pkg:gem/newrelic_rpm#lib/new_relic/agent/distributed_tracing/distributed_trace_payload.rb:85
