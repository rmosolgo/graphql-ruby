# This class can be used as the formatter for an existing logger.  It
# decorates log messages with trace and entity metadata, and formats each
# log messages as a JSON object.
#
# It can be added to a Rails application like this:
#
#   require 'newrelic_rpm'
#
#   Rails.application.configure do
#     config.log_formatter = ::NewRelic::Agent::Logging::DecoratingFormatter.new
#   end
#
# @api public
#
# pkg:gem/newrelic_rpm#lib/new_relic/agent/logging.rb:24
class NewRelic::Agent::Logging::DecoratingFormatter < ::Logger::Formatter
  # pkg:gem/newrelic_rpm#lib/new_relic/agent/logging.rb:42
  def initialize; end

  # pkg:gem/newrelic_rpm#lib/new_relic/agent/logging.rb:48
  def call(severity, time, progname, msg); end

  # pkg:gem/newrelic_rpm#lib/new_relic/agent/logging.rb:65
  def clear_tags!; end

  private

  # pkg:gem/newrelic_rpm#lib/new_relic/agent/logging.rb:71
  def add_app_name(message); end

  # pkg:gem/newrelic_rpm#lib/new_relic/agent/logging.rb:87
  def add_entity_guid(message); end

  # pkg:gem/newrelic_rpm#lib/new_relic/agent/logging.rb:78
  def add_entity_type(message); end

  # pkg:gem/newrelic_rpm#lib/new_relic/agent/logging.rb:83
  def add_hostname(message); end

  # pkg:gem/newrelic_rpm#lib/new_relic/agent/logging.rb:129
  def add_key_value(message, key, value); end

  # pkg:gem/newrelic_rpm#lib/new_relic/agent/logging.rb:114
  def add_log_level(message, severity); end

  # pkg:gem/newrelic_rpm#lib/new_relic/agent/logging.rb:108
  def add_message(message, msg); end

  # pkg:gem/newrelic_rpm#lib/new_relic/agent/logging.rb:118
  def add_prog_name(message, progname); end

  # pkg:gem/newrelic_rpm#lib/new_relic/agent/logging.rb:101
  def add_span_id(message); end

  # pkg:gem/newrelic_rpm#lib/new_relic/agent/logging.rb:94
  def add_trace_id(message); end

  # pkg:gem/newrelic_rpm#lib/new_relic/agent/logging.rb:125
  def app_name; end

  # pkg:gem/newrelic_rpm#lib/new_relic/agent/logging.rb:133
  def escape(message); end
end

