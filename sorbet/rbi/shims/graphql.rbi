# Methods below are defined at runtime by metaprogramming
# or supplied by the classes that include these modules.
module GraphQL
  # Included into classes that implement `#[]`
  # (`GraphQL::Schema::InputObject`, `GraphQL::Execution::Interpreter::Arguments`).
  module Dig
    def [](key); end
  end

  module Language
    class StaticVisitor
      # Generated by `make_visit_methods`
      def on_fragment_spread(node, parent); end
    end
  end

  class Schema
    class Validator
      # Subclasses pass `validated:` along in `**default_options`,
      # so let Sorbet accept a keyword splat here.
      def initialize(validated: T.unsafe(nil), allow_blank: false, allow_null: false); end
    end

    class Member
      # Included into objects, resolvers, interfaces and `Query::Context`,
      # which each provide `#context` and `#object`.
      module HasDataloader
        def context; end
        def object; end
      end
    end
  end

  module Rubocop
    module GraphQL
      # These are generated by RuboCop's `def_node_matcher`
      class DefaultNullTrue
        def field_config_with_null_true?(node); end
      end

      class DefaultRequiredTrue
        def argument_config_with_required_true?(node); end
      end

      class RootTypesInBlock
        def root_type_config_without_block(node); end
      end

      class FieldTypeInBlock
        def field_config_with_inline_type(node); end
        def field_config_with_inline_type_and_block(node); end
      end
    end
  end
end

module GraphQL
  class Schema
    class Resolver
      # Added by `HasArguments.extended`
      include GraphQL::Schema::Member::HasArguments::ArgumentObjectLoader
    end
  end
end

module GraphQL
  class Schema
    class Member
      # Sorbet types `superclass` as a nilable `Class`,
      # but subclasses check `superclass.respond_to?(...)` and call their own class methods on it.
      def self.superclass; end
    end

    class FieldExtension
      # See `Member.superclass`
      def self.superclass; end
    end

    class Resolver
      # See `Member.superclass`
      def self.superclass; end
    end

    class Member
      module HasValidators
        module ClassConfigured
          # Extended onto classes, which provide `superclass`
          module ClassValidators
            def superclass; end
          end
        end
      end

      # These are extended onto classes, which provide `superclass` and `ancestors`.
      # They aren't annotated with `@requires_ancestor: singleton(::Object)` because that
      # makes `superclass` nilable, and Tapioca's RBI for `ArgumentClassAccessor` also gets
      # `mixes_in_class_methods`, so Sorbet checks it against singleton classes' singleton classes.
      module HasArguments
        module ArgumentClassAccessor
          def superclass; end
        end

        module ClassConfigured
          module InheritedArguments
            def superclass; end
            def ancestors; end
          end
        end
      end

      module HasInterfaces
        module ClassConfigured
          module InheritedInterfaces
            def superclass; end
          end
        end
      end
    end
  end

  class Subscriptions
    # Subclasses pass `schema:` along in `**rest`,
    # so let Sorbet accept a keyword splat here.
    def initialize(schema: T.unsafe(nil), validate_update: true, broadcast: false, default_broadcastable: false, **rest); end
  end

  module Tracing
    class ScoutTracing
      # Added by `include ScoutApm::Tracer` in `#initialize`
      def self.instrument(type, name, options = {}, &block); end
    end
  end
end

module GraphQL
  class Schema
    module UniqueWithinType
      # Uses `module_function`, so `self` is `UniqueWithinType` when these methods run
      def default_id_separator; end
    end

    class Member
      # Extended onto Scalar, Enum and InputObject, and included into List and NonNull,
      # which each implement these.
      module ValidatesInput
        def validate_non_null_input(val, ctx, max_errors: nil); end
        def coerce_input(val, ctx); end
        def coerce_result(val, ctx); end
      end
    end
  end
end

module GraphQL
  module Tracing
    # Included into platform traces (eg `AppsignalTrace`, `DataDogTrace`), which implement these.
    module PlatformTrace
      def platform_execute_field(platform_key, &block); end
      def platform_authorized(platform_key, &block); end
      def platform_resolve_type(platform_key, &block); end

      # Included into a `KeyCache` class along with the platform trace module, which implements these.
      module BaseKeyCache
        def platform_field_key(field); end
        def platform_authorized_key(type); end
        def platform_resolve_type_key(type); end
      end
    end
  end
end

module ActiveSupport
  class EnvironmentInquirer
    # Handled by `ActiveSupport::StringInquirer#method_missing`
    def staging?; end
  end
end

module GraphQL
  class Schema
    class Member
      module BaseDSLMethods
        # Extended onto classes, which get this from `Kernel`. (It's the target of `alias :unwrap :itself`.)
        def itself; end
      end
    end
  end

  class Query
    # Included into `Query` and `Query::Partial`, which each provide `#context`.
    module Runnable
      def context; end
    end
  end
end

module GraphQL
  class Schema
    class Field
      # Optional hook for subclasses; `calculate_complexity` checks `respond_to?(:complexity_for)` first.
      def complexity_for(child_complexity:, query:, lookahead:); end
    end
  end
end

module GraphQL
  module Tracing
    module MonitorTrace
      # Subclasses include `GraphQLSuffixNames` or `GraphQLPrefixNames`, which implement these.
      class Monitor
        def platform_field_key(field); end
        def platform_authorized_key(type); end
        def platform_resolve_type_key(type); end
        def platform_source_class_key(source_class); end
      end
    end
  end
end
